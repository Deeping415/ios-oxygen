+static char vince_env_name[32], vince_env_str[96];
+static int vince_env_parsed;
+
+static void
+vince_env_parse(void)
+{
+	char arg[140];
+
+	vince_env_parsed = 1;
+	if (PE_parse_boot_argn("vinceenv", arg, sizeof(arg))) {
+		char *c = strchr(arg, ':');
+
+		if (c) {
+			*c = '\0';
+			strlcpy(vince_env_name, arg, sizeof(vince_env_name));
+			strlcpy(vince_env_str, c + 1, sizeof(vince_env_str));
+		}
+	}
