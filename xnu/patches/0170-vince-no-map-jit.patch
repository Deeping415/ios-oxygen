+#if defined(ARM64_BOARD_CONFIG_VINCE)
+	/*
+	 * The Cortex-A53 has none of the hardware iOS uses to switch a JIT region between writable and executable, and
+	 * the first write into one faults (Safari's WebContent died copying its first thunks). Refusing MAP_JIT makes
+	 * JavaScriptCore's executable allocator fail its reservation, and JSC then runs without the JIT (interpreter).
+	 * Boot-arg vincejit=1 lets it through again.
+	 */
+	if (flags & MAP_JIT) {
+		static int vince_jit = -1;
+
+		if (vince_jit < 0) {
+			int v = 0;
+
+			vince_jit = PE_parse_boot_argn("vincejit", &v, sizeof(v)) && v;
+		}
+		if (!vince_jit) {
+			return ENOMEM;
+		}
+	}
