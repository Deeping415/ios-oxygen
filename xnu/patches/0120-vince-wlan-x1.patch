diff --git a/bsd/dev/vince_smd.h b/bsd/dev/vince_smd.h
new file mode 100755
index 0000000..6b6d957
--- /dev/null
+++ b/bsd/dev/vince_smd.h
@@ -0,0 +1,24 @@
+/*
+ * VINCE SMD transport to Pronto (vince_smd.c), used by vince_wlan.c. Polled; the calls sleep in 5 ms steps.
+ */
+#ifndef _VINCE_SMD_H_
+#define _VINCE_SMD_H_
+#if defined(ARM64_BOARD_CONFIG_VINCE)
+#include <stdint.h>
+#include <stdbool.h>
+#include <mach/vm_types.h>
+
+struct vsmd_ch {
+	vm_offset_t info, fifo;         /* mapped addresses */
+	uint32_t half;
+	bool open;
+};
+
+bool vince_smd_map(void);                                       /* SMEM and APCS mapped (once); false on failure */
+void vince_smd_sleep(unsigned ms);
+bool vince_smd_find(const char *name, struct vsmd_ch *c);       /* false if Pronto has not created it (yet) */
+int vince_smd_open(struct vsmd_ch *c);                          /* 0 ok, <0 step that timed out */
+int vince_smd_send(struct vsmd_ch *c, const void *data, uint32_t len);
+int vince_smd_recv(struct vsmd_ch *c, void *buf, uint32_t max, unsigned ms);   /* length, 0 = none within ms, <0 bad header */
+#endif
+#endif /* _VINCE_SMD_H_ */
diff --git a/bsd/dev/vince_wlan.c b/bsd/dev/vince_wlan.c
new file mode 100755
index 0000000..7efd090
--- /dev/null
+++ b/bsd/dev/vince_wlan.c
@@ -0,0 +1,238 @@
+/*
+ * VINCE (Redmi 5 Plus, MSM8953) Wi-Fi HAL client, X1 of reports/WIFI_HANDOFF.md. A port of
+ * vince-bringup/shim/wlan.c (start and feature exchange), which was proven on the phone first: HAL_START answered
+ * with status 0, 29 stations, 2 BSS, API 2.1.5.1, "WCN v2.0 RadioPhy vIris_TSMC_4.0 with 48MHz XO".
+ *
+ * Transport is vince_smd.c (the WLAN_CTRL SMD channel). Pronto itself is started by the shim before the handover
+ * (WCNSS_CTRL handshake and NV included), so the channel exists when this thread looks for it.
+ *
+ * Message layout from mainline drivers/net/wireless/ath/wcn36xx (hal.h, smd.c; GPL-2.0): every HAL message starts
+ * with { u16 type, u16 version, u32 total length }, little endian, and the firmware answers type + 1.
+ *
+ * Boot-arg: vincewlan=1 turns it on (default off). Log lines start with "VINCE WLAN:" (tools/xnulog.py --con).
+ */
+#if defined(ARM64_BOARD_CONFIG_VINCE)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <pexpert/pexpert.h>
+#include "vince_smd.h"
+
+extern kern_return_t thread_terminate(thread_t);
+void vince_wlan_start(void);
+
+#define HAL_START_REQ           0
+#define HAL_START_RSP           1
+#define HAL_FEATURE_CAPS_REQ    175
+#define HAL_FEATURE_CAPS_RSP    176
+#define FEAT_STA_POWERSAVE      13
+#define HAL_BUF                 0x1000u
+#define HAL_VERSION_LEN         64
+#define RSP_TIMEOUT_MS          3000u
+
+#include "vince_wlan_cfg.inc"
+
+static struct vsmd_ch vw_ch;
+static uint8_t vw_req[HAL_BUF], vw_rsp[HAL_BUF];
+static bool vw_started;
+
+static void
+vw_put16(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)v;
+	p[1] = (uint8_t)(v >> 8);
+}
+
+static void
+vw_put32(uint8_t *p, uint32_t v)
+{
+	vw_put16(p, v);
+	vw_put16(p + 2, v >> 16);
+}
+
+static uint32_t
+vw_get16(const uint8_t *p)
+{
+	return p[0] | ((uint32_t)p[1] << 8);
+}
+
+static uint32_t
+vw_get32(const uint8_t *p)
+{
+	return vw_get16(p) | (vw_get16(p + 2) << 16);
+}
+
+static void
+vw_hdr(uint8_t *b, uint32_t type, uint32_t len)
+{
+	vw_put16(b, type);
+	vw_put16(b + 2, 0);             /* WCN36XX_HAL_MSG_VERSION0 */
+	vw_put32(b + 4, len);
+}
+
+/* open WLAN_CTRL once; 0 ok */
+static int
+vw_open(void)
+{
+	if (vw_ch.open) {
+		return 0;
+	}
+	if (!vince_smd_find("WLAN_CTRL", &vw_ch)) {
+		return -1;
+	}
+	return vince_smd_open(&vw_ch) ? -2 : 0;
+}
+
+/*
+ * Send vw_req[0..len) and wait for the answer of type want in vw_rsp: its length, or <0. The firmware also sends
+ * indications on this channel (the first packet after a start is type 233): skip those.
+ */
+static int
+vw_xfer(uint32_t len, uint32_t want)
+{
+	int n;
+
+	if (vw_open()) {
+		return -1;
+	}
+	if (vince_smd_send(&vw_ch, vw_req, len)) {
+		return -2;
+	}
+	for (int tries = 0; tries < 8; tries++) {
+		n = vince_smd_recv(&vw_ch, vw_rsp, sizeof(vw_rsp), RSP_TIMEOUT_MS);
+		if (n <= 0) {
+			return n ? -3 : -4;
+		}
+		if (n >= 8 && vw_get16(vw_rsp) == want) {
+			return n;
+		}
+		printf("VINCE WLAN: skipped indication type %u len %d\n", vw_get16(vw_rsp), n);
+	}
+	return -5;
+}
+
+static void
+vw_log_name(const char *what, const uint8_t *s)
+{
+	char t[HAL_VERSION_LEN + 1];
+
+	for (int i = 0; i < HAL_VERSION_LEN; i++) {
+		t[i] = (s[i] >= 0x20 && s[i] < 0x7f) ? (char)s[i] : 0;
+	}
+	t[HAL_VERSION_LEN] = 0;
+	printf("VINCE WLAN: %s \"%s\"\n", what, t);
+}
+
+/* HAL_START_REQ with the stock config table; 0 when the firmware answers status 0 */
+static int
+vw_start(void)
+{
+	uint32_t len = 16;              /* header, driver type, config length */
+	int n;
+
+	vw_hdr(vw_req, HAL_START_REQ, 0);
+	vw_put32(vw_req + 8, 0);        /* DRIVER_TYPE_PRODUCTION */
+	for (uint32_t i = 0; i < sizeof(vw_cfg) / sizeof(vw_cfg[0]); i++) {
+		vw_put16(vw_req + len, vw_cfg[i].id);
+		vw_put16(vw_req + len + 2, 4);
+		vw_put32(vw_req + len + 4, 0);          /* pad_bytes, reserve */
+		vw_put32(vw_req + len + 8, vw_cfg[i].val);
+		len += 12;
+	}
+	vw_put32(vw_req + 4, len);
+	vw_put32(vw_req + 12, len - 16);
+	n = vw_xfer(len, HAL_START_RSP);
+	if (n < 0) {
+		printf("VINCE WLAN: HAL_START failed %d\n", n);
+		return n;
+	}
+	if (n < 16) {
+		printf("VINCE WLAN: HAL_START answer too short (%d)\n", n);
+		return -6;
+	}
+	printf("VINCE WLAN: HAL_START status %u, stations %u, bssids %u, api %u.%u.%u.%u (answer %d bytes)\n",
+	    vw_get16(vw_rsp + 8), vw_rsp[10], vw_rsp[11], vw_rsp[12], vw_rsp[13], vw_rsp[14], vw_rsp[15], n);
+	if (n >= 16 + 2 * HAL_VERSION_LEN) {
+		vw_log_name("crm", vw_rsp + 16);
+		vw_log_name("radio", vw_rsp + 16 + HAL_VERSION_LEN);
+	}
+	return vw_get16(vw_rsp + 8) ? -7 : 0;
+}
+
+/* FEATURE_CAPS_EXCHANGE announcing STA_POWERSAVE, as wcn36xx does; logs the firmware's bitmap */
+static int
+vw_caps(void)
+{
+	int n;
+
+	vw_hdr(vw_req, HAL_FEATURE_CAPS_REQ, 24);
+	for (int i = 0; i < 4; i++) {
+		vw_put32(vw_req + 8 + 4 * i, 0);
+	}
+	vw_put32(vw_req + 8 + 4 * (FEAT_STA_POWERSAVE / 32), 1u << (FEAT_STA_POWERSAVE % 32));
+	n = vw_xfer(24, HAL_FEATURE_CAPS_RSP);
+	if (n != 24) {
+		printf("VINCE WLAN: FEATURE_CAPS failed %d\n", n);
+		return n < 0 ? n : -6;
+	}
+	printf("VINCE WLAN: caps %08x %08x %08x %08x\n", vw_get32(vw_rsp + 8), vw_get32(vw_rsp + 12),
+	    vw_get32(vw_rsp + 16), vw_get32(vw_rsp + 20));
+	return 0;
+}
+
+static void
+vw_thread(void *arg, wait_result_t w)
+{
+#pragma unused(arg, w)
+	int r = -1;
+
+	/* the channel list is complete once the shim has done the WCNSS_CTRL handshake; give it a minute anyway */
+	for (int i = 0; i < 240 && !vince_smd_find("WLAN_CTRL", &vw_ch); i++) {
+		vince_smd_sleep(250);
+	}
+	if (!vince_smd_find("WLAN_CTRL", &vw_ch)) {
+		printf("VINCE WLAN: no WLAN_CTRL channel (Pronto not started by the shim?)\n");
+		goto out;
+	}
+	for (int i = 0; i < 10 && (r = vw_open()) != 0; i++) {
+		vince_smd_sleep(500);
+	}
+	if (r) {
+		printf("VINCE WLAN: WLAN_CTRL open failed %d\n", r);
+		goto out;
+	}
+	printf("VINCE WLAN: WLAN_CTRL open\n");
+	if (vw_start() == 0 && vw_caps() == 0) {
+		printf("VINCE WLAN: X1 done, HAL is up\n");
+	}
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+vince_wlan_start(void)
+{
+	int on = 0;
+	thread_t thread;
+
+	if (vw_started) {
+		return;
+	}
+	vw_started = true;
+	(void)PE_parse_boot_argn("vincewlan", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	if (!vince_smd_map()) {
+		printf("VINCE WLAN: mapping failed\n");
+		return;
+	}
+	if (kernel_thread_start(vw_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("VINCE WLAN: thread not started\n");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_VINCE */
