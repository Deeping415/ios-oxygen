diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
index f682132..d669b10 100644
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -1849,6 +1849,20 @@ proc_prepareexit(proc_t p, int rv, boolean_t perf_notify)
 		proc_handle_critical_exit(p, rv);
 	}
 
+#if defined(ARM64_BOARD_CONFIG_VINCE)
+	/* daemons that quit (no core signal, so no CRASH line) and get respawned by launchd: say why */
+	if (rv != 0 && !hassigprop(WTERMSIG(rv), SA_CORE)) {
+		if (PROC_HAS_EXITREASON(p)) {
+			char *desc = exit_reason_get_string_desc(p->p_exit_reason);
+			printf("EXIT %s[%d] status %d sig %d reason ns %u code 0x%llx: %s\n", p->p_comm, proc_getpid(p),
+			    WEXITSTATUS(rv), WTERMSIG(rv), p->p_exit_reason->osr_namespace, p->p_exit_reason->osr_code,
+			    desc != NULL ? desc : "(none)");
+		} else {
+			printf("EXIT %s[%d] status %d sig %d\n", p->p_comm, proc_getpid(p), WEXITSTATUS(rv), WTERMSIG(rv));
+		}
+	}
+#endif
+
 	/*
 	 * Generate a corefile/crashlog if:
 	 *      The process doesn't have an exit reason that indicates no crash report should be created
