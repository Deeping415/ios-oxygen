diff --git a/bsd/dev/vince_bt.c b/bsd/dev/vince_bt.c
index ce00955..a7c82f3 100755
--- a/bsd/dev/vince_bt.c
+++ b/bsd/dev/vince_bt.c
@@ -395,6 +395,56 @@ out:
 	thread_block(THREAD_CONTINUE_NULL);
 }
 
+/*
+ * Syscall trace of one process (boot-arg vincetrace=<p_comm>, e.g. bluetoothd): every syscall's number, first argument,
+ * path for the path-taking ones, and the errno, called from bsd/dev/arm/systemcalls.c. Used to learn why a daemon quits.
+ */
+int vince_trace_on;
+static char vince_trace_name[MAXCOMLEN + 1];
+static int vince_trace_budget = 8000;
+
+void
+vince_sc_trace(const char *comm, int code, uint64_t *arg, int error, int ret, int exit_entry)
+{
+	char path[96];
+	size_t len = 0;
+	bool haspath = false;
+
+	if (strncmp(comm, vince_trace_name, MAXCOMLEN) != 0 || vince_trace_budget <= 0) {
+		return;
+	}
+	if (!exit_entry && (code == 1)) {
+		return;
+	}
+	vince_trace_budget--;
+	path[0] = 0;
+	switch (code) {
+	case 5: case 8: case 10: case 15: case 33: case 58: case 188: case 190: case 338: case 341: case 5000:
+		haspath = copyinstr((user_addr_t)arg[0], path, sizeof(path), &len) == 0;
+		break;
+	case 463:
+		haspath = copyinstr((user_addr_t)arg[1], path, sizeof(path), &len) == 0;
+		break;
+	default:
+		break;
+	}
+	if (exit_entry) {
+		printf("VINCE TRC: %s exit(%d)\n", comm, (int)arg[0]);
+	} else {
+		printf("VINCE TRC: %s sc %d a0 %llx%s%s%s err %d ret %d\n", comm, code, arg[0],
+		    haspath ? " \"" : "", haspath ? path : "", haspath ? "\"" : "", error, ret);
+	}
+}
+
+static void
+vince_trace_init(void)
+{
+	if (PE_parse_boot_argn("vincetrace", vince_trace_name, sizeof(vince_trace_name)) && vince_trace_name[0]) {
+		vince_trace_on = 1;
+		printf("VINCE TRC: tracing syscalls of \"%s\"\n", vince_trace_name);
+	}
+}
+
 void
 vince_bt_start(void)
 {
@@ -402,6 +452,8 @@ vince_bt_start(void)
 	int on = 0;
 	thread_t th;
 
+	vince_trace_init();
+
 	if (started) {
 		return;
 	}
