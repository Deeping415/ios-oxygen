@@ -571,7 +696,9 @@ vw_thread(void *arg, wait_result_t w)
 	printf("VINCE WLAN: X1 done, HAL is up\n");
 	if (stage >= 2 && vw_scan_all() == 0) {
 		printf("VINCE WLAN: X2 done\n");
-		if (stage >= 3) {
+		if (stage >= 5) {
+			vw_station();
+		} else if (stage >= 3) {
 			vw_connect_test(stage);
 		}
 	}
