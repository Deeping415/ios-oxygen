+/*
+ * What mac80211 + wcn36xx do when the link goes away: link state idle, delete the AP station (CONFIG_STA's index),
+ * delete the BSS. Without the last two the firmware keeps the old BSS entry, and a following association (with a new
+ * self address) wedged it at SET_LINK_STATE(POSTASSOC) (seen 2026-10-25). Returns the first HAL error, 0 if all ok.
+ */
+static int s_td[5];			/* results of the teardown requests: remove ptk, remove gtk, delete sta, delete bss, link idle */
+static uint32_t s_td_status[5];
+static int s_have_gtk, s_gtk_id;	/* keys installed in this association (for the teardown) */
+
+int va_teardown_code(int i)
+{
+	return s_td[i];
+}
+
+uint32_t va_teardown_status(int i)
+{
+	return s_td_status[i];
+}
+
+/*
+ * Mainline order when a link goes away (mac80211 removes the keys, then the station, then clears the BSSID):
+ * RMV_STAKEY, RMV_BSSKEY, DELETE_STA (CONFIG_STA's index), DELETE_BSS, SET_LINK_STATE(IDLE). DELETE_BSS fails with
+ * status 7 when the link state is already idle (seen 2026-10-25), and leaving the BSS/station/keys behind wedged
+ * the next association. full = 0 only sets the link idle (the old, incomplete behaviour). Returns the first error.
+ */
+static int teardown_fw(const uint8_t *bssid, int full)
+{
+	int e = 0;
+
+	for (int i = 0; i < 5; i++) {
+		s_td[i] = 0;
+		s_td_status[i] = 0;
+	}
+	if (full && s_last.sta_index != 0xff && s_last.bss_index != 0xff) {
+		if (s_encrypted) {
+			struct wcn36xx_hal_remove_sta_key_req_msg k;
+			struct wcn36xx_hal_remove_bss_key_req_msg g;
+
+			memset(&k, 0, sizeof(k));
+			k.sta_idx = s_last.bss_sta_index;
+			k.enc_type = WCN36XX_HAL_ED_CCMP;
+			k.key_id = 0;
+			k.unicast = 1;
+			s_td[0] = vw_cmd(WCN36XX_HAL_RMV_STAKEY_REQ, (uint8_t *)&k + 8, sizeof(k) - 8, &s_td_status[0]);
+			if (s_have_gtk) {
+				memset(&g, 0, sizeof(g));
+				g.bss_idx = s_last.bss_index;
+				g.enc_type = WCN36XX_HAL_ED_CCMP;
+				g.key_id = (u8)s_gtk_id;
+				s_td[1] = vw_cmd(WCN36XX_HAL_RMV_BSSKEY_REQ, (uint8_t *)&g + 8, sizeof(g) - 8, &s_td_status[1]);
+			}
+		}
+		s_td[2] = vw_cmd(WCN36XX_HAL_DELETE_STA_REQ, &s_last.sta_index, 1, &s_td_status[2]);
+		s_td[3] = vw_cmd(WCN36XX_HAL_DELETE_BSS_REQ, &s_last.bss_index, 1, &s_td_status[3]);
+	}
+	s_td[4] = set_link(bssid, WCN36XX_HAL_LINK_IDLE_STATE);
+	for (int i = 0; i < 5; i++)
+		if (!e && s_td[i])
+			e = s_td[i];
+	s_last.sta_index = s_last.bss_index = 0xff;
+	s_encrypted = 0;
+	s_have_gtk = 0;
+	return e;
+}
+
+int va_leave(const struct vd_bss *ap, int full)
 {
 	uint8_t f[40];
 	const uint8_t *self = vw_self_info();
@@ -494,7 +559,14 @@ int va_leave(const struct vd_bss *ap)
 	vd_tx_mgmt(&ctx, f, n, 0);
 	vd_poll(50);
 	s_connected = 0;
-	return set_link(ap->bssid, WCN36XX_HAL_LINK_IDLE_STATE);
+	return teardown_fw(ap->bssid, full);
+}
+
+/* the link is gone without a goodbye (the AP vanished): only the firmware side is cleaned up */
+int va_drop(const struct vd_bss *ap, int full)
+{
+	s_connected = 0;
+	return teardown_fw(ap->bssid, full);
 }
 
