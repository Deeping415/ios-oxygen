+/* ---- X5: a station that stays connected (boot-args vincessid, vincepass, vincerun, vincecycle, vincelease) ---- */
+
+/* HAL requests that get no answer: the firmware stopped reading WLAN_CTRL. Only the HAL steps count (not the over-the-air ones). */
+static bool
+vw_hal_dead(int step, int err)
+{
+	bool hal_step = step == 2 || step == 3 || step == 4 || step == 9 || step == 10 || step == 11;
+
+	return hal_step && err >= -5 && err <= -2;
+}
+
+static void
+vw_station(void)
+{
+	static char ssid[40], pass[72];
+	static struct va_result ar;
+	static struct vwpa_result wr;
+	static const char *const why_names[] = { "?", "time over", "AP dropped us", "keep-alive / lease failed", "forced cycle", "lease changed" };
+	uint32_t n, pl = 0;
+	const struct vd_bss *b = vd_bss_list(&n), *hit = NULL;
+	struct vd_bss ap;
+	int run_s = 600, cycle_s = 0, lease_s = 0, attempt = 0, cycles = 0;
+	uint64_t end;
+
+	if (!PE_parse_boot_argn("vincessid", ssid, sizeof(ssid)) || !PE_parse_boot_argn("vincepass", pass, sizeof(pass))) {
+		printf("VINCE WLAN: vincessid / vincepass boot-args missing, stopping after the scan\n");
+		return;
+	}
+	(void)PE_parse_boot_argn("vincerun", &run_s, sizeof(run_s));
+	(void)PE_parse_boot_argn("vincecycle", &cycle_s, sizeof(cycle_s));
+	(void)PE_parse_boot_argn("vincelease", &lease_s, sizeof(lease_s));
+	vw_unscore(ssid);
+	while (pass[pl]) {
+		pl++;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		if (strncmp(b[i].ssid, ssid, 33) == 0 && (!hit || b[i].rssi > hit->rssi)) {
+			hit = &b[i];
+		}
+	}
+	if (!hit) {
+		printf("VINCE WLAN: \"%s\" is not in the scan table\n", ssid);
+		return;
+	}
+	ap = *hit;
+	end = vd_now_us() + (uint64_t)run_s * 1000000ULL;
+	printf("VINCE WLAN: station \"%s\" ch %u, run %d s, forced cycle %d s, lease override %d s\n", ap.ssid, ap.ch, run_s,
+	    cycle_s, lease_s);
+	vif_start_ping((uint32_t)run_s / 5, 5000);
+	while (vd_now_us() < end) {
+		const struct vn_cfg *c;
+		int r, why;
+
+		va_use_rsn(1);
+		r = va_connect(&ap, &ar);
+		va_use_rsn(0);
+		vw_log_assoc(&ar);
+		if (r) {
+			if (vw_hal_dead(ar.step, ar.err)) {
+				printf("VINCE WLAN: the firmware stopped answering HAL requests (step %d): Wi-Fi needs a Pronto restart\n", ar.step);
+				break;
+			}
+		} else {
+			r = vwpa_handshake(&ap, pass, pl, &wr);
+			printf("VINCE WLAN: handshake %s at step %d (%s) err %d, gtk id %u\n", r ? "FAILED" : "done", wr.step,
+			    vwpa_step_name(wr.step), wr.err, wr.gtk_id);
+			if (r && vw_hal_dead(wr.step, wr.err)) {
+				printf("VINCE WLAN: the firmware stopped answering HAL requests: Wi-Fi needs a Pronto restart\n");
+				break;
+			}
+			if (!r) {
+				r = vn_dhcp();
+				if (r) {
+					printf("VINCE WLAN: DHCP failed, step %d\n", r);
+				}
+			}
+		}
+		if (r) {
+			uint32_t backoff = 2u << (attempt < 4 ? attempt : 4);
+
+			vwpa_stop();
+			(void)va_leave(&ap, 1);
+			vn_link_reset();
+			printf("VINCE WLAN: reconnect attempt %d failed, waiting %u s\n", attempt + 1, backoff);
+			attempt++;
+			vince_smd_sleep(backoff * 1000);
+			continue;
+		}
+		attempt = 0;
+		c = vn_get_cfg();
+		printf("VINCE WLAN: DHCP lease ip %u.%u.%u.%u gw %u.%u.%u.%u lease %u s\n", c->ip[0], c->ip[1], c->ip[2], c->ip[3],
+		    c->gw[0], c->gw[1], c->gw[2], c->gw[3], c->lease);
+		if (vif_up(c)) {
+			break;
+		}
+		for (;;) {
+			uint64_t now = vd_now_us();
+
+			if (now >= end) {
+				why = VIF_END_TIME;
+				break;
+			}
+			why = vif_serve(end - now, (uint32_t)cycle_s, (uint32_t)lease_s);
+			if (why != VIF_END_RECFG) {
+				break;
+			}
+			(void)vif_up(vif_current_cfg());
+		}
+		printf("VINCE WLAN: serve ended: %s\n", why >= 1 && why <= 5 ? why_names[why] : why_names[0]);
+		vif_down();
+		vwpa_stop();
+		printf("VINCE WLAN: leave %d\n", va_leave(&ap, 1));
+		vn_link_reset();
+		if (why == VIF_END_TIME) {
+			break;
+		}
+		cycles++;
+		vince_smd_sleep(2000);          /* let the AP forget us */
+	}
+	bzero(pass, sizeof(pass));
+	vif_stop_ping();
+	vince_smd_sleep(6000);
+	printf("VINCE WLAN: station done after %d reconnect cycles\n", cycles);
+}
