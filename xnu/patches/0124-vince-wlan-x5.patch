+/* en0 up: attach on first use, address and default route from the lease */
+int
+vif_up(const struct vn_cfg *c)
+{
+	vif_cfg = *c;
+	vn_set_stack_mode(1);
+	if (!vif_ifp && vif_attach(vw_mac)) {
+		vn_set_stack_mode(0);
+		return -1;
+	}
+	vif_unconfig();
+	return vif_config(c);
+}
+
+void
+vif_down(void)
+{
+	if (vif_ifp) {
+		ifnet_set_flags(vif_ifp, 0, IFF_RUNNING);
+	}
+	vif_unconfig();
+	vn_set_stack_mode(0);
+}
