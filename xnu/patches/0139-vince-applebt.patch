+/*
+ * AppleBT interface for iokit/Kernel/arm/VinceBT.cpp (bluetoothd's "APPLEBT" HCI transport). A pipe item is
+ * {u16 length, u8 sequence, u8 0} + one H4 packet; pipes 0..4 go to the controller (0 commands, 1/3/4 ACL, 2 SCO),
+ * pipes 5.. come back (5 events, 6 ACL, 7 SCO).
+ */
+#define VBT_NPIPES      11
+static const struct {
+	uint32_t size, count;
+} vbt_pipe_cfg[VBT_NPIPES] = {
+	{ 264, 8 }, { 1100, 8 }, { 264, 8 }, { 1100, 8 }, { 1100, 8 },
+	{ 264, 16 }, { 1104, 8 }, { 264, 4 }, { 264, 4 }, { 264, 4 }, { 1024, 1 },
+};
+static uint8_t vbt_seq[VBT_NPIPES];
+
+uint32_t
+vince_bt_pipe_size(int p)
+{
+	return p >= 0 && p < VBT_NPIPES ? vbt_pipe_cfg[p].size : 0;
+}
+
+uint32_t
+vince_bt_pipe_count(int p)
+{
+	return p >= 0 && p < VBT_NPIPES ? vbt_pipe_cfg[p].count : 0;
+}
+
+int
+vince_bt_hci_open(void)
+{
+	for (int i = 0; i < 200 && !vbt_up; i++) {
+		vince_smd_sleep(50);
+	}
+	if (!vbt_up) {
+		return -1;
+	}
+	lck_mtx_lock(vbt_lock);
+	vbt_tail = vbt_head;
+	bzero(vbt_seq, sizeof(vbt_seq));
+	lck_mtx_unlock(vbt_lock);
+	printf("VINCE BT: AppleBTHci opened\n");
+	return 0;
+}
+
+void
+vince_bt_hci_close(void)
+{
+	printf("VINCE BT: AppleBTHci closed\n");
+}
+
+void
+vince_bt_hci_reset(void)
+{
+	lck_mtx_lock(vbt_lock);
+	vbt_tail = vbt_head;
+	bzero(vbt_seq, sizeof(vbt_seq));
+	lck_mtx_unlock(vbt_lock);
+}
+
+static void
+vbt_put32(uint8_t *b, uint32_t v)
+{
+	b[0] = (uint8_t)v;
+	b[1] = (uint8_t)(v >> 8);
+	b[2] = (uint8_t)(v >> 16);
+	b[3] = (uint8_t)(v >> 24);
+}
+
+static uint32_t
+vbt_get32(const uint8_t *b)
+{
+	return b[0] | (uint32_t)b[1] << 8 | (uint32_t)b[2] << 16 | (uint32_t)b[3] << 24;
+}
+
+int
+vince_bt_hci_write(const uint8_t *d, uint32_t n, uint8_t *out)
+{
+	for (uint32_t i = 0; i < n; i++) {
+		const uint8_t *dp = d + 16 * i;
+		uint32_t size = vbt_get32(dp + 4), status = 0, written = 0;
+		uint64_t ptr = (uint64_t)vbt_get32(dp + 8) | (uint64_t)vbt_get32(dp + 12) << 32;
+		uint8_t *buf;
+
+		if (size < 4 || size > 8192) {
+			status = 0xe00002c2;
+		} else if ((buf = kalloc_data(size, Z_WAITOK)) == NULL) {
+			status = 0xe00002bd;
+		} else {
+			if (copyin((user_addr_t)ptr, buf, size) != 0) {
+				status = 0xe00002c2;
+			} else {
+				uint32_t off = 0;
+
+				while (off + 4 <= size && written < dp[1]) {
+					uint32_t len = buf[off] | (uint32_t)buf[off + 1] << 8;
+
+					if (off + 4 + len > size) {
+						break;
+					}
+					vbt_send_packet(buf + off + 4, len);
+					off += 4 + len;
+					written++;
+				}
+			}
+			kfree_data(buf, size);
+		}
+		vbt_put32(out + 8 * i, status);
+		out[8 * i + 4] = (uint8_t)written;
+	}
+	return 0;
+}
+
+/* length of the H4 packet at the ring's tail (0 when it is not complete yet, -1 for a byte that is no packet type) */
+static int
+vbt_peek_len(void)
+{
+	uint32_t avail = vbt_rx_avail(), len;
+	const uint32_t m = RXSZ - 1;
+
+	if (avail < 1) {
+		return 0;
+	}
+	switch (vbt_rx[vbt_tail & m]) {
+	case 0x04:
+		if (avail < 3) {
+			return 0;
+		}
+		len = 3u + vbt_rx[(vbt_tail + 2) & m];
+		break;
+	case 0x02:
+		if (avail < 5) {
+			return 0;
+		}
+		len = 5u + (vbt_rx[(vbt_tail + 3) & m] | (uint32_t)vbt_rx[(vbt_tail + 4) & m] << 8);
+		break;
+	case 0x03:
+		if (avail < 4) {
+			return 0;
+		}
+		len = 4u + vbt_rx[(vbt_tail + 3) & m];
+		break;
+	default:
+		return -1;
+	}
+	return avail >= len ? (int)len : 0;
+}
+
+/* returns 0, or 4 when a signal interrupted the wait (the caller reports kIOReturnAborted and bluetoothd reads again) */
+int
+vince_bt_hci_read(const uint8_t *d, uint32_t n, uint8_t *out)
+{
+	struct {
+		uint8_t pipe;
+		uint32_t size, used;
+		uint8_t cnt;
+		uint64_t ptr;
+		uint8_t *buf;
+	} dd[8];
+	int ret = 0;
+	const uint32_t m = RXSZ - 1;
+
+	if (n == 0 || n > 8) {
+		return -1;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		const uint8_t *dp = d + 16 * i;
+
+		dd[i].pipe = dp[0];
+		dd[i].size = vbt_get32(dp + 4);
+		dd[i].ptr = (uint64_t)vbt_get32(dp + 8) | (uint64_t)vbt_get32(dp + 12) << 32;
+		dd[i].used = 0;
+		dd[i].cnt = 0;
+		if (dd[i].size > 16384) {
+			dd[i].size = 16384;
+		}
+		dd[i].buf = dd[i].size ? kalloc_data(dd[i].size, Z_WAITOK | Z_ZERO) : NULL;
+	}
+	lck_mtx_lock(vbt_lock);
+	for (;;) {
+		int l = vbt_peek_len();
+
+		if (l < 0) {
+			vbt_tail++;             /* out of sync: drop the byte */
+			continue;
+		}
+		if (l > 0) {
+			break;
+		}
+		{
+			struct timespec ts = { 1, 0 };
+			int err = msleep(&vbt_head, vbt_lock, PCATCH | PRIBIO, "vbthci", &ts);
+
+			if (err == EWOULDBLOCK) {
+				break;
+			}
+			if (err) {
+				ret = 4;
+				break;
+			}
+		}
+	}
+	while (ret == 0) {
+		int l = vbt_peek_len();
+		uint8_t type;
+		uint8_t pipe;
+		uint32_t k;
+
+		if (l < 0) {
+			vbt_tail++;
+			continue;
+		}
+		if (l == 0) {
+			break;
+		}
+		type = vbt_rx[vbt_tail & m];
+		pipe = type == 0x04 ? 5 : (type == 0x02 ? 6 : 7);
+		for (k = 0; k < n && dd[k].pipe != pipe; k++) {
+		}
+		if (k == n || dd[k].buf == NULL) {
+			vbt_tail += (uint32_t)l;        /* nobody reads that pipe */
+			continue;
+		}
+		if (dd[k].used + 4 + (uint32_t)l > dd[k].size || dd[k].cnt >= 200) {
+			break;                          /* does not fit: stays queued for the next call */
+		}
+		dd[k].buf[dd[k].used] = (uint8_t)l;
+		dd[k].buf[dd[k].used + 1] = (uint8_t)((uint32_t)l >> 8);
+		dd[k].buf[dd[k].used + 2] = vbt_seq[pipe]++;
+		dd[k].buf[dd[k].used + 3] = 0;
+		for (int j = 0; j < l; j++) {
+			dd[k].buf[dd[k].used + 4 + (uint32_t)j] = vbt_rx[(vbt_tail + (uint32_t)j) & m];
+		}
+		vbt_log("ctrl->host (AppleBT)", dd[k].buf + dd[k].used + 4, (uint32_t)l);
+		dd[k].used += 4 + (uint32_t)l;
+		dd[k].cnt++;
+		vbt_tail += (uint32_t)l;
+	}
+	lck_mtx_unlock(vbt_lock);
+	for (uint32_t i = 0; i < n; i++) {
+		uint32_t status = 0;
+
+		if (dd[i].buf) {
+			if (dd[i].used && copyout(dd[i].buf, (user_addr_t)dd[i].ptr, dd[i].used) != 0) {
+				status = 0xe00002c2;
+				dd[i].cnt = 0;
+			}
+			kfree_data(dd[i].buf, dd[i].size);
+		}
+		vbt_put32(out + 8 * i, status);
+		out[8 * i + 4] = dd[i].cnt;
+	}
+	return ret;
+}
+
 /*
