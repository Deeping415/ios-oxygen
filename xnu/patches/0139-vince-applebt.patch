@@ -0,0 +1,274 @@
+/*
+ * VINCE Bluetooth in the IORegistry: the "AppleBT" HCI driver interface of bluetoothd (HCI Transport "APPLEBT",
+ * transport-encoding 6 in the device tree).
+ *
+ * iOS 16's bluetoothd does not talk to a serial port: it opens the IOKit services AppleBTMgmt (trace / crash
+ * handling, unused here) and AppleBTHci (the HCI pipes) and moves HCI packets with IOConnectCallMethod. The shapes
+ * below were read from bluetoothd (applebt_transport.c, applebt_hci_*): selector 0 open, 1 close, 2 write, 3 read,
+ * 4 transport reset; write and read take n 16-byte descriptors {u8 pipe, u8 count, u16 pad, u32 size, u64 user
+ * pointer}, return n 8-byte results {u32 IOReturn, u8 item count}; an item in a pipe buffer is {u16 length,
+ * u8 sequence, u8 0} followed by one H4 packet. The "pipes" property of the service gives each pipe's item size and
+ * item count. The packets themselves go to the Pronto controller through bsd/dev/vince_bt.c.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(ARM64_BOARD_CONFIG_VINCE)
+#include <IOKit/IOService.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSString.h>
+#include <sys/proc.h>
+
+extern "C" {
+int vince_bt_hci_open(void);
+void vince_bt_hci_close(void);
+int vince_bt_hci_write(const uint8_t *desc, uint32_t n, uint8_t *out);
+int vince_bt_hci_read(const uint8_t *desc, uint32_t n, uint8_t *out);
+void vince_bt_hci_reset(void);
+uint32_t vince_bt_pipe_size(int pipe);
+uint32_t vince_bt_pipe_count(int pipe);
+}
+
+#define VBT_NPIPES 11
+
+static void
+vbt_io_log(const char *what, uint32_t selector, IOExternalMethodArguments *args)
+{
+	static unsigned n;
+	char name[32];
+
+	if (n >= 200) {
+		return;
+	}
+	n++;
+	proc_selfname(name, sizeof(name));
+	IOLog("VINCE BT IO: %s selector %u by %s, in %u/%u out %u/%u\n", what, selector, name,
+	    args->scalarInputCount, (unsigned)args->structureInputSize, args->scalarOutputCount,
+	    (unsigned)args->structureOutputSize);
+}
+
+/* ---- AppleBTMgmt: trace and crash information; everything succeeds, crash information is empty ---- */
+
+class AppleBTMgmt : public IOService {
+	OSDeclareDefaultStructors(AppleBTMgmt);
+};
+OSDefineMetaClassAndStructors(AppleBTMgmt, IOService);
+
+class AppleBTMgmtUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(AppleBTMgmtUserClient);
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(AppleBTMgmtUserClient, IOUserClient);
+
+IOReturn
+AppleBTMgmtUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AppleBTMgmtUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target, __unused void *reference)
+{
+	vbt_io_log("AppleBTMgmt", selector, args);
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = 0;
+	}
+	if (args->structureOutput != NULL) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+	return kIOReturnSuccess;
+}
+
+/* ---- AppleBluetoothModule: power / reset of the module; nothing to do here ---- */
+
+class AppleBluetoothModule : public IOService {
+	OSDeclareDefaultStructors(AppleBluetoothModule);
+};
+OSDefineMetaClassAndStructors(AppleBluetoothModule, IOService);
+
+class AppleBluetoothModuleUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(AppleBluetoothModuleUserClient);
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(AppleBluetoothModuleUserClient, IOUserClient);
+
+IOReturn
+AppleBluetoothModuleUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AppleBluetoothModuleUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target, __unused void *reference)
+{
+	vbt_io_log("AppleBluetoothModule", selector, args);
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = 0;
+	}
+	if (args->structureOutput != NULL) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+	return kIOReturnSuccess;
+}
+
+/* ---- AppleBTHci: the HCI pipes ---- */
+
+class AppleBTHci : public IOService {
+	OSDeclareDefaultStructors(AppleBTHci);
+};
+OSDefineMetaClassAndStructors(AppleBTHci, IOService);
+
+class AppleBTHciUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(AppleBTHciUserClient);
+public:
+	bool opened;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(AppleBTHciUserClient, IOUserClient);
+
+IOReturn
+AppleBTHciUserClient::clientClose(void)
+{
+	if (opened) {
+		opened = false;
+		vince_bt_hci_close();
+	}
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AppleBTHciUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target, __unused void *reference)
+{
+	switch (selector) {
+	case 0:         /* open */
+		vbt_io_log("AppleBTHci open", selector, args);
+		if (vince_bt_hci_open() != 0) {
+			return kIOReturnNotReady;
+		}
+		opened = true;
+		return kIOReturnSuccess;
+	case 1:         /* close */
+		vbt_io_log("AppleBTHci close", selector, args);
+		if (opened) {
+			opened = false;
+			vince_bt_hci_close();
+		}
+		return kIOReturnSuccess;
+	case 4:         /* transport reset */
+		vbt_io_log("AppleBTHci reset", selector, args);
+		vince_bt_hci_reset();
+		return kIOReturnSuccess;
+	case 2:         /* write */
+	case 3:         /* read */
+		if (!opened) {
+			return kIOReturnNotOpen;
+		}
+		if (args->structureInput == NULL || args->structureOutput == NULL || (args->structureInputSize % 16) != 0 ||
+		    args->structureOutputSize < (args->structureInputSize / 16) * 8) {
+			vbt_io_log("AppleBTHci bad shape", selector, args);
+			return kIOReturnBadArgument;
+		}
+		{
+			uint32_t n = (uint32_t)(args->structureInputSize / 16);
+			int r;
+
+			bzero(args->structureOutput, args->structureOutputSize);
+			if (selector == 2) {
+				r = vince_bt_hci_write((const uint8_t *)args->structureInput, n, (uint8_t *)args->structureOutput);
+			} else {
+				r = vince_bt_hci_read((const uint8_t *)args->structureInput, n, (uint8_t *)args->structureOutput);
+			}
+			args->structureOutputSize = n * 8;
+			return r == 0 ? kIOReturnSuccess : (r == 4 ? (IOReturn)0xe00002eb : kIOReturnError);
+		}
+	default:
+		vbt_io_log("AppleBTHci unknown", selector, args);
+		return kIOReturnUnsupported;
+	}
+}
+
+/* ---- publishing, called from vince_bt.c once the controller's SMD channels are open ---- */
+
+static AppleBTMgmt *vbt_mgmt;
+static AppleBTHci *vbt_hci;
+static AppleBluetoothModule *vbt_mod;
+
+static OSDictionary *
+vbt_pipes_dict(void)
+{
+	OSDictionary *d = OSDictionary::withCapacity(VBT_NPIPES);
+
+	for (int p = 0; d && p < VBT_NPIPES; p++) {
+		OSDictionary *e = OSDictionary::withCapacity(2);
+		OSNumber *sz = OSNumber::withNumber((unsigned long long)vince_bt_pipe_size(p), 32);
+		OSNumber *ct = OSNumber::withNumber((unsigned long long)vince_bt_pipe_count(p), 32);
+		char key[16];
+
+		snprintf(key, sizeof(key), "pipe%d", p);
+		if (e && sz && ct) {
+			e->setObject("item_size", sz);
+			e->setObject("item_count", ct);
+			d->setObject(key, e);
+		}
+		OSSafeReleaseNULL(sz);
+		OSSafeReleaseNULL(ct);
+		OSSafeReleaseNULL(e);
+	}
+	return d;
+}
+
+extern "C" int
+vince_bt_iokit_publish(void)
+{
+	OSDictionary *pipes;
+
+	if (vbt_hci) {
+		return 0;
+	}
+	vbt_mgmt = new AppleBTMgmt;
+	vbt_hci = new AppleBTHci;
+	vbt_mod = new AppleBluetoothModule;
+	if (!vbt_mgmt || !vbt_hci || !vbt_mod || !vbt_mgmt->init() || !vbt_hci->init() || !vbt_mod->init()) {
+		return -1;
+	}
+	vbt_mgmt->setName("AppleBTMgmt");
+	vbt_mgmt->setProperty(kIOUserClientClassKey, "AppleBTMgmtUserClient");
+	vbt_mod->setName("AppleBluetoothModule");
+	vbt_mod->setProperty(kIOUserClientClassKey, "AppleBluetoothModuleUserClient");
+	vbt_hci->setName("AppleBTHci");
+	vbt_hci->setProperty(kIOUserClientClassKey, "AppleBTHciUserClient");
+	pipes = vbt_pipes_dict();
+	if (pipes) {
+		vbt_hci->setProperty("pipes", pipes);
+		pipes->release();
+	}
+	if (!vbt_mod->attach(IOService::getPlatform()) || !vbt_mgmt->attach(IOService::getPlatform()) ||
+	    !vbt_hci->attach(IOService::getPlatform())) {
+		return -2;
+	}
+	vbt_mod->registerService();
+	vbt_mgmt->registerService();
+	vbt_hci->registerService();
+	IOLog("VINCE BT IO: AppleBTMgmt, AppleBTHci and AppleBluetoothModule registered\n");
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_VINCE */
