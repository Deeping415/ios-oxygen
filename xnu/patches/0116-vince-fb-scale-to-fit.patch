@@ -200,12 +209,44 @@ AppleCLCD::start(IOService *provider)
 	}
 	fOffX = (int32_t)(fLogicalW - fWidth) / 2;
 	fOffY = (int32_t)(fLogicalH - fHeight) / 2;
+	fShadowW = fWidth;
+	fShadowH = fHeight;
+	fScaled = false;
+#if defined(ARM64_BOARD_CONFIG_VINCE)
+	int crop = 0;
+	PE_parse_boot_argn("vincefb_crop", &crop, sizeof(crop));
+	if (fPanelBpp == 3 && !crop && (fLogicalW != fWidth || fLogicalH != fHeight)) {
+		/* Fit the height, keep the aspect; the width rounded to a multiple of 8 so the bars are whole words. */
+		uint32_t outW = ((fLogicalW * fHeight + fLogicalH / 2) / fLogicalH + 4) & ~7u;
+		if (outW > fWidth) {
+			outW = fWidth & ~7u;
+		}
+		fXMap = (uint16_t *)IOMalloc(outW * sizeof(uint16_t));
+		fYMap = (uint16_t *)IOMalloc(fHeight * sizeof(uint16_t));
+		if (fXMap != NULL && fYMap != NULL) {
+			for (uint32_t x = 0; x < outW; x++) {
+				fXMap[x] = (uint16_t)(((2 * x + 1) * fLogicalW) / (2 * outW));
+			}
+			for (uint32_t y = 0; y < fHeight; y++) {
+				fYMap[y] = (uint16_t)(((2 * y + 1) * fLogicalH) / (2 * fHeight));
+			}
+			fScaled = true;
+			fOutW = outW;
+			fBarX = (fWidth - outW) / 2;
+			fShadowW = fLogicalW;
+			fShadowH = fLogicalH;
+			fRowBytes = fShadowW * 4;
+			fOffX = fOffY = 0;
+		}
+	}
