+	/*
+	 * VINCE scale-to-fit (default; boot-arg vincefb_crop=1 keeps the old centred crop): the shadow is the whole
+	 * logical display (fShadowW x fShadowH = 1125x2436) and flushPanel() samples it down to fOutW x fHeight
+	 * (1000x2160) at panel column fBarX (40), black bars either side. fXMap/fYMap: shadow column/row per panel
+	 * pixel (nearest, centre-sampled).
+	 */
+	bool          fScaled;
+	uint32_t      fShadowW, fShadowH, fOutW, fBarX;
+	uint16_t     *fXMap, *fYMap;
