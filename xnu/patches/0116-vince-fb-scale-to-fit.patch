@@ -448,6 +493,30 @@ AppleCLCD::present(const uint8_t *rec)
 void
 AppleCLCD::flushPanel(void)
 {
+	if (fScaled) {
+		/* nearest sample of the logical display per panel pixel; bars rewritten each time (240 bytes a row) */
+		uint32_t barBytes = fBarX * 3, endBytes = (fBarX + fOutW) * 3;
+		for (uint32_t y = 0; y < fHeight; y++) {
+			const uint32_t *s = (const uint32_t *)(fPixels + (uint64_t)fYMap[y] * fRowBytes);
+			volatile uint32_t *row = (volatile uint32_t *)(fPanel + (uint64_t)y * fPanelRowBytes);
+			for (uint32_t i = 0; i < barBytes / 4; i++) {
+				row[i] = 0;
+			}
+			for (uint32_t i = endBytes / 4; i < fWidth * 3 / 4; i++) {
+				row[i] = 0;
+			}
+			volatile uint32_t *d = row + barBytes / 4;
+			const uint16_t *xm = fXMap;
+			for (uint32_t x = 0; x + 4 <= fOutW; x += 4, xm += 4, d += 3) {
+				uint32_t p0 = s[xm[0]] & 0xffffff, p1 = s[xm[1]] & 0xffffff, p2 = s[xm[2]] & 0xffffff;
+				uint32_t p3 = s[xm[3]] & 0xffffff;
+				d[0] = p0 | p1 << 24;
+				d[1] = p1 >> 8 | p2 << 16;
+				d[2] = p2 >> 16 | p3 << 8;
+			}
+		}
+		return;
+	}
 	for (uint32_t y = 0; y < fHeight; y++) {
 		const uint32_t *s = (const uint32_t *)(fPixels + (uint64_t)y * fRowBytes);
 		volatile uint32_t *d = (volatile uint32_t *)(fPanel + (uint64_t)y * fPanelRowBytes);
