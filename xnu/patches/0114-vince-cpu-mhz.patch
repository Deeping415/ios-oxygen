+/*
+ * This CPU's clock in MHz: PMCCNTR_EL0 against CNTVCT over about 10 ms (busy, interrupts as they are). LK leaves
+ * the A53 clusters at whatever it booted them with; there is no cpufreq here.
+ */
+static uint32_t
+vince_cpu_mhz(void)
+{
+	uint64_t pmcr = __builtin_arm_rsr64("PMCR_EL0");
+	__builtin_arm_wsr64("PMCR_EL0", (pmcr | 1) & ~(1ULL << 3));      /* enable, count every cycle (D = 0) */
+	__builtin_arm_wsr64("PMCNTENSET_EL0", 1ULL << 31);
+	__builtin_arm_isb(ISB_SY);
+	uint64_t f = __builtin_arm_rsr64("CNTFRQ_EL0");
+	uint64_t t0 = __builtin_arm_rsr64("CNTVCT_EL0"), c0 = __builtin_arm_rsr64("PMCCNTR_EL0");
+	uint64_t t1, c1;
+	do {
+		__builtin_arm_isb(ISB_SY);
+		t1 = __builtin_arm_rsr64("CNTVCT_EL0");
+	} while (t1 - t0 < f / 100);
+	c1 = __builtin_arm_rsr64("PMCCNTR_EL0");
+	return f ? (uint32_t)((c1 - c0) * f / (t1 - t0) / 1000000) : 0;
+}
+
