+/*
+ * Mapped address of a global SMEM item: the global partition first (both hosts 0xfffe), then the legacy item table
+ * in the SMEM header (shim smem.c smem_get). 0 if absent. The RPM message RAM aux region is not handled.
+ */
+vm_offset_t
+vince_smd_item(uint32_t item, uint32_t *size)
+{
+	uint32_t po, ps, cl, sz = 0, o;
+
+	*size = 0;
+	if (!smem) {
+		return 0;
+	}
+	if (smem_partition(0, &po, &ps, &cl, true)) {
+		o = part_get(po, ps, cl, item, &sz);
+		if (o) {
+			*size = sz;
+			return smem + o;
+		}
+	}
+	if (item < 512) {
+		uint32_t tb = 0xD0u + item * 16;
+
+		if (srd32(tb) == 1) {
+			uint32_t off = srd32(tb + 4), isz = srd32(tb + 8), aux = srd32(tb + 12) & ~3u;
+
+			if ((aux == 0 || aux == SMEM_PA) && off <= SMEM_SIZE && isz <= SMEM_SIZE - off) {
+				*size = isz;
+				return smem + off;
+			}
+		}
+	}
+	return 0;
+}
