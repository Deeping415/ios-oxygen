+
+/* HAL client (vince_wlan.c) */
+int vw_raw(uint16_t type, const void *body, uint32_t blen, void *rsp, uint32_t max);
+#endif
+#endif /* _VINCE_WLAN_H_ */
diff --git a/bsd/dev/vince_wlan_dxe.c b/bsd/dev/vince_wlan_dxe.c
new file mode 100755
index 0000000..2a81dab
--- /dev/null
+++ b/bsd/dev/vince_wlan_dxe.c
@@ -0,0 +1,753 @@
+/*
+ * VINCE Pronto DXE client, X2 of reports/WIFI_HANDOFF.md. A port of vince-bringup/shim/dxe.c, which was proven on the
+ * phone first (scan, probe requests, association, WPA2 data). Register layout, descriptor format and channel set-up
+ * follow mainline drivers/net/wireless/ath/wcn36xx/dxe.c (ISC licence). Polled: the DXE interrupts are not used.
+ *
+ * Memory: descriptors and frame buffers live in the 256 KiB window at physical 0x47400000, outside the DRAM that XNU
+ * manages (0xa0000000 and up), mapped with ml_io_map (device memory: every access is aligned). Descriptors carry
+ * physical addresses, the CPU uses the mapping (vd_pa / vd_va translate). Registers: DXE 0x0A202000, CCU 0x0A204000.
+ * Pronto must be running (guide H6) and the apps SMSM "tx rings empty" bit set before the HAL start.
+ */
+#if defined(ARM64_BOARD_CONFIG_VINCE)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include "vince_smd.h"
+#include "vince_wlan.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define DXE_PA                  0x0A202000u
+#define CCU_PA                  0x0A204000u
+#define MEM_PA                  0x47400000u
+#define MEM_END                 0x40000u
+
+#define SMEM_SMSM_SHARED_STATE  85u
+#define SMSM_TX_ENABLE          (1u << 10)
+#define SMSM_TX_RINGS_EMPTY     (1u << 9)
+#define APCS_IPC_WCNSS_SMSM     (1u << 19)      /* msm8953.dtsi smsm mboxes: host 3 (WCNSS) = apcs 19 */
+
+/* DXE registers */
+#define REG_CSR_RESET           0x00u
+#define REG_ENCH_ADDR           0x04u
+#define REG_INT_MASK            0x18u
+#define REG_INT_SRC_RAW         0x20u
+#define REG_INT_CLR             0x30u
+#define REG_INT_ED_CLR          0x34u
+#define REG_INT_DONE_CLR        0x38u
+#define REG_INT_ERR_CLR         0x3Cu
+#define CSR_RESET_VALUE         0x5c89u
+#define CCU_DXE_INT_SELECT_PRONTO 0x10dcu
+
+#define TX_L_OFF                0x400u
+#define TX_H_OFF                0x500u
+#define RX_L_OFF                0x440u
+#define RX_H_OFF                0x4C0u
+#define CH_STATUS               0x04u
+#define CH_SRC_ADDR             0x0Cu
+#define CH_DEST_ADDR            0x14u
+#define CH_NEXT_DESC            0x1Cu
+
+#define INT_TX_L                0x00000001u
+#define INT_RX_L                0x00000002u
+#define INT_RX_H                0x00000008u
+#define INT_TX_H                0x00000010u
+#define CH1_MASK                0x00000002u
+#define CH3_MASK                0x00000008u
+#define STAT_DONE               0x00008000u
+#define STAT_ERR                0x00004000u
+#define STAT_ED                 0x00002000u
+
+/* descriptor control word */
+#define C_VLD                   (1u << 0)
+#define C_XTYPE(x)              ((uint32_t)(x) << 1)
+#define C_EOP                   (1u << 3)
+#define C_SIQ                   (1u << 5)
+#define C_DIQ                   (1u << 6)
+#define C_PDU_REL               (1u << 8)
+#define C_BTHLD(x)              ((uint32_t)(x) << 9)
+#define C_PRIO(x)               ((uint32_t)(x) << 13)
+#define C_INT                   (1u << 17)
+#define C_SWAP                  (1u << 20)
+#define C_ENDIAN                (1u << 21)
+#define XT_H2B                  2
+#define XT_B2H                  3
+
+#define CTRL_TX_L               (C_XTYPE(XT_H2B) | C_DIQ | C_BTHLD(5) | C_PRIO(4) | C_INT | C_SWAP | C_ENDIAN)
+#define CTRL_TX_H               (C_XTYPE(XT_H2B) | C_DIQ | C_BTHLD(7) | C_PRIO(6) | C_INT | C_SWAP | C_ENDIAN)
+#define CTRL_RX_L               (C_VLD | C_XTYPE(XT_B2H) | C_EOP | C_SIQ | C_PDU_REL | C_BTHLD(6) | C_PRIO(5) | C_INT | C_SWAP)
+#define CTRL_RX_H               (C_VLD | C_XTYPE(XT_B2H) | C_EOP | C_SIQ | C_PDU_REL | C_BTHLD(8) | C_PRIO(6) | C_INT | C_SWAP)
+
+/* channel control register defaults */
+#define CH_EN                   (1u << 0)
+#define CH_EOP                  (1u << 3)
+#define CH_SIQ                  (1u << 5)
+#define CH_DIQ                  (1u << 6)
+#define CH_PDU_REL              (1u << 8)
+#define CH_INE_ED               (1u << 17)
+#define CH_INE_ERR              (1u << 18)
+#define CH_INE_DONE             (1u << 19)
+#define CH_EDEN                 (1u << 20)
+#define CH_EDVEN                (1u << 21)
+#define CH_ENDIAN               (1u << 26)
+#define CH_SWAP                 (1u << 31)
+#define CH_SEL(x)               ((uint32_t)(x) << 22)
+#define DEF_CTL_RX_L            (CH_EN | C_XTYPE(XT_B2H) | CH_EOP | CH_SIQ | CH_PDU_REL | C_BTHLD(6) | C_PRIO(5) | \
+	                         CH_INE_ED | CH_INE_ERR | CH_INE_DONE | CH_EDEN | CH_EDVEN | CH_SEL(1) | CH_ENDIAN | CH_SWAP)
+#define DEF_CTL_RX_H            (CH_EN | C_XTYPE(XT_B2H) | CH_EOP | CH_SIQ | CH_PDU_REL | C_BTHLD(8) | C_PRIO(6) | \
+	                         CH_INE_ED | CH_INE_ERR | CH_INE_DONE | CH_EDEN | CH_EDVEN | CH_SEL(3) | CH_ENDIAN | CH_SWAP)
+
+/* BMU work queues (pronto v3: TX 6) */
+#define WQ_TX_L                 0x6u
+#define WQ_TX_H                 0x6u
+#define WQ_RX_L                 0xBu
+#define WQ_RX_H                 0x4u
+
+#define N_TX_L                  8u
+#define N_TX_H                  8u
+#define N_RX_L                  32u
+#define N_RX_H                  16u
+#define PKT_SIZE                0xF20u
+#define BUF_STRIDE              0x1000u
+
+struct vdesc {
+	uint32_t ctrl, fr_len, src_l, dst_l, next_l, src_h, dst_h, next_h;
+};
+
+/* layout inside the window */
+#define OFF_RX_L_DESC           0x0000u
+#define OFF_RX_H_DESC           0x0400u
+#define OFF_TX_L_DESC           0x0600u
+#define OFF_TX_H_DESC           0x0700u
+#define OFF_RX_L_BUF            0x10000u
+#define OFF_RX_H_BUF            0x30000u
+
+/* TX: BD + frame buffers */
+#define OFF_TX_H_BD             0x4000u
+#define OFF_TX_H_BUF            0x5000u
+#define OFF_TX_L_BD             0x4800u
+#define OFF_TX_L_BUF            0x8000u
+#define TX_SLOT_BUF             0x800u
+#define TX_BD_SIZE              40u
+#define TX_BD_CHUNK             144u            /* WCN36XX_BD_CHUNK_SIZE + 16 - (128 % 8) */
+#define BD_RATE_MGMT            2u
+#define BD_RATE_CTRL            3u
+#define TX_B_WQ_ID              0xAu
+#define TX_U_WQ_ID              0x9u
+#define BMU_WQ_TX               25u
+#define VD_TID                     7u
+
+#define CTRL_TX_H_BD            (C_VLD | C_XTYPE(XT_H2B) | C_DIQ | C_BTHLD(7) | C_PRIO(6) | C_SWAP | C_ENDIAN)
+#define CTRL_TX_H_SKB           (C_VLD | C_XTYPE(XT_H2B) | C_EOP | C_DIQ | C_BTHLD(7) | C_PRIO(6) | C_INT | C_SWAP | C_ENDIAN)
+#define DEF_CTL_TX_H            (CH_EN | C_XTYPE(XT_H2B) | CH_EOP | CH_DIQ | CH_PDU_REL | C_BTHLD(7) | C_PRIO(6) | \
+	                         CH_INE_ED | CH_INE_ERR | CH_INE_DONE | CH_EDEN | CH_EDVEN | CH_SEL(4) | CH_ENDIAN | CH_SWAP)
+#define CTRL_TX_L_BD            (C_VLD | C_XTYPE(XT_H2B) | C_DIQ | C_BTHLD(5) | C_PRIO(4) | C_SWAP | C_ENDIAN)
+#define CTRL_TX_L_SKB           (C_VLD | C_XTYPE(XT_H2B) | C_EOP | C_DIQ | C_BTHLD(5) | C_PRIO(4) | C_INT | C_SWAP | C_ENDIAN)
+#define DEF_CTL_TX_L            (CH_EN | C_XTYPE(XT_H2B) | CH_EOP | CH_DIQ | CH_PDU_REL | C_BTHLD(5) | C_PRIO(4) | \
+	                         CH_INE_ED | CH_INE_ERR | CH_INE_DONE | CH_EDEN | CH_EDVEN | CH_SEL(0) | CH_ENDIAN | CH_SWAP)
+
+struct vch {
+	volatile struct vdesc *d;
+	uint32_t n, head;
+	uint32_t dma;                   /* physical address of d[0] */
+};
+
+struct vtxq {
+	struct vch *c;
+	uint32_t reg, ctrl_bd, ctrl_skb, def_ctl, wq, bd_off, buf_off;
+};
+
+static vm_offset_t dxe_v, ccu_v, mem_v;
+static struct vch rx_l, rx_h, tx_l, tx_h;
+static bool s_ready;
+static struct vd_stats s_stats;
+static struct vd_bss s_bss[VD_MAX_BSS];
+static uint32_t s_nbss;
+static uint8_t s_filter[6];
+static bool s_filter_on;
+static struct vd_frame s_q[VD_Q_FRAMES];
+static uint32_t s_q_head, s_q_tail;     /* tail = next to pop */
+
+uint64_t
+vd_now_us(void)
+{
+	uint64_t t, ns;
+
+	clock_get_uptime(&t);
+	absolutetime_to_nanoseconds(t, &ns);
+	return ns / 1000;
+}
+
+static uint32_t
+drd(uint32_t off)
+{
+	return *(volatile uint32_t *)(dxe_v + off);
+}
+
+static void
+dwr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(dxe_v + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+cwr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(ccu_v + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static uint32_t
+vd_pa(const volatile void *p)
+{
+	return (uint32_t)(MEM_PA + ((vm_offset_t)p - mem_v));
+}
+
+static volatile uint8_t *
+vd_va(uint32_t pa)
+{
+	return (volatile uint8_t *)(mem_v + (pa - MEM_PA));
+}
+
+bool
+vd_ready(void)
+{
+	return s_ready;
+}
+
+bool
+vd_map(void)
+{
+	if (!dxe_v) {
+		dxe_v = ml_io_map(DXE_PA, 0x1000);
+	}
+	if (!ccu_v) {
+		ccu_v = ml_io_map(CCU_PA, 0x2000);
+	}
+	if (!mem_v) {
+		mem_v = ml_io_map(MEM_PA, MEM_END);
+	}
+	return dxe_v && ccu_v && mem_v;
+}
+
+/* ---- SMSM: the apps state word the firmware watches before it accepts frames ---- */
+
+int
+vd_smsm_rings_empty(void)
+{
+	uint32_t size = 0;
+	vm_offset_t a = vince_smd_item(SMEM_SMSM_SHARED_STATE, &size);
+	volatile uint32_t *w;
+	uint32_t v;
+
+	if (!a || size < 4 || (a & 3)) {
+		return -1;
+	}
+	w = (volatile uint32_t *)a;     /* entry 0 = apps */
+	v = *w;
+	v &= ~SMSM_TX_ENABLE;
+	v |= SMSM_TX_RINGS_EMPTY;
+	*w = v;
+	vince_smd_kick(APCS_IPC_WCNSS_SMSM);
+	return 0;
+}
+
+/* ---- channels ---- */
+
+static void
+ring_init(struct vch *c, uint32_t off, uint32_t n, uint32_t ctrl, uint32_t src, uint32_t dst, uint32_t buf_off)
+{
+	c->d = (volatile struct vdesc *)(mem_v + off);
+	c->dma = MEM_PA + off;
+	c->n = n;
+	c->head = 0;
+	for (uint32_t i = 0; i < n; i++) {
+		volatile struct vdesc *d = &c->d[i];
+
+		d->ctrl = ctrl;
+		d->fr_len = 0;
+		d->src_l = src;
+		d->dst_l = dst;
+		d->next_l = c->dma + ((i + 1) % n) * (uint32_t)sizeof(struct vdesc);
+		d->src_h = d->dst_h = d->next_h = 0;
+		if (buf_off) {
+			d->dst_l = MEM_PA + buf_off + i * BUF_STRIDE;
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+zero_mem(void)
+{
+	volatile uint64_t *p = (volatile uint64_t *)mem_v;
+
+	for (uint32_t i = 0; i < MEM_END / 8; i++) {
+		p[i] = 0;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+int
+vd_init(void)
+{
+	if (s_ready) {
+		return -1;      /* once per Pronto start */
+	}
+	if (!vd_map()) {
+		return -2;
+	}
+	zero_mem();
+	bzero(&s_stats, sizeof(s_stats));
+	s_nbss = 0;
+
+	dwr(REG_CSR_RESET, CSR_RESET_VALUE);
+	cwr(CCU_DXE_INT_SELECT_PRONTO, (CH3_MASK | CH1_MASK) << 16 | INT_TX_L | INT_TX_H);
+
+	ring_init(&tx_l, OFF_TX_L_DESC, N_TX_L, CTRL_TX_L, 0, WQ_TX_L, 0);
+	dwr(TX_L_OFF + CH_NEXT_DESC, tx_l.dma);
+	dwr(TX_L_OFF + CH_DEST_ADDR, WQ_TX_L);
+
+	ring_init(&tx_h, OFF_TX_H_DESC, N_TX_H, CTRL_TX_H, 0, WQ_TX_H, 0);
+	dwr(TX_H_OFF + CH_NEXT_DESC, tx_h.dma);
+	dwr(TX_H_OFF + CH_DEST_ADDR, WQ_TX_H);
+
+	ring_init(&rx_l, OFF_RX_L_DESC, N_RX_L, CTRL_RX_L, WQ_RX_L, 0, OFF_RX_L_BUF);
+	dwr(RX_L_OFF + CH_NEXT_DESC, rx_l.dma);
+	dwr(RX_L_OFF + CH_SRC_ADDR, WQ_RX_L);
+	dwr(RX_L_OFF + CH_DEST_ADDR, rx_l.d[0].next_l);         /* mainline programs the next descriptor's address here */
+	dwr(RX_L_OFF, DEF_CTL_RX_L);
+
+	ring_init(&rx_h, OFF_RX_H_DESC, N_RX_H, CTRL_RX_H, WQ_RX_H, 0, OFF_RX_H_BUF);
+	dwr(RX_H_OFF + CH_NEXT_DESC, rx_h.dma);
+	dwr(RX_H_OFF + CH_SRC_ADDR, WQ_RX_H);
+	dwr(RX_H_OFF + CH_DEST_ADDR, rx_h.d[0].next_l);
+	dwr(RX_H_OFF, DEF_CTL_RX_H);
+
+	dwr(REG_INT_MASK, drd(REG_INT_MASK) | INT_TX_L | INT_TX_H | INT_RX_L | INT_RX_H);
+	s_ready = true;
+	return 0;
+}
+
+/* ---- TX ---- */
+
+static void
+put_be32(volatile uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)(v >> 24);
+	p[1] = (uint8_t)(v >> 16);
+	p[2] = (uint8_t)(v >> 8);
+	p[3] = (uint8_t)v;
+}
+
+/*
+ * One frame = two descriptors (BD, frame). data: a data frame to the AP (BD rate class DATA, queue 0, no ACK
+ * override, header 24 bytes); otherwise a management frame (class MGMT or CTRL on 5 GHz, queue 0xA broadcast or 0x9
+ * unicast).
+ */
+static int
+tx_common(const struct vtxq *q, const struct vd_tx_ctx *ctx, const uint8_t *frame, uint32_t len, int bcast, int data)
+{
+	struct vch *c = q->c;
+	uint32_t i, slot, w0, w3, w4, w5, rate, queue;
+	volatile struct vdesc *dbd, *dfr;
+	volatile uint8_t *bd, *buf;
+	uint64_t t0;
+
+	if (!s_ready) {
+		return -1;
+	}
+	if (len < 24 || len > TX_SLOT_BUF) {
+		return -2;
+	}
+	/* a slot is free when both descriptors have been given back */
+	i = c->head;
+	dbd = &c->d[i];
+	dfr = &c->d[(i + 1) % c->n];
+	if ((dbd->ctrl | dfr->ctrl) & C_VLD) {
+		return -3;
+	}
+
+	slot = i / 2;
+	bd = (volatile uint8_t *)(mem_v + q->bd_off + slot * TX_BD_CHUNK);
+	buf = (volatile uint8_t *)(mem_v + q->buf_off + slot * TX_SLOT_BUF);
+
+	for (uint32_t k = 0; k < len; k++) {
+		buf[k] = frame[k];
+	}
+	for (uint32_t k = 0; k < TX_BD_SIZE; k++) {
+		bd[k] = 0;
+	}
+
+	/* BD, little-endian bitfields as the compiler lays out wcn36xx_tx_bd, then every word swapped to big-endian */
+	w0 = (ctx->no_encrypt ? 1u << 3 : 0) | (bcast ? 1u << 7 : 0) | BMU_WQ_TX << 24;
+	w0 |= (uint32_t)(ctx->dpu_sign & 7) << 21;
+	w3 = 24u << 24 | 40u << 16 | 64u << 7;                  /* mpdu_header_len 24, header_off 40, data_off 64 */
+	w4 = (data ? 0u : VD_TID << 8) | 1u << 12 | len << 16;     /* tid, bd_ssn = FILL_DPU_NON_QOS, mpdu_len */
+	rate = data ? 0u : (ctx->band_5ghz ? BD_RATE_CTRL : BD_RATE_MGMT);
+	queue = data ? 0u : (bcast ? TX_B_WQ_ID : TX_U_WQ_ID);
+	w5 = queue << 7 | rate << 12 | (bcast ? 1u << 14 : 0) | (uint32_t)ctx->sta_index << 16 |
+	    (uint32_t)ctx->dpu_desc_idx << 24;
+	put_be32(bd + 0x00, w0);
+	put_be32(bd + 0x0c, w3);
+	put_be32(bd + 0x10, w4);
+	put_be32(bd + 0x14, w5);
+	put_be32(bd + 0x18, 0xbdbdbdbd);                        /* tx_bd_sign */
+
+	dbd->src_l = vd_pa(bd);
+	dbd->dst_l = q->wq;
+	dbd->fr_len = TX_BD_SIZE;
+	dfr->src_l = vd_pa(buf);
+	dfr->dst_l = q->wq;
+	dfr->fr_len = len;
+	c->head = (i + 2) % c->n;
+
+	__asm__ volatile ("dsb sy" ::: "memory");
+	dfr->ctrl = q->ctrl_skb;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	dbd->ctrl = q->ctrl_bd;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	dwr(q->reg, q->def_ctl);                                /* kick the channel */
+
+	t0 = vd_now_us();
+	while (((dbd->ctrl | dfr->ctrl) & C_VLD) && vd_now_us() - t0 < 100000ULL) {
+		vince_smd_sleep(1);
+	}
+	return ((dbd->ctrl | dfr->ctrl) & C_VLD) ? -4 : 0;
+}
+
+int
+vd_tx_mgmt(const struct vd_tx_ctx *ctx, const uint8_t *frame, uint32_t len, int bcast)
+{
+	const struct vtxq q = { &tx_h, TX_H_OFF, CTRL_TX_H_BD, CTRL_TX_H_SKB, DEF_CTL_TX_H, WQ_TX_H, OFF_TX_H_BD,
+		                OFF_TX_H_BUF };
+	struct vd_tx_ctx m = *ctx;
+
+	m.no_encrypt = 1;       /* management frames before the keys exist are never encrypted */
+	return tx_common(&q, &m, frame, len, bcast, 0);
+}
+
+int
+vd_tx_data(const struct vd_tx_ctx *ctx, const uint8_t *frame, uint32_t len)
+{
+	const struct vtxq q = { &tx_l, TX_L_OFF, CTRL_TX_L_BD, CTRL_TX_L_SKB, DEF_CTL_TX_L, WQ_TX_L, OFF_TX_L_BD,
+		                OFF_TX_L_BUF };
+
+	return tx_common(&q, ctx, frame, len, 0, 1);
+}
+
+/* ---- RX ---- */
+
+static uint32_t
+bswap32(uint32_t v)
+{
+	return v >> 24 | (v >> 8 & 0xff00) | (v << 8 & 0xff0000) | v << 24;
+}
+
+/* RX BD words are big-endian in memory (mainline buff_to_be) */
+static uint32_t
+bd_word(const volatile uint8_t *buf, uint32_t off)
+{
+	return bswap32(*(const volatile uint32_t *)(const volatile void *)(buf + off));
+}
+
+void
+vd_set_filter_mac(const uint8_t mac[6])
+{
+	s_filter_on = false;
+	if (!mac) {
+		return;
+	}
+	for (int i = 0; i < 6; i++) {
+		s_filter[i] = mac[i];
+	}
+	s_filter_on = true;
+}
+
+void
+vd_flush_frames(void)
+{
+	s_q_head = s_q_tail = 0;
+}
+
+int
+vd_pop_frame(struct vd_frame *out)
+{
+	const struct vd_frame *f;
+
+	if (s_q_head == s_q_tail) {
+		return 0;
+	}
+	f = &s_q[s_q_tail % VD_Q_FRAMES];
+	out->len = f->len;
+	out->ch = f->ch;
+	out->rssi = f->rssi;
+	for (uint32_t i = 0; i < f->len; i++) {
+		out->data[i] = f->data[i];
+	}
+	s_q_tail++;
+	return 1;
+}
+
+static void
+push_frame(const uint8_t *f, uint32_t n, uint32_t hwch, int rssi)
+{
+	struct vd_frame *q;
+
+	if (s_q_head - s_q_tail >= VD_Q_FRAMES) {
+		s_q_tail++;     /* drop the oldest */
+	}
+	q = &s_q[s_q_head % VD_Q_FRAMES];
+	q->len = (uint16_t)n;
+	q->ch = (uint8_t)hwch;
+	q->rssi = (int8_t)rssi;
+	for (uint32_t i = 0; i < n; i++) {
+		q->data[i] = f[i];
+	}
+	s_q_head++;
+}
+
+static void
+note_frame(const volatile uint8_t *buf, uint32_t hdr_off, uint32_t len, uint32_t hwch, int rssi)
+{
+	uint8_t f[VD_Q_FRAME_MAX];
+	uint32_t n = len < sizeof(f) ? len : (uint32_t)sizeof(f);
+	uint32_t fc, type, sub;
+	bool is_beacon;
+	const uint8_t *bssid;
+	char ssid[33];
+	uint32_t ch = 0, dtim = 0, nrates = 0, rsn_len = 0, bint, capab;
+	uint8_t rates[16], rsn[48];
+	struct vd_bss *b;
+
+	for (uint32_t i = 0; i < n; i++) {
+		f[i] = buf[hdr_off + i];
+	}
+	if (n < 24) {
+		return;
+	}
+	fc = f[0] | (uint32_t)f[1] << 8;
+	type = fc >> 2 & 3;
+	sub = fc >> 4 & 15;
+	is_beacon = type == 0 && (sub == 8 || sub == 5);
+
+	if (!is_beacon) {
+		if (type == 2) {
+			int us = 1, bc = 1;
+
+			for (int k = 0; k < 6; k++) {
+				us &= f[4 + k] == s_filter[k];
+				bc &= f[4 + k] == 0xff;
+			}
+			s_stats.data_frames++;
+			if (s_filter_on && us) {
+				s_stats.data_for_us++;
+				if (!s_stats.first_data_us) {
+					s_stats.first_data_us = vd_now_us();
+				}
+			}
+			if (bc) {
+				s_stats.data_bcast++;
+			}
+		} else if (type == 0 && s_filter_on) {
+			int us = 1;
+
+			for (int k = 0; k < 6; k++) {
+				us &= f[4 + k] == s_filter[k];
+			}
+			if (us) {
+				s_stats.mgmt_for_us++;
+			}
+		}
+		/* frames for us (unicast to the filter MAC) go to the queue */
+		if (s_filter_on) {
+			int mine = 1, bcast = 1;
+
+			for (int k = 0; k < 6; k++) {
+				mine &= f[4 + k] == s_filter[k];
+				bcast &= f[4 + k] == 0xff;
+			}
+			if (mine || (bcast && type == 2)) {
+				push_frame(f, n, hwch, rssi);
+			}
+		}
+		return;
+	}
+	if (n < 24 + 12) {
+		return;
+	}
+	bssid = f + 16;
+	bzero(ssid, sizeof(ssid));
+	bint = f[32] | (uint32_t)f[33] << 8;
+	capab = f[34] | (uint32_t)f[35] << 8;
+
+	for (uint32_t p = 24 + 12; p + 2 <= n;) {               /* IEs after the 12 fixed bytes */
+		uint32_t id = f[p], l = f[p + 1];
+
+		if (p + 2 + l > n) {
+			break;
+		}
+		if (id == 0 && l <= 32) {
+			for (uint32_t i = 0; i < l; i++) {
+				ssid[i] = (f[p + 2 + i] >= 0x20 && f[p + 2 + i] < 0x7f) ? (char)f[p + 2 + i] : '.';
+			}
+		} else if (id == 3 && l == 1) {
+			ch = f[p + 2];                          /* DS parameter set: the AP's channel */
+		} else if (id == 5 && l >= 2) {
+			dtim = f[p + 3];                        /* TIM: DTIM count, DTIM period, ... */
+		} else if (id == 48 && l <= sizeof(rsn)) {
+			rsn_len = l;
+			for (uint32_t i = 0; i < l; i++) {
+				rsn[i] = f[p + 2 + i];
+			}
+		} else if ((id == 1 || id == 50) && nrates < sizeof(rates)) {
+			for (uint32_t i = 0; i < l && nrates < sizeof(rates); i++) {
+				rates[nrates++] = f[p + 2 + i];
+			}
+		}
+		p += 2 + l;
+	}
+	for (uint32_t i = 0; i < s_nbss; i++) {
+		uint32_t same = 1;
+
+		for (int k = 0; k < 6; k++) {
+			same &= s_bss[i].bssid[k] == bssid[k];
+		}
+		if (same) {
+			if (s_bss[i].count < 0xffff) {
+				s_bss[i].count++;
+			}
+			s_bss[i].rssi = (int8_t)rssi;
+			if (!s_bss[i].dtim_period && dtim) {
+				s_bss[i].dtim_period = (uint8_t)dtim;
+			}
+			return;
+		}
+	}
+	if (s_nbss == VD_MAX_BSS) {
+		return;
+	}
+	b = &s_bss[s_nbss++];
+	for (int k = 0; k < 6; k++) {
+		b->bssid[k] = bssid[k];
+	}
+	for (int k = 0; k < 33; k++) {
+		b->ssid[k] = ssid[k];
+	}
+	b->ch = (uint8_t)(ch ? ch : hwch);
+	b->rssi = (int8_t)rssi;
+	b->count = 1;
+	b->beacon_int = (uint16_t)bint;
+	b->capab = (uint16_t)capab;
+	b->dtim_period = (uint8_t)dtim;
+	b->nrates = (uint8_t)nrates;
+	for (uint32_t k = 0; k < nrates; k++) {
+		b->rates[k] = rates[k];
+	}
+	b->rsn_len = (uint8_t)rsn_len;
+	for (uint32_t k = 0; k < rsn_len; k++) {
+		b->rsn[k] = rsn[k];
+	}
+}
+
+static void
+rx_channel(struct vch *c, uint32_t ctrl, uint32_t en_mask, uint32_t int_mask, uint32_t status_reg, uint32_t *frames)
+{
+	uint32_t reason = drd(status_reg);
+
+	dwr(REG_INT_CLR, int_mask);
+	if (reason & STAT_ERR) {
+		dwr(REG_INT_ERR_CLR, int_mask);
+		s_stats.errors++;
+	}
+	if (reason & STAT_DONE) {
+		dwr(REG_INT_DONE_CLR, int_mask);
+	}
+	if (reason & STAT_ED) {
+		dwr(REG_INT_ED_CLR, int_mask);
+	}
+	if (!(reason & (STAT_DONE | STAT_ED))) {
+		return;
+	}
+
+	for (uint32_t guard = 0; guard < c->n; guard++) {
+		volatile struct vdesc *d = &c->d[c->head];
+		volatile uint8_t *buf;
+		uint32_t w0, w2, w3, wphy0, hdr_off, data_off, hdr_len, mlen;
+
+		if (d->ctrl & C_VLD) {
+			break;
+		}
+		__asm__ volatile ("dmb sy" ::: "memory");
+		buf = vd_va(d->dst_l);
+		w0 = bd_word(buf, 0x00);
+		w2 = bd_word(buf, 0x0c);        /* pdu_count:7 mpdu_data_off:9 mpdu_header_off:8 mpdu_header_len:8 */
+		w3 = bd_word(buf, 0x10);        /* ... mpdu_len:16 in the high half */
+		wphy0 = bd_word(buf, 0x1c);     /* phy_stat0 */
+		hdr_off = w2 >> 16 & 0xff;
+		data_off = w2 >> 7 & 0x1ff;
+		hdr_len = w2 >> 24 & 0xff;
+		mlen = w3 >> 16;
+		if (data_off <= hdr_off || mlen < hdr_len || hdr_off < 0x20 || hdr_off + mlen > PKT_SIZE) {
+			s_stats.bad_bd++;
+		} else {
+			uint32_t hwch = (w0 >> 11 & 1) << 4 | (w0 >> 13 & 0xf);
+			int rssi = -(100 - (int)(wphy0 >> 24 & 0xff));
+
+			note_frame(buf, hdr_off, mlen, hwch, rssi);
+		}
+		(*frames)++;
+		d->ctrl = ctrl;                 /* give it back to the hardware */
+		__asm__ volatile ("dsb sy" ::: "memory");
+		c->head = (c->head + 1) % c->n;
+	}
+	dwr(REG_ENCH_ADDR, en_mask);
+}
+
+void
+vd_poll(uint32_t ms)
+{
+	uint64_t t0 = vd_now_us();
+
+	if (!s_ready) {
+		return;
+	}
+	do {
+		uint32_t src = drd(REG_INT_SRC_RAW);
+
+		s_stats.last_int_src = src;
+		if (src & CH1_MASK) {
+			rx_channel(&rx_l, CTRL_RX_L, CH1_MASK, INT_RX_L, RX_L_OFF + CH_STATUS, &s_stats.frames_l);
+		}
+		if (src & CH3_MASK) {
+			rx_channel(&rx_h, CTRL_RX_H, CH3_MASK, INT_RX_H, RX_H_OFF + CH_STATUS, &s_stats.frames_h);
+		}
+		if (ms) {
+			vince_smd_sleep(1);
+		}
+	} while (vd_now_us() - t0 < (uint64_t)ms * 1000ULL);
+	s_stats.status_rx_l = drd(RX_L_OFF + CH_STATUS);
+	s_stats.status_rx_h = drd(RX_H_OFF + CH_STATUS);
+}
+
+const struct vd_bss *
+vd_bss_list(uint32_t *n)
+{
+	*n = s_nbss;
+	return s_bss;
+}
+
+void
+vd_bss_clear(void)
+{
+	s_nbss = 0;
+}
+
+void
+vd_get_stats(struct vd_stats *s)
+{
+	*s = s_stats;
+}
+#endif /* ARM64_BOARD_CONFIG_VINCE */
