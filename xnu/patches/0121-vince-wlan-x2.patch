+/* request with a body; the answer is copied to rsp (up to max); its length or <0 */
+int
+vw_raw(uint16_t type, const void *body, uint32_t blen, void *rsp, uint32_t max)
+{
+	const uint8_t *b = body;
+	uint8_t *o = rsp;
+	int n;
+
+	if (blen > HAL_BUF - 8) {
+		return -9;
+	}
+	vw_hdr(vw_req, type, 8 + blen);
+	for (uint32_t i = 0; i < blen; i++) {
+		vw_req[8 + i] = b[i];
+	}
+	n = vw_xfer(8 + blen, (uint32_t)(type + 1));
+	if (n > 0) {
+		for (uint32_t i = 0; i < (uint32_t)n && i < max; i++) {
+			o[i] = vw_rsp[i];
+		}
+	}
+	return n;
+}
+
+/* request whose answer starts with a u32 status after the header; 0 when the firmware says success */
+static int
+vw_cmd(uint16_t type, const void *body, uint32_t blen)
+{
+	uint8_t rsp[64];
+	int n = vw_raw(type, body, blen, rsp, sizeof(rsp));
+
+	if (n < 12) {
+		return n < 0 ? n : -6;
+	}
+	return vw_get32(rsp + 8) ? -7 : 0;
+}
