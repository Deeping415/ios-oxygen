+		    b[i].bssid[0], b[i].bssid[1], b[i].bssid[2], b[i].bssid[3], b[i].bssid[4], b[i].bssid[5],
+		    b[i].ch, b[i].rssi, b[i].count, b[i].rsn_len, b[i].ssid);
+	}
+	vd_get_stats(&st);
+	printf("VINCE WLAN: dxe rx_l %u rx_h %u bad_bd %u errors %u\n", st.frames_l, st.frames_h, st.bad_bd, st.errors);
