+/* broadcast probe request, wildcard SSID, 2.4 GHz rates; returns the length */
+static uint32_t
+vw_probe_req(uint8_t *f, const uint8_t *mac)
+{
+	static const uint8_t ies[] = {
+		0x00, 0x00,                                                     /* SSID: wildcard */
+		0x01, 0x04, 0x82, 0x84, 0x8b, 0x96,                             /* 1, 2, 5.5, 11 Mbit/s (basic) */
+		0x32, 0x08, 0x0c, 0x12, 0x18, 0x24, 0x30, 0x48, 0x60, 0x6c,     /* 6..54 Mbit/s */
+	};
+	uint32_t n = 0;
+
+	f[n++] = 0x40;                  /* frame control: management, probe request */
+	f[n++] = 0x00;
+	f[n++] = 0;                     /* duration */
+	f[n++] = 0;
+	for (int i = 0; i < 6; i++) {
+		f[n++] = 0xff;          /* DA */
+	}
+	for (int i = 0; i < 6; i++) {
+		f[n++] = mac[i];        /* SA */
+	}
+	for (int i = 0; i < 6; i++) {
+		f[n++] = 0xff;          /* BSSID */
+	}
+	f[n++] = 0;                     /* sequence control, filled by the DPU */
+	f[n++] = 0;
+	for (uint32_t i = 0; i < sizeof(ies); i++) {
+		f[n++] = ies[i];
+	}
+	return n;
+}
