+/* X2: DXE up, self station, active scan of channels 1..13 (120 ms each, two probe requests at the start) */
+static int
+vw_scan_all(void)
+{
+	struct vd_tx_ctx ctx;
+	uint8_t self[3], pr[64];
+	uint32_t prlen;
+	uint64_t c;
+	int r, probes = 2;
+
+	__asm__ volatile ("mrs %0, cntvct_el0" : "=r"(c));
+	vw_mac[5] = (uint8_t)(c ^ c >> 8 ^ c >> 16);    /* a new station address per Pronto start (shim wlan.c) */
+
+	r = vd_init();
+	printf("VINCE WLAN: dxe init %d\n", r);
+	if (r) {
+		return r;
+	}
+	r = vw_add_sta_self(vw_mac, self);
+	if (r) {
+		printf("VINCE WLAN: ADD_STA_SELF failed %d\n", r);
+		return r;
+	}
+	printf("VINCE WLAN: self %02x:%02x:%02x:%02x:%02x:%02x sta %u dpu %u/%u\n", vw_mac[0], vw_mac[1], vw_mac[2],
+	    vw_mac[3], vw_mac[4], vw_mac[5], self[0], self[1], self[2]);
+	ctx.sta_index = self[0];
+	ctx.dpu_desc_idx = self[1];
+	ctx.dpu_sign = self[2];
+	ctx.band_5ghz = 0;
+	ctx.no_encrypt = 1;
+	prlen = vw_probe_req(pr, vw_mac);
+	vd_bss_clear();
+	r = vw_scan_init();
+	if (r) {
+		printf("VINCE WLAN: INIT_SCAN failed %d\n", r);
+		return r;
+	}
+	for (uint8_t ch = 1; ch <= 13; ch++) {
+		if (vw_scan_start(ch)) {
+			printf("VINCE WLAN: START_SCAN failed on channel %u\n", ch);
+			break;
+		}
+		for (int k = 0; k < probes; k++) {
+			r = vd_tx_mgmt(&ctx, pr, prlen, 1);
+			if (r) {
