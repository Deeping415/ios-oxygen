+/*
+ * VINCE Wi-Fi driver internals (vince_wlan.c: HAL client, vince_wlan_dxe.c: DXE). Ports of the shim files
+ * vince-bringup/shim/{wlan,dxe}.c, proven on the phone first.
+ */
+#ifndef _VINCE_WLAN_H_
+#define _VINCE_WLAN_H_
+#if defined(ARM64_BOARD_CONFIG_VINCE)
+#include <stdint.h>
+#include <stdbool.h>
+
+#define VD_MAX_BSS              96
+#define VD_Q_FRAMES             16
+#define VD_Q_FRAME_MAX          512
+
+struct vd_bss {
+	uint8_t bssid[6];
+	uint8_t ch;                     /* channel the firmware reports, 0 if unknown */
+	int8_t rssi;                    /* dBm, from the RX BD */
+	uint16_t count;                 /* beacons / probe responses seen */
+	char ssid[33];
+	uint16_t beacon_int, capab;
+	uint8_t dtim_period;            /* from the TIM element, 0 if not seen */
+	uint8_t nrates;
+	uint8_t rates[16];              /* supported + extended rates, 500 kbit/s units, basic bit kept */
+	uint8_t rsn_len;                /* RSN element body (id 48), 0 if the beacon has none */
+	uint8_t rsn[48];
+};
+
+struct vd_frame {
+	uint16_t len;                   /* 802.11 frame, header first, no FCS */
+	uint8_t ch;
+	int8_t rssi;
+	uint8_t data[VD_Q_FRAME_MAX];
+};
+
+struct vd_stats {
+	uint32_t frames_l, frames_h;    /* RX frames handled on the low / high channel */
+	uint32_t bad_bd;                /* frames whose BD did not parse */
+	uint32_t errors;                /* DXE error status seen */
+	uint32_t last_int_src;
+	uint32_t status_rx_l, status_rx_h;
+	uint64_t first_data_us;         /* time of the first data frame for us (0 = none) */
+	uint32_t data_frames, data_for_us, data_bcast, mgmt_for_us;
+};
+
+/* what a frame needs from the firmware's station (ADD_STA_SELF / CONFIG_STA answers) */
+struct vd_tx_ctx {
+	uint8_t sta_index, dpu_desc_idx, dpu_sign;
+	int band_5ghz;                  /* management rate class: 5 GHz uses the control rate */
+	int no_encrypt;                 /* DPU: do not encrypt (open network, or management frames) */
+};
+
+bool vd_map(void);                                      /* DXE, CCU and the descriptor window mapped; false on failure */
+int vd_smsm_rings_empty(void);                          /* apps SMSM bit 9 = 1, bit 10 = 0; 0 ok */
+int vd_init(void);                                      /* reset, CCU select, four channels, interrupt mask; once per Pronto start */
+bool vd_ready(void);
+void vd_poll(uint32_t ms);                              /* handle RX frames for ms milliseconds (sleeps 1 ms between passes) */
