 		return in.state == VUI_S_RUN || !get ? 0 : ENXIO;
 	case A80211_SSID:
 		if (get) {
-			if (in.state != VUI_S_RUN || len < 40) {
+			if (in.state != VUI_S_RUN || len < 32) {
