+				bcopy(in.ssid, kb, in.ssid_len);
+			} else {
+				a80211_put32(kb, 0, 1);
+				a80211_put32(kb, 4, in.ssid_len);
+				bcopy(in.ssid, kb + 8, in.ssid_len);
+			}
 		}
 		return 0;
