diff --git a/bsd/dev/vince_pmic.c b/bsd/dev/vince_pmic.c
new file mode 100644
index 0000000..07fccc0
--- /dev/null
+++ b/bsd/dev/vince_pmic.c
@@ -0,0 +1,217 @@
+/*
+ * VINCE PMIC reads over the SPMI arbiter, for the battery service (iokit/Kernel/arm/SweetBattery.cpp).
+ * A port of the read path of vince-bringup/shim/spmi.c (measured on the phone: PMIC_ARB_VERSION 0x20010000). Reads go
+ * through the observer channels, which are read only, so nothing here can change a PMIC register. PPID = SID << 8 |
+ * peripheral page: PMI8950 (SID 2) has the SMBCHG charger at 0x210..0x216 and the fuel gauge at 0x240..0x244.
+ */
+#if defined(ARM64_BOARD_CONFIG_VINCE)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define ARB_CORE        0x0200F000u
+#define ARB_CNFG        0x0200A000u
+#define ARB_OBSRVR      0x02C00000u
+#define CMD             0x00u
+#define STATUS          0x08u
+#define RDATA0          0x18u
+#define OP_EXT_READL    1u
+
+static vm_offset_t pmic_core, pmic_cnfg;
+static struct {
+	unsigned ppid;
+	vm_offset_t chan;
+} pmic_chan[8];
+static unsigned pmic_nchan;
+static lck_grp_t *pmic_grp;
+static lck_mtx_t *pmic_lock;
+
+int
+vince_pmic_init(void)
+{
+	if (pmic_lock) {
+		return 0;
+	}
+	pmic_core = ml_io_map(ARB_CORE, 0x1000);
+	pmic_cnfg = ml_io_map(ARB_CNFG, 0x1000);
+	if (!pmic_core || !pmic_cnfg) {
+		return -1;
+	}
+	pmic_grp = lck_grp_alloc_init("vince_pmic", LCK_GRP_ATTR_NULL);
+	pmic_lock = lck_mtx_alloc_init(pmic_grp, LCK_ATTR_NULL);
+	return 0;
+}
+
+static vm_offset_t
+pmic_channel(unsigned ppid)
+{
+	for (unsigned i = 0; i < pmic_nchan; i++) {
+		if (pmic_chan[i].ppid == ppid) {
+			return pmic_chan[i].chan;
+		}
+	}
+	if (pmic_nchan >= sizeof(pmic_chan) / sizeof(pmic_chan[0])) {
+		return 0;
+	}
+	for (unsigned apid = 0; apid < 256; apid++) {
+		uint32_t v = *(volatile uint32_t *)(pmic_core + 0x800 + 4 * apid);
+
+		if (v && ((v >> 8) & 0xFFF) == ppid) {
+			vm_offset_t c = ml_io_map(ARB_OBSRVR + 0x8000u * apid, 0x1000);
+
+			if (c) {
+				pmic_chan[pmic_nchan].ppid = ppid;
+				pmic_chan[pmic_nchan].chan = c;
+				pmic_nchan++;
+			}
+			return c;
+		}
+	}
+	return 0;
+}
+
+/* 0 ok; <0 no such peripheral or the read failed */
+int
+vince_pmic_read(unsigned ppid, unsigned reg, uint8_t *val)
+{
+	vm_offset_t c;
+	int r = -100;
+
+	if (!pmic_lock) {
+		return -2;
+	}
+	lck_mtx_lock(pmic_lock);
+	c = pmic_channel(ppid);
+	if (!c) {
+		lck_mtx_unlock(pmic_lock);
+		return -1;
+	}
+	*(volatile uint32_t *)(c + CMD) = OP_EXT_READL << 27 | (reg & 0xFFu) << 4;
+	for (int i = 0; i < 10000; i++) {
+		uint32_t s = *(volatile uint32_t *)(c + STATUS);
+
+		if (s & 0xE) {
+			r = -(int)s;
+			break;
+		}
+		if (s & 1) {
+			*val = (uint8_t)*(volatile uint32_t *)(c + RDATA0);
+			r = 0;
+			break;
+		}
+		delay(1);
+	}
+	lck_mtx_unlock(pmic_lock);
+	return r;
+}
+
+/*
+ * Wall clock. The PM8953 RTC (PPID 0x060) is owned by another execution environment: it only counts seconds since its
+ * own reset, Android keeps the real date as an offset elsewhere. Reads are fine (observer channel); writes from the
+ * apps are not allowed. What the apps do own is the alarm peripheral (PPID 0x061, EE 0): while the alarm stays disabled
+ * (CTRL1 bit 7 clear) its 32-bit time register 0x40..0x43 is a free battery-backed word, used to keep the offset
+ * "unix time - RTC seconds" across reboots. Only those four registers can be written, and only if the owner is EE 0.
+ */
+#define RTC_PPID        0x060u
+#define ALARM_PPID      0x061u
+#define ALARM_RW        0x40u
+#define ALARM_CTRL1     0x46u
+#define ARB_CHNLS       0x02400000u
+#define WDATA0          0x10u
+#define OP_EXT_WRITEL   0u
+
+/* 0 ok; the 32-bit seconds counter, read twice until two reads agree */
+int
+vince_pmic_rtc_seconds(uint32_t *out)
+{
+	uint32_t prev = 0;
+
+	for (int attempt = 0; attempt < 4; attempt++) {
+		uint8_t b[4];
+		uint32_t v;
+
+		for (unsigned i = 0; i < 4; i++) {
+			if (vince_pmic_read(RTC_PPID, 0x48 + i, &b[i])) {
+				return -1;
+			}
+		}
+		v = b[0] | (uint32_t)b[1] << 8 | (uint32_t)b[2] << 16 | (uint32_t)b[3] << 24;
+		if (attempt && v == prev) {
+			*out = v;
+			return 0;
+		}
+		prev = v;
+	}
+	return -2;
+}
+
+int
+vince_pmic_load_offset(uint32_t *out)
+{
+	uint8_t b[4], ctrl;
+
+	if (vince_pmic_read(ALARM_PPID, ALARM_CTRL1, &ctrl) || (ctrl & 0x80)) {
+		return -1;      /* the alarm is armed: not ours */
+	}
+	for (unsigned i = 0; i < 4; i++) {
+		if (vince_pmic_read(ALARM_PPID, ALARM_RW + i, &b[i])) {
+			return -2;
+		}
+	}
+	*out = b[0] | (uint32_t)b[1] << 8 | (uint32_t)b[2] << 16 | (uint32_t)b[3] << 24;
+	return 0;
+}
+
+int
+vince_pmic_store_offset(uint32_t v)
+{
+	uint8_t ctrl;
+	unsigned apid;
+	vm_offset_t chan;
+	int r = 0;
+
+	if (!pmic_lock || vince_pmic_read(ALARM_PPID, ALARM_CTRL1, &ctrl) || (ctrl & 0x80)) {
+		return -1;
+	}
+	lck_mtx_lock(pmic_lock);
+	for (apid = 0; apid < 256; apid++) {
+		uint32_t m = *(volatile uint32_t *)(pmic_core + 0x800 + 4 * apid);
+
+		if (m && ((m >> 8) & 0xFFF) == ALARM_PPID) {
+			break;
+		}
+	}
+	if (apid == 256 || (*(volatile uint32_t *)(pmic_cnfg + 0x700 + 4 * apid) & 7) != 0) {
+		lck_mtx_unlock(pmic_lock);
+		return -2;      /* not found, or not owned by the apps */
+	}
+	chan = ml_io_map(ARB_CHNLS + 0x8000u * apid, 0x1000);
+	if (!chan) {
+		lck_mtx_unlock(pmic_lock);
+		return -3;
+	}
+	for (unsigned i = 0; i < 4 && !r; i++) {
+		*(volatile uint32_t *)(chan + WDATA0) = (v >> (8 * i)) & 0xFF;
+		*(volatile uint32_t *)(chan + CMD) = OP_EXT_WRITEL << 27 | (ALARM_RW + i) << 4;
+		r = -100;
+		for (int k = 0; k < 10000; k++) {
+			uint32_t s = *(volatile uint32_t *)(chan + STATUS);
+
+			if (s & 0xE) {
+				r = -(int)s;
+				break;
+			}
+			if (s & 1) {
+				r = 0;
+				break;
+			}
+			delay(1);
+		}
+	}
+	lck_mtx_unlock(pmic_lock);
+	return r;
+}
+#endif /* ARM64_BOARD_CONFIG_VINCE */
