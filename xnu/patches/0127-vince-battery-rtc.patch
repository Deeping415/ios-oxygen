 OSDefineMetaClassAndStructors(SweetPlatformExpert, IODTPlatformExpert);
 
+
+#if defined(ARM64_BOARD_CONFIG_VINCE)
+/*
+ * Wall clock on VINCE: PMIC RTC seconds + a persisted offset (see bsd/dev/vince_pmic.c). With no valid offset the
+ * clock starts at the build time of this kernel (parsed from __DATE__ / __TIME__, built on a UTC machine), so that
+ * dates are never 1970; timed corrects it from the network and the new offset is stored.
+ */
+extern "C" int vince_pmic_init(void);
+extern "C" int vince_pmic_rtc_seconds(uint32_t *out);
+extern "C" int vince_pmic_load_offset(uint32_t *out);
+extern "C" int vince_pmic_store_offset(uint32_t v);
+
+static bool vince_rtc_ready;
+static bool vince_rtc_ok;
+static uint32_t vince_rtc_offset;
+
+static long
+vince_build_epoch(void)
+{
+	static const char *const months = "JanFebMarAprMayJunJulAugSepOctNovDec";
+	const char *d = __DATE__;     /* "Oct 25 2026" */
+	const char *t = __TIME__;     /* "02:39:19" */
+	int m = 0, day, year, hh, mm, ss;
+
+	for (int i = 0; i < 12; i++) {
+		if (d[0] == months[3 * i] && d[1] == months[3 * i + 1] && d[2] == months[3 * i + 2]) {
+			m = i + 1;
+		}
+	}
+	day = (d[4] == ' ' ? 0 : d[4] - '0') * 10 + (d[5] - '0');
+	year = (d[7] - '0') * 1000 + (d[8] - '0') * 100 + (d[9] - '0') * 10 + (d[10] - '0');
+	hh = (t[0] - '0') * 10 + (t[1] - '0');
+	mm = (t[3] - '0') * 10 + (t[4] - '0');
+	ss = (t[6] - '0') * 10 + (t[7] - '0');
+	/* days from 1970-01-01 (civil date algorithm) */
+	int y = year - (m <= 2);
+	int era = y / 400;
+	int yoe = y - era * 400;
+	int doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + day - 1;
+	int doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+	long days = (long)era * 146097 + doe - 719468;
+
+	return days * 86400 + hh * 3600 + mm * 60 + ss;
+}
+
+static void
+vince_rtc_setup(void)
+{
+	uint32_t sec = 0, off = 0;
+	long build = vince_build_epoch();
+
+	if (vince_rtc_ready) {
+		return;
+	}
+	vince_rtc_ready = true;
+	if (vince_pmic_init() == 0 && vince_pmic_rtc_seconds(&sec) == 0) {
+		vince_rtc_ok = true;
+		/* a stored offset is believed when it puts the clock between the build time and ten years later */
+		if (vince_pmic_load_offset(&off) == 0 && (long)off + sec >= build - 86400 && (long)off + sec < build + 315360000L) {
+			vince_rtc_offset = off;
+			IOLog("VINCE RTC: stored offset %u, clock %ld\n", off, (long)off + sec);
+		} else {
+			vince_rtc_offset = (uint32_t)(build - (long)sec);
+			IOLog("VINCE RTC: no valid stored offset, starting at the build time %ld\n", build);
+		}
+	} else {
+		IOLog("VINCE RTC: PMIC RTC unreadable, clock fixed at the build time\n");
+		vince_rtc_offset = (uint32_t)build;
+	}
+}
+
+long
+SweetPlatformExpert::getGMTTimeOfDay(void)
+{
+	uint32_t sec = 0;
+
+	vince_rtc_setup();
+	if (vince_rtc_ok && vince_pmic_rtc_seconds(&sec) == 0) {
+		return (long)vince_rtc_offset + (long)sec;
+	}
+	return (long)vince_rtc_offset;
+}
+
+void
+SweetPlatformExpert::setGMTTimeOfDay(long secs)
+{
+	uint32_t sec = 0;
+
+	vince_rtc_setup();
+	if (!vince_rtc_ok || vince_pmic_rtc_seconds(&sec) != 0) {
+		vince_rtc_offset = (uint32_t)secs;
+		return;
+	}
+	vince_rtc_offset = (uint32_t)(secs - (long)sec);
+	IOLog("VINCE RTC: clock set to %ld, offset %u stored: %d\n", secs, vince_rtc_offset,
+	    vince_pmic_store_offset(vince_rtc_offset));
+}
+#endif /* ARM64_BOARD_CONFIG_VINCE */
+
 bool
 SweetPlatformExpert::start(IOService *provider)
 {
@@ -30,6 +133,9 @@ SweetPlatformExpert::start(IOService *provider)
 		return false;
 	}
 	registerService();
+#if defined(ARM64_BOARD_CONFIG_VINCE)
