+void
+sweet_early_puts(const char *s)
+{
+	sweet_early_string(s);
+}
+
+void
+sweet_early_hex(uint64_t val)
+{
+	static const char hexchars[] = "0123456789abcdef";
+	for (int i = 60; i >= 0; i -= 4) {
+		sweet_early_putc(hexchars[(val >> i) & 0xf]);
+	}
+}
+
+void
+vince_early_exception(uint64_t esr, uint64_t far, uint64_t elr)
+{
+	sweet_early_string("\n*** CPU TRAP ***\nESR: 0x");
+	sweet_early_hex(esr);
+	sweet_early_string("\nFAR: 0x");
+	sweet_early_hex(far);
+	sweet_early_string("\nELR: 0x");
+	sweet_early_hex(elr);
+	sweet_early_putc('\n');
+	__asm__ volatile("dsb sy" ::: "memory");
+}
