+/* ---- firmware crash detection and Pronto restart (shim mailbox, see shim monitor.c) ---- */
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define MBX_PA          0x47440000u
+#define MBX_MAGIC       0x584d4257u
+#define CRASH_ITEM      422u            /* SMEM_SSR_REASON_WCNSS0 */
+
+struct vw_mbx {
+	volatile uint32_t magic, req, done, result, beat, restarts;
+};
+static volatile struct vw_mbx *vw_mbx;
+static uint8_t vw_crash0[16];
+static bool vw_crash0_ok;
+
+static void
+vw_crash_baseline(void)
+{
+	uint32_t sz = 0;
+	vm_offset_t a = vince_smd_item(CRASH_ITEM, &sz);
+
+	vw_crash0_ok = false;
+	if (a && sz >= sizeof(vw_crash0)) {
+		for (unsigned i = 0; i < sizeof(vw_crash0); i++) {
+			vw_crash0[i] = ((volatile uint8_t *)a)[i];
+		}
+		vw_crash0_ok = true;
+	}
+}
+
+/* the firmware's ERR_FATAL handler overwrites the "SSR Init" text with the failing file, line and reason */
+bool
+vw_fw_crashed(void)
+{
+	uint32_t sz = 0;
+	vm_offset_t a;
+
+	if (!vw_crash0_ok) {
+		return false;
+	}
+	a = vince_smd_item(CRASH_ITEM, &sz);
+	if (!a || sz < sizeof(vw_crash0)) {
+		return false;
+	}
+	for (unsigned i = 0; i < sizeof(vw_crash0); i++) {
+		if (((volatile uint8_t *)a)[i] != vw_crash0[i]) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static void
+vw_crash_log(void)
+{
+	uint32_t sz = 0;
+	vm_offset_t a = vince_smd_item(CRASH_ITEM, &sz);
+	char t[81];
+
+	if (!a) {
+		return;
+	}
+	for (unsigned i = 0; i < 80 && i < sz; i++) {
+		uint8_t b = ((volatile uint8_t *)a)[i];
+
+		t[i] = (b >= 0x20 && b < 0x7f) ? (char)b : '.';
+		t[i + 1] = 0;
+	}
+	printf("VINCE WLAN: firmware crash reason: \"%s\"\n", t);
+}
+
+/* ask the shim (CPU1 monitor) to restart Pronto; 0 when the firmware is back up with the WCNSS_CTRL handshake done */
+static int
+vw_restart_pronto(void)
+{
+	uint32_t b0, req;
+	uint64_t t0;
+
+	if (!vw_mbx) {
+		vw_mbx = (volatile struct vw_mbx *)ml_io_map(MBX_PA, 0x1000);
+	}
+	if (!vw_mbx || vw_mbx->magic != MBX_MAGIC) {
+		printf("VINCE WLAN: the shim has no restart service\n");
+		return -1;
+	}
+	b0 = vw_mbx->beat;
+	vince_smd_sleep(500);
+	if (vw_mbx->beat == b0) {
+		printf("VINCE WLAN: the shim's restart service is not running\n");
+		return -2;
+	}
+	vw_crash_log();
+	/* forget everything about the old firmware */
+	bzero(&vw_ch, sizeof(vw_ch));
+	vw_have_self = false;
+	vd_reset();
+	va_reset();
+	vwpa_stop();
+	vn_link_reset();
+	req = vw_mbx->done + 1;
+	vw_mbx->req = req;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	t0 = vd_now_us();
+	while (vw_mbx->done != req) {
+		if (vd_now_us() - t0 > 180000000ULL) {
+			printf("VINCE WLAN: the shim did not finish the restart\n");
+			return -3;
+		}
+		vince_smd_sleep(100);
+	}
+	printf("VINCE WLAN: the shim restarted Pronto, result %u, restarts so far %u\n", vw_mbx->result, vw_mbx->restarts);
+	return vw_mbx->result ? -4 : 0;
+}
+
+/* open WLAN_CTRL, SMSM bit, HAL start and feature exchange; 0 when the HAL is up */
+static int
+vw_bringup(int stage)
+{
+	int r = -1;
+
+	/* the channel list is complete once the shim has done the WCNSS_CTRL handshake; give it a minute anyway */
+	for (int i = 0; i < 240 && !vince_smd_find("WLAN_CTRL", &vw_ch); i++) {
+		vince_smd_sleep(250);
+	}
+	if (!vince_smd_find("WLAN_CTRL", &vw_ch)) {
+		printf("VINCE WLAN: no WLAN_CTRL channel (Pronto not started by the shim?)\n");
+		return -1;
+	}
+	for (int i = 0; i < 10 && (r = vw_open()) != 0; i++) {
+		vince_smd_sleep(500);
+	}
+	if (r) {
+		printf("VINCE WLAN: WLAN_CTRL open failed %d\n", r);
+		return r;
+	}
+	printf("VINCE WLAN: WLAN_CTRL open\n");
+	if (stage >= 2) {
+		if (!vd_map()) {
+			printf("VINCE WLAN: DXE mapping failed\n");
+			return -2;
+		}
+		/* mainline sets the tx-rings-empty SMSM bit before it starts the chip */
+		printf("VINCE WLAN: SMSM tx-rings-empty %d\n", vd_smsm_rings_empty());
+	}
+	if (vw_start() || vw_caps()) {
+		return -3;
+	}
+	vw_crash_baseline();
+	printf("VINCE WLAN: X1 done, HAL is up\n");
+	return 0;
+}
