diff --git a/bsd/dev/vince_rootfix.c b/bsd/dev/vince_rootfix.c
new file mode 100755
index 0000000..5ff8aa4
--- /dev/null
+++ b/bsd/dev/vince_rootfix.c
@@ -0,0 +1,87 @@
+/*
+ * VINCE root file system fix-ups, applied by the kernel right after the iOS root is mounted and before launchd runs
+ * (boot-arg vincefix=bluetool): the userland stand-ins built by .github/workflows/userland.yml are written to the
+ * root and the launchd job files that must start them are replaced. The originals stay untouched on the image (the
+ * stand-ins live in /usr/libexec), only the job file of com.apple.BlueTool is rewritten; the original job file is on the IPSW root
+ * (see the mount of the IPSW root).
+ */
+#if defined(ARM64_BOARD_CONFIG_VINCE)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <sys/fcntl.h>
+#include <sys/kauth.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <pexpert/pexpert.h>
+#include <kern/kalloc.h>
+#include "vince_userland_data.h"
+
+void vince_rootfix(void);
+
+static int
+vf_same(const char *path, const void *data, size_t len)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	off_t sz = 0;
+	int same = 0;
+
+	if (vnode_lookup(path, 0, &vp, ctx) != 0) {
+		return 0;
+	}
+	if (vnode_size(vp, &sz, ctx) == 0 && (size_t)sz == len) {
+		uint8_t *buf = kalloc_data(len, Z_WAITOK);
+
+		if (buf) {
+			int resid = 0;
+
+			if (vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)len, 0, UIO_SYSSPACE, IO_NODELOCKED, vfs_context_ucred(ctx), &resid,
+			    vfs_context_proc(ctx)) == 0 && resid == 0) {
+				same = bcmp(buf, data, len) == 0;
+			}
+			kfree_data(buf, len);
+		}
+	}
+	vnode_put(vp);
+	return same;
+}
+
+static int
+vf_write(const char *path, const void *data, size_t len, int mode)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int err, resid = 0;
+
+	if (vf_same(path, data, len)) {
+		return 0;
+	}
+	err = vnode_open(path, O_WRONLY | O_CREAT | O_TRUNC, mode, 0, &vp, ctx);
+	if (err) {
+		return err;
+	}
+	err = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)data, (int)len, 0, UIO_SYSSPACE, IO_NODELOCKED | IO_SYNC,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	if (err == 0 && resid != 0) {
+		err = EIO;
+	}
+	(void)vnode_close(vp, FWRITE, ctx);
+	return err;
+}
+
+void
+vince_rootfix(void)
+{
+	char arg[32] = "";
+	int e1, e2;
+
+	if (!PE_parse_boot_argn("vincefix", arg, sizeof(arg)) || strcmp(arg, "bluetool") != 0) {
+		return;
+	}
+	e1 = vf_write("/usr/libexec/vince-bluetool", vince_bluetool_bin, vince_bluetool_bin_len, 0755);
+	e2 = vf_write("/System/Library/LaunchDaemons/com.apple.BlueTool.plist", vince_bluetool_plist, vince_bluetool_plist_len, 0644);
+	printf("VINCE ROOTFIX: BlueTool stand-in %d, job file %d\n", e1, e2);
+}
+#endif /* ARM64_BOARD_CONFIG_VINCE */
