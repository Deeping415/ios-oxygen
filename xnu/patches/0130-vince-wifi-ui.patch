diff --git a/bsd/dev/vince_wlan.c b/bsd/dev/vince_wlan.c
index 3513764..e703342 100755
--- a/bsd/dev/vince_wlan.c
+++ b/bsd/dev/vince_wlan.c
@@ -858,6 +858,452 @@ vw_station(int stage)
 	printf("VINCE WLAN: station done after %d reconnect cycles, %d Pronto restarts\n", cycles, restarts);
 }
 
+
+/* ---- Apple80211 UI mode (boot-arg vinceui=2) ---- */
+
+static lck_mtx_t *vui_lk;
+static int vui_pending;                 /* 1 scan, 2 associate, 4 disassociate */
+static struct vui_assoc vui_a;
+static struct vui_info vui_i;
+static bool vui_on;
+static bool vui_selftest;               /* vinceuitest=1: also run DHCP in the kernel and ping, no configd around */
+
+bool
+vui_enabled(void)
+{
+	return vui_on;
+}
+
+static void
+vui_init(void)
+{
+	lck_grp_t *g;
+
+	if (vui_lk) {
+		return;
+	}
+	g = lck_grp_alloc_init("vince_ui", LCK_GRP_ATTR_NULL);
+	vui_lk = lck_mtx_alloc_init(g, LCK_ATTR_NULL);
+	vui_i.power = 1;
+	vui_i.state = VUI_S_INIT;
+	vui_on = true;
+	vif_set_ui_mode(true);
+}
+
+void
+vui_get_info(struct vui_info *out)
+{
+	if (!vui_lk) {
+		bzero(out, sizeof(*out));
+		return;
+	}
+	lck_mtx_lock(vui_lk);
+	*out = vui_i;
+	lck_mtx_unlock(vui_lk);
+}
+
+void
+vui_post_scan(void)
+{
+	lck_mtx_lock(vui_lk);
+	vui_pending |= 1;
+	lck_mtx_unlock(vui_lk);
+}
+
+void
+vui_post_assoc(const struct vui_assoc *a)
+{
+	lck_mtx_lock(vui_lk);
+	vui_a = *a;
+	vui_pending |= 2;
+	lck_mtx_unlock(vui_lk);
+	vif_abort = 1;
+}
+
+void
+vui_post_disassoc(void)
+{
+	lck_mtx_lock(vui_lk);
+	vui_pending |= 4;
+	lck_mtx_unlock(vui_lk);
+	vif_abort = 1;
+}
+
+void
+vui_set_power(int on)
+{
+	lck_mtx_lock(vui_lk);
+	vui_i.power = on;
+	lck_mtx_unlock(vui_lk);
+	if (!on) {
+		vui_post_disassoc();
+	}
+	vif_a80211_event(1, NULL, 0);           /* APPLE80211_M_POWER_CHANGED */
+}
+
+const struct vd_bss *
+vui_result(uint32_t idx)
+{
+	uint32_t n;
+	const struct vd_bss *b = vd_bss_list(&n);
+
+	return idx < n ? &b[idx] : NULL;
+}
+
+static void
+vui_set_state(int state)
+{
+	lck_mtx_lock(vui_lk);
+	vui_i.state = state;
+	lck_mtx_unlock(vui_lk);
+}
+
+/* next request for the driver thread: 4 disassociate, 2 associate (copied to *a), 1 scan, 0 none */
+static int
+vui_take(struct vui_assoc *a)
+{
+	int c = 0;
+
+	lck_mtx_lock(vui_lk);
+	if (vui_pending & 4) {
+		vui_pending &= ~4;
+		c = 4;
+	} else if (vui_pending & 2) {
+		vui_pending &= ~2;
+		*a = vui_a;
+		c = 2;
+	} else if (vui_pending & 1) {
+		vui_pending &= ~1;
+		c = 1;
+	}
+	lck_mtx_unlock(vui_lk);
+	return c;
+}
+
+static bool
+vui_has_cmd(void)
+{
+	return vui_pending != 0;
+}
+
+/* a scan without the bring-up: the self station exists already */
+static int
+vw_scan_again(void)
+{
+	struct vd_tx_ctx ctx;
+	const uint8_t *self = vw_self_info();
+	uint8_t pr[64];
+	uint32_t prlen;
+	int r, probes = 2;
+
+	if (!self) {
+		return -1;
+	}
+	ctx.sta_index = self[0];
+	ctx.dpu_desc_idx = self[1];
+	ctx.dpu_sign = self[2];
+	ctx.band_5ghz = 0;
+	ctx.no_encrypt = 1;
+	prlen = vw_probe_req(pr, vw_mac);
+	vd_bss_clear();
+	r = vw_scan_init();
+	if (r) {
+		return r;
+	}
+	for (uint8_t ch = 1; ch <= 13; ch++) {
+		if (vw_scan_start(ch)) {
+			break;
+		}
+		for (int k = 0; k < probes; k++) {
+			if (vd_tx_mgmt(&ctx, pr, prlen, 1)) {
+				probes = 0;
+				break;
+			}
+			vd_poll(10);
+		}
+		vd_poll(100);
+		if (vw_scan_end(ch)) {
+			break;
+		}
+	}
+	r = vw_scan_finish(1);
+	vd_poll(30);
+	return r;
+}
+
+static void
+vui_scan(void)
+{
+	struct vui_info in;
+
+	vui_get_info(&in);
+	if (in.state != VUI_S_RUN) {            /* while associated the cached list is all we give */
+		vui_set_state(VUI_S_SCAN);
+		(void)vw_scan_again();
+		vui_set_state(VUI_S_INIT);
+	}
+	lck_mtx_lock(vui_lk);
+	vui_i.scan_gen++;
+	lck_mtx_unlock(vui_lk);
+	vif_a80211_event(10, NULL, 0);          /* APPLE80211_M_SCAN_DONE */
+}
+
+static void
+vui_link_event(bool down, uint32_t rssi, bool voluntary, uint32_t reason)
+{
+	uint8_t d[24];
+
+	bzero(d, sizeof(d));
+	d[0] = down;
+	d[4] = (uint8_t)rssi;
+	d[5] = (uint8_t)(rssi >> 8);
+	d[6] = (uint8_t)(rssi >> 16);
+	d[7] = (uint8_t)(rssi >> 24);
+	d[16] = voluntary;
+	d[20] = (uint8_t)reason;
+	vif_a80211_event(4, d, sizeof(d));      /* APPLE80211_M_LINK_CHANGED */
+}
+
+/* returns 1 when the firmware has to be restarted */
+static int
+vui_assoc(const struct vui_assoc *a, int stage)
+{
+	static struct va_result ar;
+	static struct vwpa_result wr;
+	uint32_t n;
+	const struct vd_bss *b, *hit = NULL;
+	struct vd_bss ap;
+	int r, why, lr;
+	uint8_t res[4] = { 0, 0, 0, 0 };
+
+	for (int pass = 0; pass < 2 && !hit; pass++) {
+		b = vd_bss_list(&n);
+		for (uint32_t i = 0; i < n; i++) {
+			bool same = true;
+
+			for (uint32_t k = 0; k < 32 && same; k++) {
+				char c = k < a->ssid_len ? (char)a->ssid[k] : 0;
+
+				same = b[i].ssid[k] == c;
+			}
+			if (a->has_bssid) {
+				same = same && bcmp(b[i].bssid, a->bssid, 6) == 0;
+			}
+			if (same && (!hit || b[i].rssi > hit->rssi)) {
+				hit = &b[i];
+			}
+		}
+		if (!hit && pass == 0) {
+			vui_set_state(VUI_S_SCAN);
+			(void)vw_scan_again();
+		}
+	}
+	if (!hit) {
+		printf("VINCE UI: network not found\n");
+		vui_set_state(VUI_S_INIT);
+		res[0] = 9;                                     /* APPLE80211_RESULT_TIMEOUT */
+		vif_a80211_event(9, res, sizeof(res));
+		return 0;
+	}
+	ap = *hit;
+	printf("VINCE UI: associating with \"%s\" ch %u (%s)\n", ap.ssid, ap.ch, a->open ? "open" : a->has_pmk ? "PMK" : "passphrase");
+	vui_set_state(VUI_S_ASSOC);
+	va_use_rsn(a->open ? 0 : 1);
+	r = va_connect(&ap, &ar);
+	va_use_rsn(0);
+	vw_log_assoc(&ar);
+	if (r) {
+		bool dead = vw_hal_dead(ar.step, ar.err) || vw_fw_crashed();
+
+		vui_set_state(VUI_S_INIT);
+		if (dead) {
+			return 1;
+		}
+		res[0] = 2;
+		vif_a80211_event(9, res, sizeof(res));
+		return 0;
+	}
+	if (!a->open) {
+		uint32_t pl = 0;
+
+		while (a->has_pass && a->pass[pl] && pl < sizeof(a->pass) - 1) {
+			pl++;
+		}
+		r = a->has_pmk ? vwpa_handshake_pmk(&ap, NULL, 0, a->pmk, &wr) : vwpa_handshake_pmk(&ap, a->pass, pl, NULL, &wr);
+		printf("VINCE UI: handshake %s at step %d (%s) err %d\n", r ? "FAILED" : "done", wr.step, vwpa_step_name(wr.step), wr.err);
+		if (r) {
+			bool dead = vw_hal_dead(wr.step, wr.err) || vw_fw_crashed();
+
+			vwpa_stop();
+			lr = va_leave(&ap, 1);
+			vui_set_state(VUI_S_INIT);
+			if (dead || (lr <= -2 && lr >= -5)) {
+				return 1;
+			}
+			res[0] = 22;                            /* supplicant timeout / wrong key */
+			vif_a80211_event(9, res, sizeof(res));
+			return 0;
+		}
+	}
+	lck_mtx_lock(vui_lk);
+	vui_i.state = VUI_S_RUN;
+	vui_i.ssid_len = a->ssid_len;
+	bcopy(a->ssid, vui_i.ssid, 32);
+	bcopy(ap.bssid, vui_i.bssid, 6);
+	vui_i.channel = ap.ch;
+	vui_i.rssi = ap.rssi;
+	lck_mtx_unlock(vui_lk);
+	vif_ui_up();
+	res[0] = 1;                                             /* APPLE80211_RESULT_SUCCESS */
+	vif_a80211_event(2, NULL, 0);                           /* SSID_CHANGED */
+	vif_a80211_event(3, NULL, 0);                           /* BSSID_CHANGED */
+	vif_a80211_event(9, res, sizeof(res));                  /* ASSOC_DONE */
+	vui_link_event(false, (uint32_t)(int)ap.rssi, true, 0);
+	if (vui_selftest) {
+		int d = vn_dhcp();
+
+		printf("VINCE UI: self-test DHCP %d\n", d);
+		if (!d) {
+			const struct vn_cfg *c = vn_get_cfg();
+
+			printf("VINCE UI: self-test lease ip %u.%u.%u.%u gw %u.%u.%u.%u\n", c->ip[0], c->ip[1], c->ip[2], c->ip[3],
+			    c->gw[0], c->gw[1], c->gw[2], c->gw[3]);
+			if (vif_up(c) == 0) {
+				vif_start_ping(12, 5000);
+			}
+		}
+	}
+	vif_abort = 0;
+	if (vui_has_cmd()) {
+		why = VIF_END_CMD;
+	} else {
+		why = vif_serve(3600ULL * 1000000ULL * 24, 0, 0);
+	}
+	printf("VINCE UI: link ended (%d)\n", why);
+	vif_link(false);
+	vif_down();
+	vwpa_stop();
+	lr = va_leave(&ap, 1);
+	vn_link_reset();
+	vui_set_state(VUI_S_INIT);
+	vui_link_event(true, 0, why == VIF_END_CMD, why == VIF_END_LOST ? 2 : 3);
+	vif_a80211_event(2, NULL, 0);
+	vif_a80211_event(3, NULL, 0);
+	return why == VIF_END_FWCRASH || (lr <= -2 && lr >= -5) || vw_fw_crashed();
+}
+
+static void
+vui_selftest_thread(void *arg, wait_result_t w)
+{
+#pragma unused(arg, w)
+	static char ssid[40], pass[72];
+	struct vui_assoc a;
+	struct vui_info in;
+	uint32_t gen;
+
+	vince_smd_sleep(4000);
+	vui_get_info(&in);
+	gen = in.scan_gen;
+	printf("VINCE UI TEST: requesting a scan\n");
+	vui_post_scan();
+	for (int i = 0; i < 100; i++) {
+		vince_smd_sleep(200);
+		vui_get_info(&in);
+		if (in.scan_gen != gen) {
+			break;
+		}
+	}
+	{
+		uint32_t cnt = 0;
+
+		while (vui_result(cnt)) {
+			cnt++;
+		}
+		printf("VINCE UI TEST: scan done, %u results\n", cnt);
+	}
+	if (PE_parse_boot_argn("vincessid", ssid, sizeof(ssid)) && PE_parse_boot_argn("vincepass", pass, sizeof(pass))) {
+		uint32_t l = 0;
+
+		vw_unscore(ssid);
+		bzero(&a, sizeof(a));
+		while (ssid[l] && l < 32) {
+			a.ssid[l] = (uint8_t)ssid[l];
+			l++;
+		}
+		a.ssid_len = l;
+		strlcpy(a.pass, pass, sizeof(a.pass));
+		a.has_pass = 1;
+		bzero(pass, sizeof(pass));
+		printf("VINCE UI TEST: associating\n");
+		vui_post_assoc(&a);
+		for (int i = 0; i < 150; i++) {
+			vince_smd_sleep(200);
+			vui_get_info(&in);
+			if (in.state == VUI_S_RUN) {
+				break;
+			}
+		}
+		printf("VINCE UI TEST: state %d ssid_len %u channel %u\n", in.state, in.ssid_len, in.channel);
+		vince_smd_sleep(70000);
+		printf("VINCE UI TEST: disassociating\n");
+		vui_post_disassoc();
+		vince_smd_sleep(6000);
+		vui_get_info(&in);
+		printf("VINCE UI TEST: state after disassociate %d\n", in.state);
+	}
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+vui_loop(int stage)
+{
+	struct vui_assoc a;
+	thread_t th;
+	int test = 0;
+
+	(void)PE_parse_boot_argn("vinceuitest", &test, sizeof(test));
+	vui_selftest = test != 0;
+	if (vui_selftest && kernel_thread_start(vui_selftest_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	}
+	printf("VINCE UI: driver loop running\n");
+	for (;;) {
+		int c = vui_take(&a);
+
+		if (c == 0) {
+			vd_poll(0);
+			if (vw_fw_crashed()) {
+				c = 8;
+			} else {
+				vince_smd_sleep(20);
+				continue;
+			}
+		}
+		if (c == 1) {
+			vui_scan();
+		} else if (c == 2) {
+			if (vui_assoc(&a, stage)) {
+				c = 8;
+			}
+		} else if (c == 4) {
+			/* already out of the serve loop: nothing to leave */
+			vif_a80211_event(4, NULL, 0);
+		}
+		if (c == 8) {
+			printf("VINCE UI: restarting Pronto\n");
+			vif_link(false);
+			vui_set_state(VUI_S_INIT);
+			if (vw_restart_pronto() || vw_bringup(stage) || vw_prepare(NULL)) {
+				printf("VINCE UI: Wi-Fi could not be brought back\n");
+				break;
+			}
+			vif_ui_up();
+			vif_a80211_event(55, NULL, 0);          /* APPLE80211_M_DRIVER_AVAILABLE */
+		}
+	}
+}
