+
+/* APPLE:IEEE80211:1 kernel event: net_event_data (interface) followed by the event's own data */
+void
+vif_a80211_event(uint32_t code, const void *data, uint32_t len)
+{
+	struct kev_msg ev;
+	struct net_event_data nd;
+
+	if (!vif_ifp) {
+		return;
+	}
+	bzero(&ev, sizeof(ev));
+	bzero(&nd, sizeof(nd));
+	nd.if_family = IFNET_FAMILY_ETHERNET;
+	nd.if_unit = 0;
+	strlcpy(nd.if_name, "en", sizeof(nd.if_name));
+	ev.vendor_code = KEV_VENDOR_APPLE;
+	ev.kev_class = KEV_IEEE80211_CLASS;
+	ev.kev_subclass = 1;
+	ev.event_code = code;
+	ev.dv[0].data_length = sizeof(nd);
+	ev.dv[0].data_ptr = &nd;
+	if (len) {
+		ev.dv[1].data_length = len;
+		ev.dv[1].data_ptr = (void *)(uintptr_t)data;
+	}
+	(void)kev_post_msg(&ev);
+}
+
+/* link up / down for the stack and for configd (IPConfiguration starts DHCP on link-on) */
+void
+vif_link(bool up)
+{
+	if (!vif_ifp) {
+		return;
+	}
+	vif_link_up = up;
+	ifnet_set_flags(vif_ifp, up ? IFF_RUNNING : 0, IFF_RUNNING);
+	(void)dlil_post_msg(vif_ifp, KEV_DL_SUBCLASS, up ? KEV_DL_LINK_ON : KEV_DL_LINK_OFF, NULL, 0, FALSE);
+}
+
+void
+vif_ui_up(void)
+{
+	vn_set_stack_mode(1);
+	if (!vif_ifp && vif_attach(vw_mac)) {
+		return;
+	}
+	if (bcmp(vif_mac, vw_mac, 6) != 0) {
+		ifnet_set_lladdr(vif_ifp, vw_mac, ETHER_ADDR_LEN);
+		bcopy(vw_mac, vif_mac, 6);
+	}
+	vif_link(true);
+}
