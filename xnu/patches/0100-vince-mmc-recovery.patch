-/* n (1..MAX_SECTORS) sectors at lba into the bounce buffer */
+/*
+ * After recover(): bring the card back to the transfer state. A data command that failed half way leaves it in
+ * data (5) or receive (6), where it ignores CMD17/18/24/25 until a CMD12; programming (7) ends by itself.
+ */
+static int
+mmc_resync(void)
+{
+	uint64_t end = deadline_ms(500);
+	int st = -1;
+	for (int i = 0;; i++) {
+		bool late = mach_absolute_time() > end;
+		st = mmc_state();
+		if (st == 4) {
+			return 0;
+		}
+		if ((st == 5 || st == 6 || st < 0) && i < 3) {
+			if (mmc_cmd(12, 0, F_R1B, 0, 0)) {
+				recover();
+			}
+		}
+		if (late) {
+			break;
+		}
+		delay(1000);
+	}
+	printf("VINCE MMC: card stuck in state %d after an error\n", st);
+	return EIO;
+}
+
+/* n (1..MAX_SECTORS) sectors at lba into the bounce buffer; one retry after resyncing the card */
+static int mmc_read_once(uint64_t lba, uint32_t n);
+static int mmc_write_once(uint64_t rel, uint32_t n);
+
 static int
 mmc_read_sectors(uint64_t lba, uint32_t n)
+{
+	int error = mmc_read_once(lba, n);
+	if (error && error != EINVAL && !mmc_resync()) {
+		error = mmc_read_once(lba, n);
+		printf("VINCE MMC: read retry at 0x%llx %s\n", lba, error ? "failed" : "ok");
+	}
+	return error;
+}
+
+static int
+mmc_write_sectors(uint64_t rel, uint32_t n)
+{
+	int error = mmc_write_once(rel, n);
+	if (error && vm.rw && !mmc_resync()) {
+		error = mmc_write_once(rel, n);
+		printf("VINCE MMC: write retry at partition sector 0x%llx %s\n", rel, error ? "failed" : "ok");
+	}
+	return error;
+}
+
+static int
+mmc_read_once(uint64_t lba, uint32_t n)
 {
 	if (lba > UINT32_MAX || n == 0 || n > MAX_SECTORS) {
 		return EINVAL;
