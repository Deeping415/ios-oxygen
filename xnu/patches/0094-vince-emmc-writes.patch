+/*
+ * Write path check on a sector nothing uses: past the end of the HFS+ volume (volume header at byte 1024:
+ * blockSize @40, totalBlocks @44, big endian), at least 1 MiB in, inside the partition. Original contents are put
+ * back. Returns 0 when the pattern read back intact.
+ */
+static int
+mmc_write_selftest(void)
+{
+	if (mmc_read_sectors(vm.first + 2, 1)) {
+		return EIO;
+	}
+	const uint8_t *vh = (const uint8_t *)vince_mmc_bounce;
+	if (!((vh[0] == 'H' && vh[1] == '+') || (vh[0] == 'H' && vh[1] == 'X'))) {
+		printf("VINCE MMC: no HFS+ volume header, no write self-test\n");
+		return ENXIO;
+	}
+	uint32_t bsz = (uint32_t)vh[40] << 24 | (uint32_t)vh[41] << 16 | (uint32_t)vh[42] << 8 | vh[43];
+	uint32_t blocks = (uint32_t)vh[44] << 24 | (uint32_t)vh[45] << 16 | (uint32_t)vh[46] << 8 | vh[47];
+	uint64_t test = (uint64_t)bsz * blocks / SECTOR + 2048;
+	if (bsz < SECTOR || test + 1 > vm.nsect) {
+		printf("VINCE MMC: no free sector past the volume (block %u x %u), no write self-test\n", bsz, blocks);
+		return ENOSPC;
+	}
+	static uint32_t saved[SECTOR / 4];
+	if (mmc_read_sectors(vm.first + test, 1)) {
+		return EIO;
+	}
+	memcpy(saved, vince_mmc_bounce, SECTOR);
+	for (uint32_t i = 0; i < SECTOR / 4; i++) {
+		vince_mmc_bounce[i] = 0x56494e43u ^ (i * 0x9e3779b9u);     /* "VINC" ^ golden ratio walk */
+	}
+	int error = mmc_write_sectors(test, 1);
+	if (!error) {
+		error = mmc_read_sectors(vm.first + test, 1);
+	}
+	for (uint32_t i = 0; !error && i < SECTOR / 4; i++) {
+		if (vince_mmc_bounce[i] != (0x56494e43u ^ (i * 0x9e3779b9u))) {
+			printf("VINCE MMC: write self-test read back word %u = 0x%08x\n", i, vince_mmc_bounce[i]);
+			error = EIO;
+		}
+	}
+	memcpy(vince_mmc_bounce, saved, SECTOR);
+	if (mmc_write_sectors(test, 1) && !error) {
+		error = EIO;
+	}
+	printf("VINCE MMC: write self-test at partition sector 0x%llx: %s\n", test, error ? "FAILED" : "ok");
+	return error;
+}
