+/*
+ * n (1..MAX_SECTORS) sectors from the bounce buffer to partition-relative sector rel. The bounds are checked here,
+ * on the absolute LBA that goes to the card, whatever the caller computed.
+ */
+static int
+mmc_write_sectors(uint64_t rel, uint32_t n)
+{
+	uint64_t lba = vm.first + rel;
+	if (!vm.rw || n == 0 || n > MAX_SECTORS || rel >= vm.nsect || n > vm.nsect - rel ||
+	    lba < vm.first || lba + n > vm.first + vm.nsect || lba + n > UINT32_MAX) {
+		printf("VINCE MMC: refused write of %u sectors at partition sector 0x%llx\n", n, rel);
+		return EIO;
+	}
+	uint32_t xm = XM_BLKCNT | (n > 1 ? XM_MULTI | XM_ACMD12 : 0);
+	int error = mmc_cmd(n > 1 ? 25 : 24, (uint32_t)lba, F_R1 | C_DATA, xm, n);
+	if (!error && (vm.resp & R1_ERR)) {
+		vm.err = vm.resp;
+		error = EIO;
+	}
+	const uint32_t *w = vince_mmc_bounce;
+	for (uint32_t b = 0; !error && b < n; b++) {
+		error = wait_int(INT_WRREADY, 1000);
+		for (uint32_t i = 0; !error && i < SECTOR / 4; i++) {
+			hc_wr(BUF, *w++);
+		}
+	}
+	if (!error) {
+		error = wait_int(INT_XFER, 5000);       /* programming busy of the last block (and auto CMD12) */
+	}
+	if (error) {
+		printf("VINCE MMC: write of %u sectors at 0x%llx failed (status 0x%08x)\n", n, lba, vm.err);
+		recover();
+	}
+	return error;
+}
