+ * the end of the HFS+ volume (unused space at the partition's tail); if it does not read back, writes stay off.
  */
 #if defined(ARM64_BOARD_CONFIG_VINCE)
 #include <sys/param.h>
@@ -71,6 +75,7 @@ extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
