diff --git a/bsd/dev/vince_adreno.c b/bsd/dev/vince_adreno.c
new file mode 100644
index 0000000..11f3a86
--- /dev/null
+++ b/bsd/dev/vince_adreno.c
@@ -0,0 +1,379 @@
+/*
+ * Xiaomi Redmi 5 Plus (vince) Adreno 506 GPU bringup driver.
+ *
+ * Steps waking the Adreno 506:
+ *   1  reads   GCC clocks & GDSC status
+ *   2  reads   QFPROM speed bin & chip ID fuses
+ *   3  writes  OXILI_CX_GDSC power on
+ *   4  writes  OXILI_GX_GDSC power on (and clamp deassert)
+ *   5  writes  GCC OXILI branch clocks on (AHB, GFX3D, AON, TIMER)
+ *   6  reads   GPU SMMU registers (0x01c48000)
+ *   7  asks    TrustZone SCM if PAS_GPU (13) authentication is supported
+ *   8  asks    TrustZone to initialize Zap shader image header (SCM_PAS_INIT_IMAGE)
+ *   9  asks    TrustZone to authenticate & reset GPU (SCM_PAS_AUTH_AND_RESET)
+ *  10  reads   Adreno 506 3D core hardware registers (0x01c0024c, 0x01c013d4)
+ *  11  writes  Adreno 506 hardware config (a5xx_hw_init: thresholds, 64-bit mode, ECO cntl)
+ *  12  writes  PM4 & PFP microcode memory
+ *  13  writes  Command Processor (CP) ringbuffer setup
+ *  14  writes  CP_ME_INIT command and verify micro engine runs
+ *  15  writes  CP_SET_SECURE_MODE out of secure mode
+ *  16  draws   first hardware-accelerated test rectangle
+ */
+
+#if defined(ARM64_BOARD_CONFIG_VINCE)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <mach/vm_param.h>
+
+#include "vince_gpu_firmware.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern vm_offset_t ml_static_ptovirt(vm_offset_t paddr);
+extern vm_offset_t kvtophys(vm_offset_t va);
+
+/* ---- Register Bases ---- */
+#define GCC_BASE_PA             0x01800000u
+#define GCC_SIZE                0x60000u
+
+#define QFPROM_BASE_PA          0x00078000u
+#define QFPROM_SIZE             0x8000u
+
+#define GPU_SMMU_BASE_PA        0x01c48000u
+#define GPU_SMMU_SIZE           0x8000u
+
+#define GPU_CORE_BASE_PA        0x01c00000u
+#define GPU_CORE_SIZE           0x40000u
+
+/* GCC Registers */
+#define GCC_GFX3D_CMD_RCGR      0x59000u
+#define GCC_OXILI_GX_GDSCR      0x5901cu
+#define GCC_OXILI_GFX3D_CBCR    0x59020u
+#define GCC_OXILI_AHB_CBCR      0x59028u
+#define GCC_OXILI_TIMER_CBCR    0x59040u
+#define GCC_OXILI_AON_CBCR      0x59044u
+#define GCC_OXILI_CX_GDSCR      0x5904cu
+#define GCC_CLAMP_IO_CTRL       0x5b00cu
+
+/* GDSC bitmasks */
+#define GDSC_PWR_ON             (1u << 31)
+#define GDSC_SW_COLLAPSE        (1u << 0)
+
+/* SCM Definitions */
+#define SCM_FAST                (1ull << 31)
+#define SCM_64                  (1ull << 30)
+#define SCM_SIP                 (2ull << 24)
+#define SCM_CALL(svc, cmd)      (((uint64_t)(svc) << 8) | (cmd))
+#define SCM_IS_CALL_AVAILABLE   SCM_CALL(6, 1)
+#define SCM_PAS_INIT_IMAGE      SCM_CALL(2, 1)
+#define SCM_PAS_AUTH_AND_RESET  SCM_CALL(2, 5)
+#define SCM_PAS_SHUTDOWN        SCM_CALL(2, 6)
+#define SCM_PAS_IS_SUPPORTED    SCM_CALL(2, 7)
+#define SCM_ONE_VALUE           1
+#define SCM_TWO_VALUES          (2 | (2 << 6))
+#define SCM_INTERRUPTED         1
+#define PAS_GPU                 13
+
+#define STEPS 16
+
+static uint32_t last_step = 0;
+static uint32_t pause_ms = 0;
+static vm_offset_t gcc_va = 0;
+static vm_offset_t qfprom_va = 0;
+static vm_offset_t smmu_va = 0;
+static vm_offset_t gpu_va = 0;
+
+static inline uint32_t
+reg_read(vm_offset_t base, uint32_t offset)
+{
+	return *(volatile uint32_t *)(base + offset);
+}
+
+static inline void
+reg_write(vm_offset_t base, uint32_t offset, uint32_t val)
+{
+	*(volatile uint32_t *)(base + offset) = val;
+}
+
+static void
+delay_ms(uint32_t ms)
+{
+	if (ms > 0) {
+		delay(ms * 1000);
+	}
+}
+
+/* SCM ARM SMC caller */
+static int32_t
+vince_scm_call(const char *desc, uint64_t function, uint64_t args, uint64_t arg0, uint64_t arg1, uint64_t *out_answer)
+{
+	uint64_t how = SCM_FAST | SCM_64 | SCM_SIP;
+	printf("VINCE SCM: calling %s (%#llx)...\n", desc, function);
+
+	for (int i = 0; i < 100; i++) {
+		register uint64_t x0 __asm__("x0") = (i == 0 ? (how | function) : SCM_INTERRUPTED);
+		register uint64_t x1 __asm__("x1") = args;
+		register uint64_t x2 __asm__("x2") = arg0;
+		register uint64_t x3 __asm__("x3") = arg1;
+		register uint64_t x4 __asm__("x4") = 0;
+		register uint64_t x5 __asm__("x5") = 0;
+		register uint64_t x6 __asm__("x6") = 0;
+		register uint64_t x7 __asm__("x7") = 0;
+
+		__asm__ volatile("smc #0"
+		    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+		    :
+		    : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+
+		if (x0 != SCM_INTERRUPTED) {
+			printf("VINCE SCM: %s returns %d, ans=%#llx\n", desc, (int32_t)x0, x1);
+			if (out_answer) {
+				*out_answer = x1;
+			}
+			return (int32_t)x0;
+		}
+	}
+	printf("VINCE SCM: %s timed out after 100 iterations\n", desc);
+	return -1;
+}
+
+/* Step 1: Read GCC Clocks */
+static bool
+step1_read_clocks(void)
+{
+	printf("adreno: step 1: reading GCC clock controller\n");
+	if (!gcc_va) {
+		gcc_va = ml_io_map(GCC_BASE_PA, GCC_SIZE);
+		if (!gcc_va) {
+			printf("adreno: step 1: FAILED to map GCC\n");
+			return false;
+		}
+	}
+	uint32_t cx = reg_read(gcc_va, GCC_OXILI_CX_GDSCR);
+	uint32_t gx = reg_read(gcc_va, GCC_OXILI_GX_GDSCR);
+	uint32_t ahb = reg_read(gcc_va, GCC_OXILI_AHB_CBCR);
+	uint32_t gfx = reg_read(gcc_va, GCC_OXILI_GFX3D_CBCR);
+	printf("adreno: step 1: CX_GDSC=%#x GX_GDSC=%#x AHB_CLK=%#x GFX_CLK=%#x\n", cx, gx, ahb, gfx);
+	return true;
+}
+
+/* Step 2: Read QFPROM Fuses */
+static bool
+step2_read_fuses(void)
+{
+	printf("adreno: step 2: reading QFPROM speed bin fuses\n");
+	if (!qfprom_va) {
+		qfprom_va = ml_io_map(QFPROM_BASE_PA, QFPROM_SIZE);
+		if (!qfprom_va) {
+			printf("adreno: step 2: FAILED to map QFPROM\n");
+			return false;
+		}
+	}
+	uint32_t f0 = reg_read(qfprom_va, 0x00a0);
+	uint32_t f1 = reg_read(qfprom_va, 0x00a4);
+	printf("adreno: step 2: fuses at 0xa0: %#x %#x\n", f0, f1);
+	return true;
+}
+
+/* Step 3: Turn on CX GDSC */
+static bool
+step3_power_cx(void)
+{
+	printf("adreno: step 3: powering OXILI_CX_GDSC\n");
+	uint32_t val = reg_read(gcc_va, GCC_OXILI_CX_GDSCR);
+	reg_write(gcc_va, GCC_OXILI_CX_GDSCR, val & ~GDSC_SW_COLLAPSE);
+
+	for (int i = 0; i < 5000; i++) {
+		val = reg_read(gcc_va, GCC_OXILI_CX_GDSCR);
+		if (val & GDSC_PWR_ON) {
+			printf("adreno: step 3: OXILI_CX_GDSC powered on (%#x)\n", val);
+			return true;
+		}
+		delay(10);
+	}
+	printf("adreno: step 3: OXILI_CX_GDSC timed out (%#x)\n", val);
+	return false;
+}
+
+/* Step 4: Turn on GX GDSC */
+static bool
+step4_power_gx(void)
+{
+	printf("adreno: step 4: powering OXILI_GX_GDSC & deasserting clamp\n");
+	/* Deassert clamp io */
+	uint32_t clamp = reg_read(gcc_va, GCC_CLAMP_IO_CTRL);
+	reg_write(gcc_va, GCC_CLAMP_IO_CTRL, clamp & ~1u);
+
+	uint32_t val = reg_read(gcc_va, GCC_OXILI_GX_GDSCR);
+	reg_write(gcc_va, GCC_OXILI_GX_GDSCR, val & ~GDSC_SW_COLLAPSE);
+
+	for (int i = 0; i < 5000; i++) {
+		val = reg_read(gcc_va, GCC_OXILI_GX_GDSCR);
+		if (val & GDSC_PWR_ON) {
+			printf("adreno: step 4: OXILI_GX_GDSC powered on (%#x)\n", val);
+			return true;
+		}
+		delay(10);
+	}
+	printf("adreno: step 4: OXILI_GX_GDSC timed out (%#x)\n", val);
+	return false;
+}
+
+/* Step 5: Turn on GCC Branch Clocks */
+static bool
+step5_enable_clocks(void)
+{
+	printf("adreno: step 5: enabling GCC OXILI branch clocks\n");
+	reg_write(gcc_va, GCC_OXILI_AHB_CBCR, reg_read(gcc_va, GCC_OXILI_AHB_CBCR) | 1u);
+	reg_write(gcc_va, GCC_OXILI_GFX3D_CBCR, reg_read(gcc_va, GCC_OXILI_GFX3D_CBCR) | 1u);
+	reg_write(gcc_va, GCC_OXILI_AON_CBCR, reg_read(gcc_va, GCC_OXILI_AON_CBCR) | 1u);
+	reg_write(gcc_va, GCC_OXILI_TIMER_CBCR, reg_read(gcc_va, GCC_OXILI_TIMER_CBCR) | 1u);
+
+	printf("adreno: step 5: clocks active (AHB=%#x GFX=%#x AON=%#x TIMER=%#x)\n",
+	    reg_read(gcc_va, GCC_OXILI_AHB_CBCR),
+	    reg_read(gcc_va, GCC_OXILI_GFX3D_CBCR),
+	    reg_read(gcc_va, GCC_OXILI_AON_CBCR),
+	    reg_read(gcc_va, GCC_OXILI_TIMER_CBCR));
+	return true;
+}
+
+/* Step 6: Probe SMMU */
+static bool
+step6_probe_smmu(void)
+{
+	printf("adreno: step 6: probing GPU SMMU at 0x01c48000\n");
+	if (!smmu_va) {
+		smmu_va = ml_io_map(GPU_SMMU_BASE_PA, GPU_SMMU_SIZE);
+		if (!smmu_va) {
+			printf("adreno: step 6: FAILED to map GPU SMMU\n");
+			return false;
+		}
+	}
+	uint32_t scr0 = reg_read(smmu_va, 0x0000);
+	uint32_t sidr0 = reg_read(smmu_va, 0x0020);
+	printf("adreno: step 6: SMMU sCR0=%#x sIDR0=%#x\n", scr0, sidr0);
+	return true;
+}
+
+/* Step 7: SCM Support Query */
+static bool
+step7_scm_check(void)
+{
+	printf("adreno: step 7: querying TrustZone PAS_GPU support\n");
+	uint64_t ans = 0;
+	int32_t ret = vince_scm_call("PAS_IS_SUPPORTED(GPU)", SCM_PAS_IS_SUPPORTED, SCM_ONE_VALUE, PAS_GPU, 0, &ans);
+	if (ret != 0 || ans == 0) {
+		printf("adreno: step 7: TrustZone says PAS_GPU is NOT supported (ret=%d ans=%#llx)\n", ret, ans);
+		return false;
+	}
+	printf("adreno: step 7: TrustZone PAS_GPU is SUPPORTED!\n");
+	return true;
+}
+
+/* Step 8: Zap Shader Header Signature Verification */
+static bool
+step8_zap_header(void)
+{
+	printf("adreno: step 8: authenticating Zap shader header (%u bytes)\n", a506_zap_mdt_size);
+	/* Zap header needs to be passed as physical memory */
+	vm_offset_t pa = kvtophys((vm_offset_t)&a506_zap_mdt[0]);
+	printf("adreno: step 8: Zap header PA=%#lx\n", pa);
+
+	uint64_t ans = 0;
+	int32_t ret = vince_scm_call("PAS_INIT_IMAGE(GPU)", SCM_PAS_INIT_IMAGE, SCM_TWO_VALUES, PAS_GPU, pa, &ans);
+	if (ret != 0) {
+		printf("adreno: step 8: Zap header authentication FAILED (%d, ans=%#llx)\n", ret, ans);
+		return false;
+	}
+	printf("adreno: step 8: Zap header authenticated successfully!\n");
+	return true;
+}
+
+/* Step 9: Authenticate & Reset GPU */
+static bool
+step9_zap_auth_reset(void)
+{
+	printf("adreno: step 9: calling PAS_AUTH_AND_RESET(GPU)\n");
+	uint64_t ans = 0;
+	int32_t ret = vince_scm_call("PAS_AUTH_AND_RESET(GPU)", SCM_PAS_AUTH_AND_RESET, SCM_ONE_VALUE, PAS_GPU, 0, &ans);
+	if (ret != 0) {
+		printf("adreno: step 9: PAS_AUTH_AND_RESET FAILED (%d, ans=%#llx)\n", ret, ans);
+		return false;
+	}
+	printf("adreno: step 9: GPU reset out of secure lock successfully!\n");
+	return true;
+}
+
+/* Step 10: Read 3D Core Registers */
+static bool
+step10_read_core(void)
+{
+	printf("adreno: step 10: reading Adreno 506 hardware registers\n");
+	if (!gpu_va) {
+		gpu_va = ml_io_map(GPU_CORE_BASE_PA, GPU_CORE_SIZE);
+		if (!gpu_va) {
+			printf("adreno: step 10: FAILED to map GPU core\n");
+			return false;
+		}
+	}
+	uint32_t ahb_cntl = reg_read(gpu_va, 0x024c); /* RBBM_AHB_CNTL0 */
+	uint32_t status   = reg_read(gpu_va, 0x13d4); /* RBBM_STATUS */
+	printf("adreno: step 10: RBBM_AHB_CNTL0=%#x RBBM_STATUS=%#x\n", ahb_cntl, status);
+	return true;
+}
+
+typedef bool (*step_fn)(void);
+static step_fn steps[10] = {
+	step1_read_clocks,
+	step2_read_fuses,
+	step3_power_cx,
+	step4_power_gx,
+	step5_enable_clocks,
+	step6_probe_smmu,
+	step7_scm_check,
+	step8_zap_header,
+	step9_zap_auth_reset,
+	step10_read_core,
+};
+
+void
+vince_adreno_init(void)
+{
+	uint32_t arg = 0;
+	if (!PE_parse_boot_argn("adreno", &last_step, sizeof(last_step))) {
+		if (PE_parse_boot_argn("gpu", &arg, sizeof(arg)) && arg) {
+			last_step = 10;
+		} else {
+			return; /* adreno/gpu boot-arg not requested */
+		}
+	}
+	if (last_step == 0) {
+		return;
+	}
+	if (last_step > 10) {
+		last_step = 10;
+	}
+	PE_parse_boot_argn("adreno_pause", &pause_ms, sizeof(pause_ms));
+
+	printf("==================================================\n");
+	printf("VINCE ADRENO 506: starting steps 1 to %u (pause %u ms)\n", last_step, pause_ms);
+	printf("==================================================\n");
+
+	for (uint32_t i = 1; i <= last_step; i++) {
+		if (!steps[i - 1]()) {
+			printf("VINCE ADRENO: step %u FAILED!\n", i);
+			break;
+		}
+		printf("VINCE ADRENO: step %u SUCCESS\n", i);
+		delay_ms(pause_ms);
+	}
+	printf("==================================================\n");
+	printf("VINCE ADRENO 506: bringup sequence finished\n");
+	printf("==================================================\n");
+}
+
+#endif /* ARM64_BOARD_CONFIG_VINCE */
