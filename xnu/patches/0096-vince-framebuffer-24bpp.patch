+/*
+ * 32-bpp shadow (B, G, R, X) to the 24-bpp panel (B, G, R): four pixels into three words, the whole frame
+ * (about 9 MB read, 7 MB written; a few ms, at sweetfb_hz).
+ */
+void
+AppleCLCD::flushPanel(void)
+{
+	for (uint32_t y = 0; y < fHeight; y++) {
+		const uint32_t *s = (const uint32_t *)(fPixels + (uint64_t)y * fRowBytes);
+		volatile uint32_t *d = (volatile uint32_t *)(fPanel + (uint64_t)y * fPanelRowBytes);
+		uint32_t x = 0;
+		for (; x + 4 <= fWidth; x += 4, s += 4, d += 3) {
+			uint32_t p0 = s[0] & 0xffffff, p1 = s[1] & 0xffffff, p2 = s[2] & 0xffffff, p3 = s[3] & 0xffffff;
+			d[0] = p0 | p1 << 24;
+			d[1] = p1 >> 8 | p2 << 16;
+			d[2] = p2 >> 16 | p3 << 8;
+		}
+		volatile uint8_t *db = (volatile uint8_t *)d;
+		for (; x < fWidth; x++, s++) {
+			*db++ = (uint8_t)*s;
+			*db++ = (uint8_t)(*s >> 8);
+			*db++ = (uint8_t)(*s >> 16);
+		}
+	}
 }
+#endif
 
