+	}
+
 	vif_grp = lck_grp_alloc_init("vince_wlan", LCK_GRP_ATTR_NULL);
 	vif_lock = lck_mtx_alloc_init(vif_grp, LCK_ATTR_NULL);
 	bzero(&e, sizeof(e));
diff --git a/iokit/Kernel/arm/VinceWiFi.cpp b/iokit/Kernel/arm/VinceWiFi.cpp
new file mode 100644
index 0000000..a773325
--- /dev/null
+++ b/iokit/Kernel/arm/VinceWiFi.cpp
@@ -0,0 +1,247 @@
+/*
+ * VINCE Wi-Fi in the IORegistry, X7 of reports/OVERNIGHT_PLAN.md.
+ *
+ * iOS userland finds a Wi-Fi radio through IOKit, not through the BSD interface list: wifid waits for a service of
+ * class IO80211SkywalkInterface whose IO80211InterfaceRole is "Infrastructure" and reads its IOInterfaceName
+ * ("en0"); configd's interface list comes from IONetworkInterface objects whose controller is an IO80211Controller.
+ * The kernel has no IONetworkingFamily / IO80211Family (those are kexts), so the few classes that userland looks at
+ * are defined here. They carry no data path: the packets go through the BSD ifnet (bsd/dev/vince_wlan_if.c), the
+ * Apple80211 requests arrive as socket ioctls on that ifnet.
+ *
+ * Property reads on these objects are logged ("VINCE IO: ...") so that what userland asks for can be seen.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(ARM64_BOARD_CONFIG_VINCE)
+#include <device/device_types.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSCollectionIterator.h>
+#include <sys/proc.h>
+
+static unsigned vince_io_logged;
+
+static void
+vince_io_log_key(const char *cls, const char *op, const char *key)
+{
+	char name[32];
+
+	if (vince_io_logged >= 400) {
+		return;
+	}
+	vince_io_logged++;
+	proc_selfname(name, sizeof(name));
+	IOLog("VINCE IO: %s %s \"%s\" by %s\n", cls, op, key ? key : "?", name);
+}
+
+/* ---- the controller side: IONetworkController -> IOEthernetController -> IO80211Controller -> VinceWLANController ---- */
+
+class IONetworkController : public IOService {
+	OSDeclareDefaultStructors(IONetworkController);
+};
+OSDefineMetaClassAndStructors(IONetworkController, IOService);
+
+class IOEthernetController : public IONetworkController {
+	OSDeclareDefaultStructors(IOEthernetController);
+};
+OSDefineMetaClassAndStructors(IOEthernetController, IONetworkController);
+
+class IO80211Controller : public IOEthernetController {
+	OSDeclareDefaultStructors(IO80211Controller);
+public:
+	using IOEthernetController::copyProperty;
+	OSPtr<OSObject> copyProperty(const OSSymbol *aKey) const APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(IO80211Controller, IOEthernetController);
+
+OSPtr<OSObject>
+IO80211Controller::copyProperty(const OSSymbol *aKey) const
+{
+	OSPtr<OSObject> o = IOEthernetController::copyProperty(aKey);
+
+	vince_io_log_key("controller", o ? "get" : "get (absent)", aKey ? aKey->getCStringNoCopy() : NULL);
+	return o;
+}
+
+class VinceWLANController : public IO80211Controller {
+	OSDeclareDefaultStructors(VinceWLANController);
+};
+OSDefineMetaClassAndStructors(VinceWLANController, IO80211Controller);
+
+/* ---- the interface side: IONetworkInterface -> IOEthernetInterface -> IO80211Interface -> IO80211SkywalkInterface ---- */
+
+class IONetworkInterface : public IOService {
+	OSDeclareDefaultStructors(IONetworkInterface);
+};
+OSDefineMetaClassAndStructors(IONetworkInterface, IOService);
+
+class IOEthernetInterface : public IONetworkInterface {
+	OSDeclareDefaultStructors(IOEthernetInterface);
+};
+OSDefineMetaClassAndStructors(IOEthernetInterface, IONetworkInterface);
+
+class IO80211Interface : public IOEthernetInterface {
+	OSDeclareDefaultStructors(IO80211Interface);
+};
+OSDefineMetaClassAndStructors(IO80211Interface, IOEthernetInterface);
+
+class IO80211SkywalkInterface : public IO80211Interface {
+	OSDeclareDefaultStructors(IO80211SkywalkInterface);
+public:
+	using IO80211Interface::copyProperty;
+	OSPtr<OSObject> copyProperty(const OSSymbol *aKey) const APPLE_KEXT_OVERRIDE;
+	OSPtr<OSObject> copyProperty(const char *aKey) const APPLE_KEXT_OVERRIDE;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(IO80211SkywalkInterface, IO80211Interface);
+
+OSPtr<OSObject>
+IO80211SkywalkInterface::copyProperty(const OSSymbol *aKey) const
+{
+	OSPtr<OSObject> o = IO80211Interface::copyProperty(aKey);
+
+	vince_io_log_key("interface", o ? "get" : "get (absent)", aKey ? aKey->getCStringNoCopy() : NULL);
+	return o;
+}
+
+OSPtr<OSObject>
+IO80211SkywalkInterface::copyProperty(const char *aKey) const
+{
+	OSPtr<OSObject> o = IO80211Interface::copyProperty(aKey);
+
+	vince_io_log_key("interface", o ? "get" : "get (absent)", aKey);
+	return o;
+}
+
+IOReturn
+IO80211SkywalkInterface::setProperties(OSObject *properties)
+{
+	OSDictionary *d = OSDynamicCast(OSDictionary, properties);
+
+	if (d) {
+		OSCollectionIterator *it = OSCollectionIterator::withCollection(d);
+		OSObject *k;
+
+		while (it && (k = it->getNextObject())) {
+			OSSymbol *s = OSDynamicCast(OSSymbol, k);
+			OSString *str = OSDynamicCast(OSString, k);
+
+			vince_io_log_key("interface", "set", s ? s->getCStringNoCopy() : (str ? str->getCStringNoCopy() : NULL));
+		}
+		OSSafeReleaseNULL(it);
+	}
+	return kIOReturnSuccess;
+}
+
+/* ---- the user client wifid has an entitlement for ---- */
+
+class IO80211APIUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(IO80211APIUserClient);
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(IO80211APIUserClient, IOUserClient);
+
+IOReturn
+IO80211APIUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IO80211APIUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target, __unused void *reference)
+{
+	char name[32];
+	static unsigned n;
+
+	if (n < 100) {
+		n++;
+		proc_selfname(name, sizeof(name));
+		IOLog("VINCE IO: IO80211APIUserClient selector %u by %s, in %u/%u out %u/%u\n", selector, name,
+		    args->scalarInputCount, args->structureInputSize, args->scalarOutputCount, args->structureOutputSize);
+	}
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = 0;
+	}
+	if (args->structureOutput != NULL) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+	return kIOReturnSuccess;
+}
+
+/* ---- publishing, called from the Wi-Fi driver thread once en0 exists ---- */
+
+static VinceWLANController *vince_ctl;
+static IO80211SkywalkInterface *vince_ifc;
+
+static void
+vince_wlan_props(const uint8_t mac[6])
+{
+	if (!vince_ifc) {
+		return;
+	}
+	vince_ifc->setProperty("IOMACAddress", (void *)mac, 6);
+	vince_ctl->setProperty("IOMACAddress", (void *)mac, 6);
+}
+
+extern "C" int
+vince_wlan_iokit_publish(const uint8_t mac[6], const char *bsd_name)
+{
+	if (vince_ifc) {
+		vince_wlan_props(mac);          /* the firmware restarted: new station address */
+		return 0;
+	}
+	vince_ctl = new VinceWLANController;
+	if (!vince_ctl || !vince_ctl->init()) {
+		OSSafeReleaseNULL(vince_ctl);
+		return -1;
+	}
+	vince_ifc = new IO80211SkywalkInterface;
+	if (!vince_ifc || !vince_ifc->init()) {
+		OSSafeReleaseNULL(vince_ifc);
+		OSSafeReleaseNULL(vince_ctl);
+		return -2;
+	}
+	/* controller */
+	vince_ctl->setProperty("IOClass", "VinceWLANController");
+	vince_ctl->setProperty(kIOUserClientClassKey, "IO80211APIUserClient");
+	vince_ctl->setProperty("IOModel", "Pronto WCN3660B");
+	vince_ctl->setProperty("IOVendor", "Qualcomm");
+	vince_ctl->setProperty("IOBuiltin", true);
+	vince_ctl->setProperty("IOMACAddress", (void *)mac, 6);
+	if (!vince_ctl->attach(IOService::getPlatform())) {
+		return -3;
+	}
+	vince_ctl->registerService();
+	/* interface */
+	vince_ifc->setProperty("IOInterfaceName", bsd_name);
+	vince_ifc->setProperty("BSD Name", bsd_name);
+	vince_ifc->setProperty("IOInterfaceNamePrefix", "en");
+	vince_ifc->setProperty("IOInterfaceUnit", 0ULL, 32);
+	vince_ifc->setProperty("IOInterfaceType", 6ULL, 8);             /* IFT_ETHER */
+	vince_ifc->setProperty("IOMediaAddressLength", 6ULL, 8);
+	vince_ifc->setProperty("IOMediaHeaderLength", 14ULL, 8);
+	vince_ifc->setProperty("IOMaxTransferUnit", 1500ULL, 32);
+	vince_ifc->setProperty("IOMinPacketSize", 60ULL, 32);
+	vince_ifc->setProperty("IOMaxPacketSize", 1518ULL, 32);
+	vince_ifc->setProperty("IOPrimaryInterface", true);
+	vince_ifc->setProperty("IOBuiltin", true);
+	vince_ifc->setProperty("IOLocation", "");
+	vince_ifc->setProperty("IO80211InterfaceRole", "Infrastructure");
+	vince_ifc->setProperty(kIOUserClientClassKey, "IO80211APIUserClient");
+	vince_ifc->setProperty("IOMACAddress", (void *)mac, 6);
+	if (!vince_ifc->attach(vince_ctl)) {
+		return -4;
+	}
+	vince_ifc->registerService();
+	IOLog("VINCE IO: IO80211SkywalkInterface %s registered\n", bsd_name);
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_VINCE */
