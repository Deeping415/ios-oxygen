+/* ---- Apple80211: wifid and configd talk to the radio with socket ioctls on the interface ---- */
+
+#define SIOCSA80211_A   0x802869c8u     /* _IOW('i', 200, struct apple80211req) */
+#define SIOCGA80211_A   0xc02869c9u     /* _IOWR('i', 201, ...) */
+#define SIOCSA80211_B   0x803069c8u     /* the same with the 0x30 byte request of newer systems */
+#define SIOCGA80211_B   0xc03069c9u
+
+struct a80211_req {
+	char ifname[16];
+	uint32_t type;
+	uint32_t val;
+	uint32_t len;
+	uint32_t pad;
+	uint64_t data;
+};
+
+#define A80211_SSID             1
+#define A80211_CHANNEL          4
+#define A80211_TXPOWER          7
+#define A80211_RATE             8
+#define A80211_BSSID            9
+#define A80211_SCAN_REQ         10
+#define A80211_SCAN_RESULT      11
+#define A80211_CARD_CAPS        12
+#define A80211_STATE            13
+#define A80211_PHY_MODE         14
+#define A80211_OP_MODE          15
+#define A80211_RSSI             16
+#define A80211_NOISE            17
+#define A80211_POWER            19
+#define A80211_ASSOCIATE        20
+#define A80211_DISASSOCIATE     22
+#define A80211_LOCALE           28
+#define A80211_DRIVER_VERSION   43
+#define A80211_HARDWARE_VERSION 44
+#define A80211_COUNTRY_CODE     51
+
+static uint32_t a80211_power = 1;               /* APPLE80211_POWER_ON */
+static uint8_t a80211_seen[2][512 / 8];
+
+static void
+a80211_put32(uint8_t *b, unsigned off, uint32_t v)
+{
+	b[off] = (uint8_t)v;
+	b[off + 1] = (uint8_t)(v >> 8);
+	b[off + 2] = (uint8_t)(v >> 16);
+	b[off + 3] = (uint8_t)(v >> 24);
+}
+
+/*
+ * One request. kb holds the data (for a SET what userland sent, for a GET zeroes to fill); returns an errno. Structure
+ * layouts are the macOS ones (OpenIntelWireless/itlwm apple80211_var.h); iOS 16 may differ, hence the logging.
+ */
+static int
+a80211_handle(uint32_t type, bool get, uint8_t *kb, uint32_t len)
+{
+	switch (type) {
+	case A80211_POWER:
+		if (get) {
+			if (len >= 12) {
+				a80211_put32(kb, 0, 1);                 /* version */
+				a80211_put32(kb, 4, 1);                 /* radios */
+				a80211_put32(kb, 8, a80211_power);      /* power_state[0] */
+			}
+		} else if (len >= 12) {
+			a80211_power = kb[8] | (uint32_t)kb[9] << 8;
+		}
+		return 0;
+	case A80211_STATE:
+		if (get && len >= 8) {
+			a80211_put32(kb, 0, 1);
+			a80211_put32(kb, 4, 0);                         /* APPLE80211_S_INIT */
+		}
+		return 0;
+	case A80211_OP_MODE:
+		if (get && len >= 8) {
+			a80211_put32(kb, 0, 1);
+			a80211_put32(kb, 4, 1);                         /* APPLE80211_M_STA */
+		}
+		return 0;
+	case A80211_PHY_MODE:
+		if (get && len >= 12) {
+			a80211_put32(kb, 0, 1);
+			a80211_put32(kb, 4, 0x4 | 0x8 | 0x10);          /* 11b, 11g, 11n */
+			a80211_put32(kb, 8, 0);
+		}
+		return 0;
+	case A80211_CARD_CAPS:
+		if (get && len >= 16) {
+			a80211_put32(kb, 0, 1);
+			kb[4] = 0x0f;                                   /* wep, tkip, aes, aes-ccm */
+			kb[5] = 0xe0;                                   /* ibss.. (bits 5..7) */
+			kb[6] = 0x7f;
+		}
+		return 0;
+	case A80211_LOCALE:
+		if (get && len >= 8) {
+			a80211_put32(kb, 0, 1);
+			a80211_put32(kb, 4, 2);                         /* ETSI */
+		}
+		return 0;
+	case A80211_COUNTRY_CODE:
+		if (get && len >= 8) {
+			a80211_put32(kb, 0, 1);
+			kb[4] = 'T';
+			kb[5] = 'R';
+		}
+		return 0;
+	case A80211_DRIVER_VERSION:
+	case A80211_HARDWARE_VERSION:
+		if (get && len >= 8) {
+			a80211_put32(kb, 0, 1);
+			strlcpy((char *)kb + 4, "vince-wcn36xx 1.0", len - 4);
+		}
+		return 0;
+	case A80211_SCAN_REQ:
+	case A80211_DISASSOCIATE:
+		return 0;
+	case A80211_SSID:
+	case A80211_BSSID:
+	case A80211_CHANNEL:
+	case A80211_RSSI:
+	case A80211_NOISE:
+	case A80211_RATE:
+	case A80211_TXPOWER:
+		return get ? ENXIO : 0;                                 /* not associated */
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+static errno_t
+a80211_ioctl(ifnet_t ifp, u_long cmd, void *data)
+{
+	struct a80211_req *rq = data;
+	bool get = cmd == SIOCGA80211_A || cmd == SIOCGA80211_B;
+	uint8_t kb[1536];
+	uint32_t len = rq->len;
+	user_addr_t ua = (user_addr_t)rq->data;
+	int err = 0;
+
+#pragma unused(ifp)
+	if (len > sizeof(kb)) {
+		len = sizeof(kb);
+	}
+	bzero(kb, sizeof(kb));
+	if (len && ua && !get) {
+		err = copyin(ua, kb, len);
+	} else if (len && ua && get) {
+		(void)copyin(ua, kb, len);      /* some requests carry parameters in a GET */
+	}
+	if (!err) {
+		err = a80211_handle(rq->type, get, kb, len);
+	}
+	if (rq->type < 512) {
+		uint8_t *seen = &a80211_seen[get ? 1 : 0][rq->type / 8];
+		uint8_t bit = (uint8_t)(1u << (rq->type % 8));
+
+		if (!(*seen & bit)) {
+			char nm[32];
+
+			*seen |= bit;
+			proc_selfname(nm, sizeof(nm));
+			printf("VINCE A80211: %s type %u val %u len %u by %s -> %d (cmd %#lx)\n", get ? "get" : "set", rq->type,
+			    rq->val, rq->len, nm, err, cmd);
+		}
+	}
+	if (get && !err && len && ua) {
+		err = copyout(kb, ua, len);
+	}
+	return err;
+}
+
 static void
 vif_start(ifnet_t ifp)
 {
@@ -107,7 +282,20 @@ vif_ioctl(ifnet_t ifp, u_long cmd, void *data)
 	case SIOCADDMULTI:
 	case SIOCDELMULTI:
 		return 0;
+	case SIOCSA80211_A:
+	case SIOCGA80211_A:
+	case SIOCSA80211_B:
+	case SIOCGA80211_B:
+		return a80211_ioctl(ifp, cmd, data);
 	default:
+		if (cmd != SIOCGIFMEDIA) {
+			static unsigned unk;
+
+			if (unk < 60) {
+				unk++;
+				printf("VINCE A80211: unknown ioctl %#lx\n", cmd);
+			}
+		}
 		return EOPNOTSUPP;
 	}
 }
