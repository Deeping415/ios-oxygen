diff --git a/bsd/dev/vince_rootfix.c b/bsd/dev/vince_rootfix.c
index 514871c..3a1013f 100755
--- a/bsd/dev/vince_rootfix.c
+++ b/bsd/dev/vince_rootfix.c
@@ -1,9 +1,9 @@
 /*
  * VINCE root file system fix-ups, applied by the kernel right after the iOS root is mounted and before launchd runs
- * (boot-arg vincefix=bluetool): the userland stand-ins built by .github/workflows/userland.yml are written to the
- * root and the launchd job files that must start them are replaced. The originals stay untouched on the image (the
- * stand-ins live in /usr/libexec), only the job file of com.apple.BlueTool is rewritten; the original job file is on the IPSW root
- * (see the mount of the IPSW root).
+ * (boot-arg vincefix=bluetool): the userland stand-ins built by .github/workflows/userland.yml are written to the root
+ * and launchd's job cache (/System/Library/xpc/launchd.plist, loaded unverified because of launchd_unsecure_cache=1)
+ * is edited in place so that the com.apple.BlueTool job runs the stand-in: "/usr/sbin/BlueTool" is replaced by
+ * "/usr/sbin/vince-bt", a path of the same length so that no offset in the binary property list moves.
  */
 #if defined(ARM64_BOARD_CONFIG_VINCE)
 #include <sys/param.h>
@@ -71,17 +71,72 @@ vf_write(const char *path, const void *data, size_t len, int mode)
 	return err;
 }
 
+/*
+ * Replace every occurrence of the binary-plist string object (marker, length, text) 'from' by the same-length 'to'
+ * inside the file; returns the number of replacements or -errno. Only the text bytes are written back.
+ */
+static int
+vf_patch_string(const char *path, const uint8_t *prefix, size_t plen, const char *from, const char *to)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	off_t sz = 0;
+	uint8_t *buf;
+	size_t flen = strlen(from), pat = plen + flen;
+	int err, n = 0, resid = 0;
+
+	if (strlen(to) != flen) {
+		return -EINVAL;
+	}
+	err = vnode_open(path, FREAD | FWRITE, 0, 0, &vp, ctx);
+	if (err) {
+		return -err;
+	}
+	if (vnode_size(vp, &sz, ctx) != 0 || sz <= 0 || sz > 16 * 1024 * 1024) {
+		(void)vnode_close(vp, FREAD | FWRITE, ctx);
+		return -EFBIG;
+	}
+	buf = kalloc_data((size_t)sz, Z_WAITOK);
+	if (!buf) {
+		(void)vnode_close(vp, FREAD | FWRITE, ctx);
+		return -ENOMEM;
+	}
+	err = vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)sz, 0, UIO_SYSSPACE, IO_NODELOCKED, vfs_context_ucred(ctx), &resid,
+	    vfs_context_proc(ctx));
+	if (err == 0 && resid == 0) {
+		for (size_t i = 0; i + pat <= (size_t)sz; i++) {
+			if (bcmp(buf + i, prefix, plen) == 0 && bcmp(buf + i + plen, from, flen) == 0) {
+				err = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)to, (int)flen, (off_t)(i + plen), UIO_SYSSPACE,
+				    IO_NODELOCKED | IO_SYNC, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+				if (err) {
+					break;
+				}
+				n++;
+			}
+		}
+	} else if (err == 0) {
+		err = EIO;
+	}
+	kfree_data(buf, (size_t)sz);
+	(void)vnode_close(vp, FREAD | FWRITE, ctx);
+	return err ? -err : n;
+}
+
 void
 vince_rootfix(void)
 {
 	char arg[32] = "";
-	int e1, e2;
+	/* binary plist ASCII string of 18 characters: 0x5f, int8 marker 0x10, length 18 */
+	static const uint8_t prefix[] = { 0x5f, 0x10, 0x12 };
+	int e1, e2, e3;
 
 	if (!PE_parse_boot_argn("vincefix", arg, sizeof(arg)) || strcmp(arg, "bluetool") != 0) {
 		return;
 	}
-	e1 = vf_write("/usr/libexec/vince-bluetool", vince_bluetool_bin, vince_bluetool_bin_len, 0755);
-	e2 = vf_write("/System/Library/LaunchDaemons/com.apple.BlueTool.plist", vince_bluetool_plist, vince_bluetool_plist_len, 0644);
-	printf("VINCE ROOTFIX: BlueTool stand-in %d, job file %d\n", e1, e2);
+	e1 = vf_write("/usr/sbin/vince-bt", vince_bluetool_bin, vince_bluetool_bin_len, 0755);
+	e2 = vf_write("/System/Library/LaunchDaemons/com.apple.BlueTool.plist", vince_bluetool_plist_orig,
+	    vince_bluetool_plist_orig_len, 0644);
+	e3 = vf_patch_string("/System/Library/xpc/launchd.plist", prefix, sizeof(prefix), "/usr/sbin/BlueTool", "/usr/sbin/vince-bt");
+	printf("VINCE ROOTFIX: BlueTool stand-in %d, job file restored %d, launchd cache: %d replaced\n", e1, e2, e3);
 }
 #endif /* ARM64_BOARD_CONFIG_VINCE */
