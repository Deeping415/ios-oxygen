 	if (!native && !crop) {
 		/* SweetFramebuffer.cpp shows 1125x2436 scaled into 1000x2160 at column 40: undo exactly that */
 		int outW = ((1125 * SWEET_TOUCH_PANEL_H + 2436 / 2) / 2436 + 4) & ~7;
