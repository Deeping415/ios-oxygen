diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 4ff1cd1..bf90e43 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -218,7 +218,10 @@ AppleCLCD::start(IOService *provider)
 	if (fPanelBpp == 3 && !crop && (fLogicalW != fWidth || fLogicalH != fHeight)) {
 		/* Fit the height, keep the aspect; the width rounded to a multiple of 8 so the bars are whole words. */
 		uint32_t outW = ((fLogicalW * fHeight + fLogicalH / 2) / fLogicalH + 4) & ~7u;
-		if (outW > fWidth) {
+		int fill = 0;
+		PE_parse_boot_argn("vincefb_fill", &fill, sizeof(fill));
+		if (outW > fWidth || fill) {
+			/* vincefb_fill=1: the whole panel width, no bars (the picture about 8% wider than tall) */
 			outW = fWidth & ~7u;
 		}
 		fXMap = (uint16_t *)IOMalloc(outW * sizeof(uint16_t));
