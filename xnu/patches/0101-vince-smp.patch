@@ -4290,6 +4290,25 @@ pmap_remove_options(
 
 	__unused const pt_attr_t * const pt_attr = pmap_get_pt_attr(pmap);
 
+#if defined(ARM64_BOARD_CONFIG_VINCE)
+	/*
+	 * Seen once as a MACH_ASSERT panic at WebContent launch: a remove of 0x1fdf1945000.. on a pmap whose user VA
+	 * ends at 2^39 (4K kernel). Nothing can be mapped above pmap->max, so clamp the range (a release kernel would
+	 * index the wrong translation table entries instead) and log where it came from.
+	 */
+	if (pmap != kernel_pmap && end > pmap->max) {
+		static int vince_logged;
+		if (vince_logged++ < 8) {
+			printf("VINCE PMAP: remove [%#llx, %#llx) above max %#llx, callers %p %p\n", (uint64_t)start,
+			    (uint64_t)end, (uint64_t)pmap->max, __builtin_return_address(0), __builtin_return_address(1));
+		}
+		if (start >= pmap->max) {
+			return;
+		}
+		end = pmap->max;
+	}
+#endif
+
 	PMAP_TRACE(2, PMAP_CODE(PMAP__REMOVE) | DBG_FUNC_START,
 	    VM_KERNEL_ADDRHIDE(pmap), VM_KERNEL_ADDRHIDE(start),
 	    VM_KERNEL_ADDRHIDE(end));
