diff --git a/bsd/dev/vince_bt.c b/bsd/dev/vince_bt.c
index a7c82f3..47a48ab 100755
--- a/bsd/dev/vince_bt.c
+++ b/bsd/dev/vince_bt.c
@@ -404,7 +404,8 @@ static char vince_trace_name[MAXCOMLEN + 1];
 static int vince_trace_budget = 8000;
 
 void
-vince_sc_trace(const char *comm, int code, uint64_t *arg, int error, int ret, int exit_entry)
+vince_sc_trace(const char *comm, int code, uint64_t *arg, int error, int ret, int exit_entry, uint64_t pc,
+    uint64_t lr, uint64_t fp)
 {
 	char path[96];
 	size_t len = 0;
@@ -429,7 +430,17 @@ vince_sc_trace(const char *comm, int code, uint64_t *arg, int error, int ret, in
 		break;
 	}
 	if (exit_entry) {
-		printf("VINCE TRC: %s exit(%d)\n", comm, (int)arg[0]);
+		uint64_t fr[2];
+		const uint64_t mask = 0x7fffffffffULL;
+
+		printf("VINCE TRC: %s exit(%d) pc %llx lr %llx\n", comm, (int)arg[0], pc & mask, lr & mask);
+		for (int i = 0; i < 12 && fp != 0; i++) {
+			if (copyin((user_addr_t)(fp & mask), fr, sizeof(fr)) != 0) {
+				break;
+			}
+			printf("VINCE TRC:   frame %d ret %llx\n", i, fr[1] & mask);
+			fp = fr[0];
+		}
 	} else {
 		printf("VINCE TRC: %s sc %d a0 %llx%s%s%s err %d ret %d\n", comm, code, arg[0],
 		    haspath ? " \"" : "", haspath ? path : "", haspath ? "\"" : "", error, ret);
