diff --git a/bsd/dev/arm/systemcalls.c b/bsd/dev/arm/systemcalls.c
index e6758e6..3ab6c55 100644
--- a/bsd/dev/arm/systemcalls.c
+++ b/bsd/dev/arm/systemcalls.c
@@ -46,7 +46,8 @@ unix_syscall(struct arm_saved_state * regs, thread_t thread_act, struct proc * p
 
 #if defined(ARM64_BOARD_CONFIG_VINCE)
 extern int vince_trace_on;
-extern void vince_sc_trace(const char *comm, int code, uint64_t *arg, int error, int ret, int exit_entry);
+extern void vince_sc_trace(const char *comm, int code, uint64_t *arg, int error, int ret, int exit_entry, uint64_t pc,
+    uint64_t lr, uint64_t fp);
 #endif
 
 static int      arm_get_syscall_args(uthread_t, struct arm_saved_state *, const struct sysent *);
@@ -184,7 +185,8 @@ unix_syscall(
 
 #if defined(ARM64_BOARD_CONFIG_VINCE)
