diff --git a/bsd/skywalk/core/skywalk.c b/bsd/skywalk/core/skywalk.c
index bdf6a98..45fe950 100644
--- a/bsd/skywalk/core/skywalk.c
+++ b/bsd/skywalk/core/skywalk.c
@@ -202,7 +202,16 @@ SYSCTL_UINT(_kern_skywalk, OID_AUTO, debug, CTLFLAG_RW | CTLFLAG_LOCKED,
     &sk_debug, 0, "Skywalk debug mode");
 SYSCTL_LONG(_kern_skywalk, OID_AUTO, sk_copy_thres, CTLFLAG_RW | CTLFLAG_LOCKED,
     &sk_copy_thres, "Skywalk copy threshold");
+#if defined(ARM64_BOARD_CONFIG_VINCE)
+/*
+ * VINCE: the stand-in AMFI does not turn com.apple.private.skywalk.* entitlements into privileges, so every
+ * nexus registration failed with EPERM (bluetoothd's A2DP audio channel then crashed it on a NULL channel).
+ * Missing privileges are still logged, but allowed (sysctl kern.skywalk.priv_check=1 restores the check).
+ */
+static int __priv_check = 0;
+#else
 static int __priv_check = 1;
+#endif
 SYSCTL_INT(_kern_skywalk, OID_AUTO, priv_check, CTLFLAG_RW | CTLFLAG_LOCKED,
     &__priv_check, 0, "Skywalk privilege check");
 SYSCTL_UINT(_kern_skywalk, OID_AUTO, sk_opp_defunct, CTLFLAG_RW | CTLFLAG_LOCKED,
