 #
 # Support for LLVM Profile Guided Optimization (PGO)
diff --git a/osfmk/arm64/pe_fiq.c b/osfmk/arm64/pe_fiq.c
index a8e2cd4..42e205c 100644
--- a/osfmk/arm64/pe_fiq.c
+++ b/osfmk/arm64/pe_fiq.c
@@ -37,6 +37,13 @@
 #include <pexpert/device_tree.h>
 #include <arm64/proc_reg.h>
 
+#if defined(VINCE)
+/* Vince (MSM8953 / Snapdragon 625) GICv2 MMIO base addresses & vtimer INTID */
+vm_offset_t vince_gicd_base = MSM8953_GICD_BASE;
+vm_offset_t vince_gicc_base = MSM8953_GICC_BASE;
+uint32_t    vince_vtimer_intid = VINCE_VTIMER_INTID;
+#endif
+
 #if HAS_GIC_V3
 
 static vm_offset_t gicd_base;
@@ -48,6 +55,27 @@ static uint64_t vtimer_intid;
 
 void
 pe_init_fiq(void)
+{
+#if defined(VINCE)
+	/*
+	 * Xiaomi Redmi 5 Plus (MSM8953) uses ARM GICv2 (HAS_GIC_V3 == 0).
+	 * Map GIC Distributor (0x0b000000) and CPU Interface (0x0b002000).
+	 */
+	vince_gicd_base = ml_io_map(MSM8953_GICD_BASE, MSM8953_GICD_SIZE);
+	vince_gicc_base = ml_io_map(MSM8953_GICC_BASE, MSM8953_GICC_SIZE);
+	vince_vtimer_intid = VINCE_VTIMER_INTID;
+
+	/* Enable GIC Distributor */
+	*(volatile uint32_t *)(vince_gicd_base + 0x000) = 1;
+	/* Enable GIC CPU Interface and set Priority Mask */
+	*(volatile uint32_t *)(vince_gicc_base + 0x004) = 0xff;
+	*(volatile uint32_t *)(vince_gicc_base + 0x000) = 1;
+
+	/* Enable Virtual Timer PPI */
+	uint32_t reg_idx = vince_vtimer_intid / 32;
+	uint32_t bit_idx = vince_vtimer_intid % 32;
+	*(volatile uint32_t *)(vince_gicd_base + 0x100 + (reg_idx * 4)) = (1U << bit_idx);
+#endif
 }
 
 #else /* !HAS_GIC_V3 */
