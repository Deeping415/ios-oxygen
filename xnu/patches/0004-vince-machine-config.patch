diff --git a/pexpert/pexpert/arm64/VINCE.h b/pexpert/pexpert/arm64/VINCE.h
new file mode 100644
index 0000000..a044ad0
--- /dev/null
+++ b/pexpert/pexpert/arm64/VINCE.h
@@ -0,0 +1,50 @@
+/*
+ * Board config for Xiaomi Redmi 5 Plus ("vince", Qualcomm MSM8953 / Snapdragon 625)
+ * 8x ARM Cortex-A53 ARMv8.0-A, GICv2 MMIO, 24-bit RGB888 display.
+ */
+
+#ifndef _PEXPERT_ARM64_VINCE_H
+#define _PEXPERT_ARM64_VINCE_H
+
+#define NO_MONITOR                1
+#define NO_ECORE                  1
+
+#define VINCE                     1
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_ENABLE_SWAP__       1
+#define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+#define __ARM64_PMAP_SUBPAGE_L1__ 1
+
+#define HAS_GIC_V2                1
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif /* ! ASSEMBLER */
+
+#define VINCE_VTIMER_INTID        20      // Virtual timer PPI (DT index 4: 16 + 4 = 20)
+#define VINCE_IPI_SGI             1       // SGI used for cross-CPU signals
+
+#define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
+
+#define MSM8953_GICD_BASE         0x0b000000ULL
+#define MSM8953_GICC_BASE         0x0b002000ULL
+
+#endif /* ! _PEXPERT_ARM64_VINCE_H */
