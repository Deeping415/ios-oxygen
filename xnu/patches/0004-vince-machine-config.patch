 	MOV64   x1, SCTLR_EL1_DEFAULT
 	cmp		x0, x1
 	bne		.
-#endif /* !VMAPPLE */
+#endif /* !VMAPPLE && !SWEET && !VINCE */
 
 #if (!CONFIG_KERNEL_INTEGRITY || (CONFIG_KERNEL_INTEGRITY && !defined(KERNEL_INTEGRITY_WT)))
 	/* Watchtower
diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -141,11 +141,63 @@
 		}
 	}
 
+#if defined(VINCE)
+	/*
+	 * vince (MSM8953): ARM GICv2 MMIO controller.
+	 */
+	extern vm_offset_t vince_gicd_base;
+	extern vm_offset_t vince_gicc_base;
+	extern uint32_t vince_vtimer_intid;
+
+	DTEntry entry;
+	if (SecureDTFindEntry("name", "interrupt-controller", &entry) == kSuccess) {
+		uint64_t const *reg;
+		unsigned int prop_size;
+		if (SecureDTGetProperty(entry, "reg", (void const **)&reg, &prop_size) == kSuccess && prop_size >= 32) {
+			vince_gicd_base = ml_io_map(reg[0], reg[1]);
+			vince_gicc_base = ml_io_map(reg[2], reg[3]);
+		}
+		void const *timer_prop;
+		if (SecureDTGetProperty(entry, "virtual-timer-intid", &timer_prop, &prop_size) == kSuccess && prop_size == sizeof(uint32_t)) {
+			vince_vtimer_intid = *(const uint32_t *)timer_prop;
+		}
+	}
+	if (!vince_gicd_base) {
+		vince_gicd_base = ml_io_map(MSM8953_GICD_BASE, 0x1000);
+	}
+	if (!vince_gicc_base) {
+		vince_gicc_base = ml_io_map(MSM8953_GICC_BASE, 0x1000);
+	}
+
+	/* Enable virtual timer PPI (20) and SGI 1 */
+	*(volatile uint32_t *)(vince_gicd_base + 0x100) = (1U << vince_vtimer_intid) | (1U << VINCE_IPI_SGI);
+	/* Priority mask: allow all priority levels */
+	*(volatile uint32_t *)(vince_gicc_base + 0x004) = 0xf0;
+	/* Enable CPU interface (bit 0) */
+	*(volatile uint32_t *)(vince_gicc_base + 0x000) = 1;
+	/* Enable Distributor (bit 0) */
+	*(volatile uint32_t *)(vince_gicd_base + 0x000) = 1;
+	__builtin_arm_isb(ISB_SY);
+	return;
+#elif defined(SWEET)
+	/*
+	 * Real hardware with two security states: Group 0 is TrustZone's and
+	 * non-secure writes to it are ignored. Everything we own is Group 1 NS
+	 * and arrives as an IRQ (see sleh_irq). GICR_IGROUPR0 reads as zero
+	 * from the non-secure side even after this write; delivery still works.
+	 */
+	gicr_write32(GICR_IGROUPR0, 0xFFFFFFFF);
+	for (unsigned int i = 0; i < 32; i += 4) {
+		gicr_write32(GICR_IPRIORITYR0 + i, 0xA0A0A0A0);
+	}
+	gicr_write32(GICR_ISENABLER0, (1U << SWEET_VTIMER_INTID) | (1U << SWEET_IPI_SGI));
+#else
 	// Configure timers and legacy FIQ to be group 0
 	gicr_write32(GICR_IGROUPR0, 0x81FFFFFF);
 
 	// Enable PPI 27
 	gicr_write32(GICR_ISENABLER0, (1 << 27));
+#endif /* SWEET */
 
 	// Enable system register access
 	uint64_t icc_sre = __builtin_arm_rsr64("ICC_SRE_EL1");
@@ -154,7 +206,12 @@
 	__builtin_arm_isb(ISB_SY);
 
 	// Set priority masks and binary point for group 0
+#if defined(SWEET)
+	__builtin_arm_wsr64("ICC_BPR1_EL1", 0);
+#else
+	// Set priority masks and binary point for group 0
 	__builtin_arm_wsr64("ICC_BPR0_EL1", 0);
+#endif /* SWEET */
 	__builtin_arm_wsr64("ICC_PMR_EL1", 0xFF);
 
 	// Set EOI mode of this processor
@@ -162,12 +219,25 @@
 	icc_ctlr &= ~ICC_CTLR_EOIMODE;
 	__builtin_arm_wsr64("ICC_CTLR_EL1", icc_ctlr);
 
+	// Enable the forwarding of the vtimer interrupt
+#if defined(SWEET)
+	// ABL leaves only ARE_NS set; Linux writes ARE_NS | EnableGrp1A | EnableGrp1
+	uint32_t gicd_ctlr = gicd_read32(GICD_CTLR);
+	gicd_ctlr |= GICD_CTLR_ARE_NS | GICD_CTLR_ENABLEGRP1A | GICD_CTLR_ENABLEGRP1;
+	gicd_write32(GICD_CTLR, gicd_ctlr);
+	while (gicd_read32(GICD_CTLR) & GICD_CTLR_RWP) {
+		;
+	}
+	__builtin_arm_wsr64("ICC_IGRPEN1_EL1", 1);
+	__builtin_arm_isb(ISB_SY);
+#else
 	// Enable the forwarding of the vtimer interrupt
 	uint32_t gicd_ctlr = gicd_read32(GICD_CTLR);
 	gicd_ctlr |= GICD_CTLR_ENABLEGRP0;
 	gicd_write32(GICD_CTLR, gicd_ctlr);
 	__builtin_arm_wsr64("ICC_IGRPEN0_EL1", 1);
 	__builtin_arm_isb(ISB_SY);
+#endif /* SWEET */
 }
 #else
 void
