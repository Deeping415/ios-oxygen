diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index ccbb188..777aca4 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -463,6 +463,40 @@ LEXT(start_first_cpu)
 	mov		x20, x0
 	mov		x21, #0
 
+#if defined(VINCE)
+	/* Stage 0: white 64x32 band on Vince 1080x2160 24bpp screen (0x90001000) */
+	MOV64	x0, (0x90001000 + 2128 * 3240)
+	mov		w1, #0xff
+	mov		x2, #32
+	mov		x4, #3240
+Lvince_mark_row:
+	mov		x3, #(64 * 3)
+	mov		x5, x0
+Lvince_mark_pixel:
+	strb	w1, [x5], #1
+	subs	x3, x3, #1
+	b.ne	Lvince_mark_pixel
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Lvince_mark_row
+	dsb		sy
+#elif defined(SWEET)
+	/* Stage 0: white 64x32 band, no stack or page tables needed. */
+	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	mov		w1, #-1
+	mov		x2, #32
+	mov		x4, #4320
+Lsweet_mark_row:
+	mov		x3, #64
+	mov		x5, x0
+Lsweet_mark_pixel:
+	str		w1, [x5], #4
+	subs	x3, x3, #1
+	b.ne	Lsweet_mark_pixel
+	add		x0, x0, x4
+	subs	x2, x2, #1
+	b.ne	Lsweet_mark_row
+	dsb		sy
+#endif
+
 	// Set low reset vector before attempting any loads
 	adrp	x0, EXT(LowExceptionVectorBase)@page
 	add		x0, x0, EXT(LowExceptionVectorBase)@pageoff
@@ -609,6 +643,30 @@ Lkernelcache_base_found:
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
 
+#if defined(VINCE)
+	/*
+	 * Splash framebuffer: 16MB (8x 2MB blocks) at 0x90000000 in V=P L2 table.
+	 */
+	MOV64	x10, 0x90000000
+	and		x12, x10, #(ARM_TT_L1_INDEX_MASK)
+	lsr		x12, x12, #(ARM_TT_L1_SHIFT)
+	ldr		x13, [x25, x12, lsl #TTE_SHIFT]
+	and		x13, x13, #(ARM_TTE_TABLE_MASK)
+	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
+	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
+	add		x13, x13, x12, lsl #TTE_SHIFT
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr		x11, x11, x10
+	mov		x12, #8
+	MOV64	x10, (1 << ARM_TT_L2_SHIFT)
+Lvince_map_fb_loop:
+	str		x11, [x13], #8
+	add		x11, x11, x10
+	subs	x12, x12, #1
+	b.ne	Lvince_map_fb_loop
+#elif defined(SWEET)
+	/*
+	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P
+	 * L2 table.
+	 */
+	MOV64	x10, 0x9c000000
+	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
+	orr		x11, x11, x10
+	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
+	lsr		x12, x12, #(ARM_TT_L2_SHIFT)
+	add		x13, x25, #(2 * PGBYTES)
+	str		x11, [x13, x12, lsl #TTE_SHIFT]
+#endif
+
 	/* Ensure TTEs are visible */
 	dsb		ish
 
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
new file mode 100644
index 0000000..8f4c808
--- /dev/null
+++ b/osfmk/arm64/sweet_early.c
@@ -0,0 +1,155 @@
+/*
+ * Bootstrap console for Qualcomm platforms (vince / sweet).
+ */
+#include <arm64/sweet_early.h>
+
+#if defined(VINCE) || defined(SWEET)
+#include <stdint.h>
+#include <kern/misc_protos.h>
+
+#if defined(VINCE)
+#define EARLY_FB_PHYS 0x90001000ULL
+#define EARLY_WIDTH 1080u
+#define EARLY_HEIGHT 2160u
+#define EARLY_STRIDE 3240u
+#define EARLY_BPP 3u
+#else
+#define EARLY_FB_PHYS 0x9c000000ULL
+#define EARLY_WIDTH 1080u
+#define EARLY_HEIGHT 2400u
+#define EARLY_STRIDE (4320u / 4)
+#define EARLY_BPP 4u
+#endif
+
+static volatile uint8_t *early_fb = (volatile uint8_t *)(uintptr_t)EARLY_FB_PHYS;
+
+#define EARLY_SCALE 2u
+#define EARLY_CELL_W (8u * EARLY_SCALE)
+#define EARLY_CELL_H (16u * EARLY_SCALE)
+#define EARLY_ROWS ((EARLY_HEIGHT - 32u) / EARLY_CELL_H)
+#define EARLY_COLS (EARLY_WIDTH / EARLY_CELL_W)
+
+extern unsigned char iso_font[256 * 16];
+
+static unsigned int early_row, early_col;
+static unsigned int early_started, early_disabled, early_panicking;
+
+static void
+early_clear_row(void)
+{
+	for (unsigned int y = 0; y < EARLY_CELL_H; y++) {
+#if defined(VINCE)
+		volatile uint8_t *line = early_fb + (early_row * EARLY_CELL_H + y) * EARLY_STRIDE;
+		for (unsigned int x = 0; x < EARLY_WIDTH * 3; x++) {
+			line[x] = 0;
+		}
+#else
+		volatile uint32_t *line = (volatile uint32_t *)early_fb + (early_row * EARLY_CELL_H + y) * EARLY_STRIDE;
+		for (unsigned int x = 0; x < EARLY_WIDTH; x++) {
+			line[x] = 0xff000000u;
+		}
+#endif
+	}
+}
+
+void
+sweet_early_putc(char c)
+{
+	if (early_disabled) {
+		return;
+	}
+	if (!early_started) {
+		early_started = 1;
+		early_clear_row();
+	}
+	if (c == '\r') {
+		early_col = 0;
+		return;
+	}
+	if (c == '\n' || early_col == EARLY_COLS) {
+		early_col = 0;
+		early_row = (early_row + 1) % EARLY_ROWS;
+		early_clear_row();
+		if (c == '\n') {
+			return;
+		}
+	}
+	const unsigned char *glyph = iso_font + (unsigned char)c * 16;
+	for (unsigned int gy = 0; gy < 16; gy++) {
+		for (unsigned int sy = 0; sy < EARLY_SCALE; sy++) {
+#if defined(VINCE)
+			volatile uint8_t *line = early_fb +
+			    (early_row * EARLY_CELL_H + gy * EARLY_SCALE + sy) * EARLY_STRIDE +
+			    early_col * EARLY_CELL_W * 3;
+			for (unsigned int gx = 0; gx < 8; gx++) {
+				uint8_t pixel = (glyph[gy] & (1u << gx)) ? 0xff : 0x00;
+				for (unsigned int sx = 0; sx < EARLY_SCALE; sx++) {
+					uint32_t px = (gx * EARLY_SCALE + sx) * 3;
+					line[px + 0] = pixel;
+					line[px + 1] = pixel;
+					line[px + 2] = pixel;
+				}
+			}
+#else
+			volatile uint32_t *line = (volatile uint32_t *)early_fb +
+			    (early_row * EARLY_CELL_H + gy * EARLY_SCALE + sy) * EARLY_STRIDE +
+			    early_col * EARLY_CELL_W;
+			for (unsigned int gx = 0; gx < 8; gx++) {
+				uint32_t pixel = (glyph[gy] & (1u << gx)) ? 0xffffffffu : 0xff000000u;
+				for (unsigned int sx = 0; sx < EARLY_SCALE; sx++) {
+					line[gx * EARLY_SCALE + sx] = pixel;
+				}
+			}
+#endif
+		}
+	}
+	early_col++;
+}
+
+static void
+sweet_early_string(const char *s)
+{
+	while (*s) {
+		sweet_early_putc(*s++);
+	}
+}
+
+void
+sweet_early_mark(unsigned int stage, const char *label)
+{
+	if (early_disabled || stage > 20) {
+		return;
+	}
+#if defined(VINCE)
+	for (unsigned int y = EARLY_HEIGHT - 32; y < EARLY_HEIGHT; y++) {
+		volatile uint8_t *line = early_fb + y * EARLY_STRIDE;
+		for (unsigned int x = stage * 48; x < (stage + 1) * 48; x++) {
+			line[x * 3 + 0] = 0x00;
+			line[x * 3 + 1] = 0xff;
+			line[x * 3 + 2] = (stage & 7u) * 32u;
+		}
+	}
+#else
+	uint32_t color = 0xff00ff00u | (stage * 28u << 16);
+	for (unsigned int y = EARLY_HEIGHT - 32; y < EARLY_HEIGHT; y++) {
+		for (unsigned int x = stage * 64; x < (stage + 1) * 64; x++) {
+			((volatile uint32_t *)early_fb)[y * EARLY_STRIDE + x] = color;
+		}
+	}
+#endif
+	__asm__ volatile("dsb sy" ::: "memory");
+	sweet_early_string("VINCE EARLY ");
+	if (stage >= 10) {
+		sweet_early_putc((char)('0' + stage / 10));
+	}
+	sweet_early_putc((char)('0' + stage % 10));
+	sweet_early_string(": ");
+	sweet_early_string(label);
+	sweet_early_putc('\n');
+}
+
+void
+sweet_early_panic(const char *fmt, va_list *args)
+{
+	if (early_disabled || early_panicking) {
+		return;
+	}
+	early_panicking = 1;
+	sweet_early_string("\nEARLY PANIC: ");
+	va_list copy;
+	va_copy(copy, *args);
+	_doprnt(fmt, &copy, sweet_early_putc, 16);
+	va_end(copy);
+	sweet_early_putc('\n');
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+sweet_early_disable(void)
+{
+	sweet_early_mark(8, "leaving bootstrap TTBR0");
+	early_disabled = 1;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+#endif /* VINCE || SWEET */
diff --git a/osfmk/arm64/sweet_early.h b/osfmk/arm64/sweet_early.h
new file mode 100644
index 0000000..fbbc827
--- /dev/null
+++ b/osfmk/arm64/sweet_early.h
@@ -0,0 +1,22 @@
+/* Early screen diagnostics, valid only while the bootstrap TTBR0 is live. */
+#ifndef _ARM64_SWEET_EARLY_H_
+#define _ARM64_SWEET_EARLY_H_
+
+#include <pexpert/arm64/board_config.h>
+#include <stdarg.h>
+
+#if defined(SWEET) || defined(VINCE)
+void sweet_early_mark(unsigned int stage, const char *label);
+void sweet_early_putc(char c);
+void sweet_early_panic(const char *fmt, va_list *args);
+void sweet_early_disable(void);
+#else
+static inline void sweet_early_mark(unsigned int stage, const char *label)
+{
+	(void)stage;
+	(void)label;
+}
+static inline void sweet_early_disable(void) {}
+#endif
+
+#endif
